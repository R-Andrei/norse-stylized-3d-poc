#pragma kernel ClearRange
#pragma kernel BakeStaticPressure
#pragma kernel FinalizeStaticPressure
#pragma kernel BakeStaticWakeSource
#pragma kernel InjectRipple
#pragma kernel InjectWake
#pragma kernel SimulateRipple
#pragma kernel SimulateWake

#define PS3D_TWO_PI 6.28318530718
#define PS3D_MAX_STATIC_CONTOUR 16
#define PS3D_MAX_PRESSURE_PROFILE_SAMPLES 64

Texture2D<float4> _StateRead;
RWTexture2D<float4> _StateWrite;

Texture2D<float4> _WakeRead;
RWTexture2D<float4> _WakeWrite;
Texture2D<float4> _StaticWakeSourceRead;
RWTexture2D<float4> _StaticPressureWrite;
RWTexture2D<float4> _StaticWakeSourceWrite;

int2 _FieldSize;
int _DispatchXOffset;
int _DispatchWidth;

int4 _StaticRect;
float2 _StaticCentre;
float2 _StaticHalfSizePixels;
float2 _StaticCellSize;
int _StaticContourCount;
float4 _StaticContour[PS3D_MAX_STATIC_CONTOUR];
float4 _StaticPressureProfile[PS3D_MAX_PRESSURE_PROFILE_SAMPLES];
float4 _StaticPressureGeometry[PS3D_MAX_PRESSURE_PROFILE_SAMPLES];
int _StaticPressureProfileCount;
float _StaticPressureProfileHalfWidthPixels;
int _StaticPressureProfileValid;
int _StaticPressureGeometryValid;
float _StaticTargetHeight;
float _StaticPressureDepthPixels;
float _StaticPressureInsideOverlapPixels;
float _StaticMaximumHeight;
float _StaticWakeSourceStrength;
float _StaticWakePersistence;
float _StaticWakeSpread;
float _StaticPhase;
float _StaticContactSharpness;
float _StaticWaveResponse;
float _MaximumHeight;

int4 _RippleInjectRect;
float2 _RippleInjectCentre;
float2 _RippleInjectRadiusPixels;
float _RippleInjectHeight;
float _RippleInjectVelocity;
float _RippleInjectNormalDetail;

int4 _WakeInjectRect;
float2 _WakeInjectStart;
float2 _WakeInjectEnd;
float2 _WakeInjectFootprintPixels;
float _WakeInjectStrength;
float _WakeInjectMovementBlend;
float _WakeInjectPersistence;
float _WakeInjectDeltaTime;

float _DeltaTime;
float _PropagationSpeed;
float _DampingPerSecond;
float _AdvectionPixels;
float _CellSizeX;
float _CellSizeY;

int2 _WakeFieldSize;
int _WakeDispatchXOffset;
int _WakeDispatchWidth;
float _WakeDeltaTime;
float _WakeAdvectionPixels;
float _WakeCellSizeX;
float _WakeCellSizeY;
float _WakeLateralSpread;
float _WakeDecayPerSecond;
float _WakeSourceRate;
float _WakeFlowFactor;
float _WakeTime;
float _WakeGradientStrength;

struct BoundaryInfo
{
    float signedDistance;
    float2 outwardNormal;
};

float Gaussian1D(float value, float centre, float width)
{
    float normalized = (value - centre) / max(width, 0.0001);
    return exp(-normalized * normalized);
}

float Gaussian2D(float2 value, float2 centre, float2 width)
{
    float2 normalized =
        (value - centre) / max(width, float2(0.0001, 0.0001));
    return exp(-dot(normalized, normalized));
}

float2 SafeNormalize(float2 value, float2 fallback)
{
    float magnitudeSquared = dot(value, value);
    return magnitudeSquared > 0.000001
        ? value * rsqrt(magnitudeSquared)
        : fallback;
}

float Cross2D(float2 first, float2 second)
{
    return first.x * second.y - first.y * second.x;
}

float RoundedBoxDistance(float2 position, float2 halfSize, float radius)
{
    float2 innerHalf = max(halfSize - radius, float2(0.0, 0.0));
    float2 q = abs(position) - innerHalf;
    return length(max(q, float2(0.0, 0.0))) +
           min(max(q.x, q.y), 0.0) - radius;
}

float2 RoundedBoxGradient(float2 position, float2 halfSize, float radius)
{
    float epsilon = 0.75;
    float dx = RoundedBoxDistance(
        position + float2(epsilon, 0.0), halfSize, radius) -
        RoundedBoxDistance(
            position - float2(epsilon, 0.0), halfSize, radius);
    float dy = RoundedBoxDistance(
        position + float2(0.0, epsilon), halfSize, radius) -
        RoundedBoxDistance(
            position - float2(0.0, epsilon), halfSize, radius);
    return SafeNormalize(float2(dx, dy), float2(-1.0, 0.0));
}

BoundaryInfo EvaluateStaticBoundary(float2 position, float2 halfSize)
{
    BoundaryInfo result;

    if (_StaticContourCount < 3)
    {
        float radius = max(1.0, min(halfSize.x, halfSize.y) * 0.48);
        result.signedDistance = RoundedBoxDistance(position, halfSize, radius);
        result.outwardNormal = RoundedBoxGradient(position, halfSize, radius);
        return result;
    }

    float minimumDistance = 1000000.0;
    float2 nearestNormal = float2(-1.0, 0.0);
    bool inside = true;

    [loop]
    for (int index = 0; index < PS3D_MAX_STATIC_CONTOUR; index++)
    {
        if (index >= _StaticContourCount)
        {
            break;
        }

        int nextIndex = index + 1;
        if (nextIndex >= _StaticContourCount)
        {
            nextIndex = 0;
        }

        float2 start = _StaticContour[index].xy;
        float2 end = _StaticContour[nextIndex].xy;
        float2 edge = end - start;
        float edgeLengthSquared = max(0.000001, dot(edge, edge));
        float interpolation = saturate(
            dot(position - start, edge) / edgeLengthSquared);
        float2 nearest = start + edge * interpolation;
        float distanceValue = length(position - nearest);
        float2 outward = SafeNormalize(
            float2(edge.y, -edge.x),
            float2(-1.0, 0.0));

        if (distanceValue < minimumDistance)
        {
            minimumDistance = distanceValue;
            nearestNormal = outward;
        }

        if (Cross2D(edge, position - start) < 0.0)
        {
            inside = false;
        }
    }

    result.signedDistance = inside ? -minimumDistance : minimumDistance;
    result.outwardNormal = nearestNormal;
    return result;
}

struct ContourRowResult
{
    float upstreamX;
    float downstreamX;
    float valid;
};

ContourRowResult ResolveContourRow(float lateralPosition)
{
    ContourRowResult result;
    result.upstreamX = 1000000.0;
    result.downstreamX = -1000000.0;
    result.valid = 0.0;
    int intersectionCount = 0;

    if (_StaticContourCount < 3)
    {
        return result;
    }

    [loop]
    for (int index = 0; index < PS3D_MAX_STATIC_CONTOUR; index++)
    {
        if (index >= _StaticContourCount)
        {
            break;
        }

        int nextIndex = index + 1;
        if (nextIndex >= _StaticContourCount)
        {
            nextIndex = 0;
        }

        float2 start = _StaticContour[index].xy;
        float2 end = _StaticContour[nextIndex].xy;
        float deltaY = end.y - start.y;

        if (abs(deltaY) <= 0.00001)
        {
            continue;
        }

        float minimumY = min(start.y, end.y);
        float maximumY = max(start.y, end.y);

        if (lateralPosition < minimumY ||
            lateralPosition > maximumY)
        {
            continue;
        }

        float interpolation =
            (lateralPosition - start.y) / deltaY;

        if (interpolation < -0.0001 ||
            interpolation > 1.0001)
        {
            continue;
        }

        float intersectionX = lerp(
            start.x,
            end.x,
            saturate(interpolation));
        result.upstreamX = min(result.upstreamX, intersectionX);
        result.downstreamX = max(result.downstreamX, intersectionX);
        intersectionCount++;
    }

    result.valid =
        intersectionCount >= 2 &&
        result.downstreamX > result.upstreamX + 0.05
            ? 1.0
            : 0.0;
    return result;
}

float EvaluateLegacyStaticPressureShape(float2 relativePosition, float2 halfSize)
{
    float resultShape = 0.0;
    ContourRowResult contourRow = (ContourRowResult)0;
    contourRow = ResolveContourRow(relativePosition.y);

    float upstreamX = contourRow.upstreamX;
    float downstreamX = contourRow.downstreamX;
    float rowIsUsable = 1.0;

    if (contourRow.valid < 0.5)
    {
        float normalizedFallbackLateral =
            relativePosition.y / max(1.0, halfSize.y);
        rowIsUsable = step(abs(normalizedFallbackLateral), 1.0);

        float rowHalfLength =
            halfSize.x * sqrt(saturate(
                1.0 -
                normalizedFallbackLateral * normalizedFallbackLateral));
        upstreamX = -rowHalfLength;
        downstreamX = rowHalfLength;
    }
    else
    {
        // Smooth only toward the object interior. This removes single-row
        // staircase jumps without ever moving the visible contact edge ahead
        // of the real waterline and opening a gap.
        float weightedUpstream = upstreamX * 4.0;
        float totalWeight = 4.0;
        const float rowOffset = 0.75;

        [unroll]
        for (int offsetIndex = -2; offsetIndex <= 2; offsetIndex++)
        {
            if (offsetIndex != 0)
            {
                ContourRowResult sampleRow = (ContourRowResult)0;
                sampleRow = ResolveContourRow(
                    relativePosition.y + offsetIndex * rowOffset);

                if (sampleRow.valid >= 0.5)
                {
                    float weight =
                        offsetIndex == -1 || offsetIndex == 1
                            ? 2.0
                            : 1.0;
                    weightedUpstream += sampleRow.upstreamX * weight;
                    totalWeight += weight;
                }
            }
        }

        float smoothedUpstream = weightedUpstream / totalWeight;
        upstreamX = max(upstreamX, smoothedUpstream);
    }

    if (rowIsUsable >= 0.5)
    {
        float rowSpan = max(0.0, downstreamX - upstreamX);
        float rowSupport = smoothstep(0.20, 0.85, rowSpan);
        float normalizedLateral =
            abs(relativePosition.y) / max(1.0, halfSize.y);
        float endTaper =
            1.0 - smoothstep(0.82, 1.02, normalizedLateral);

        // Positive distance is open water upstream of the contact boundary.
        // Negative distance is inside the object footprint.
        const float crestInsetPixels = 0.75;
        const float crestShoulderPixels = 0.05;
        float contactDistance =
            upstreamX + crestInsetPixels - relativePosition.x;
        float pressureDepth = max(0.75, _StaticPressureDepthPixels);
        float insideOverlap = max(
            1.5,
            _StaticPressureInsideOverlapPixels);

        // The crest anchor sits inside the obstruction. Only a sub-cell
        // shoulder remains exposed, while the hidden object-facing overlap
        // prevents filtering and mesh interpolation from revealing a gap.
        float insideGate = smoothstep(
            -insideOverlap - 0.45,
            -insideOverlap + 0.10,
            contactDistance);
        float openWaterDistance = max(
            0.0,
            contactDistance - crestShoulderPixels);
        float openWater01 = saturate(
            1.0 - openWaterDistance / pressureDepth);
        float openWaterFalloff = pow(
            openWater01,
            max(0.5, _StaticContactSharpness));

        resultShape =
            insideGate * openWaterFalloff * rowSupport * endTaper;
    }

    return resultShape;
}

float4 SamplePressureProfile(
    float lateralPosition,
    out float downstreamBoundaryX)
{
    float4 invalidSample = float4(0.0, 0.0, 0.0, 0.0);
    downstreamBoundaryX = 0.0;

    if (_StaticPressureProfileValid == 0)
    {
        return invalidSample;
    }

    float supportHalfWidth = max(
        1.0,
        _StaticPressureProfileHalfWidthPixels);
    if (abs(lateralPosition) > supportHalfWidth)
    {
        return invalidSample;
    }

    int profileSampleCount = clamp(
        _StaticPressureProfileCount,
        2,
        PS3D_MAX_PRESSURE_PROFILE_SAMPLES);
    float rowCoordinate = saturate(
        lateralPosition / (supportHalfWidth * 2.0) + 0.5) *
        (profileSampleCount - 1);
    int row0 = clamp(
        (int)floor(rowCoordinate),
        0,
        profileSampleCount - 1);
    int row1 = min(
        row0 + 1,
        profileSampleCount - 1);
    float interpolation = saturate(rowCoordinate - row0);
    float4 sample0 = _StaticPressureProfile[row0];
    float4 sample1 = _StaticPressureProfile[row1];
    float weight0 = (1.0 - interpolation) * step(0.0001, sample0.w);
    float weight1 = interpolation * step(0.0001, sample1.w);
    float totalWeight = weight0 + weight1;

    if (totalWeight <= 0.0001)
    {
        return invalidSample;
    }

    float4 sample =
        (sample0 * weight0 + sample1 * weight1) / totalWeight;
    if (_StaticPressureGeometryValid != 0)
    {
        downstreamBoundaryX =
            (_StaticPressureGeometry[row0].x * weight0 +
             _StaticPressureGeometry[row1].x * weight1) /
            totalWeight;
    }

    sample.z = max(0.0, sample.z);
    sample.w = max(sample.z, sample.w);
    return sample.z > 0.0001 ? sample : invalidSample;
}

float EvaluateHeightAwareStaticPressure(
    float2 relativePosition,
    float2 halfSize)
{
    float resultHeight = 0.0;

    if (_StaticPressureProfileValid == 0)
    {
        float legacyShape = EvaluateLegacyStaticPressureShape(
            relativePosition,
            halfSize);
        resultHeight = _StaticTargetHeight * legacyShape;
    }
    else
    {
        float4 profileSample = float4(0.0, 0.0, 0.0, 0.0);
        float downstreamBoundaryX = 0.0;
        profileSample = SamplePressureProfile(
            relativePosition.y,
            downstreamBoundaryX);

        if (profileSample.z > 0.0001)
        {
            float baseUpstreamX = profileSample.x;
            float contactSlope = profileSample.y;
            float cachedHeight = profileSample.z;
            float modulationCeiling = profileSample.w;
            float crestInsetPixels = 0.50;
            float crestShoulderPixels = 0.05;
            float pressureDepthScale = 1.0;
            float minimumInsideOverlapPixels = 1.5;

            if (_StaticPressureProfileCount >= 64)
            {
                crestInsetPixels = 0.75;
                crestShoulderPixels = 0.15;
                pressureDepthScale = 0.55;
                minimumInsideOverlapPixels = 3.5;
            }
            else if (_StaticPressureProfileCount >= 32)
            {
                crestInsetPixels = 0.65;
                crestShoulderPixels = 0.10;
                pressureDepthScale = 0.65;
                minimumInsideOverlapPixels = 2.5;
            }

            float pressureDepth = max(
                0.75,
                _StaticPressureDepthPixels * pressureDepthScale);
            float insideOverlap = max(
                minimumInsideOverlapPixels,
                _StaticPressureInsideOverlapPixels);
            float height = min(_StaticTargetHeight, cachedHeight);
            bool hasGeometryBounds =
                _StaticPressureGeometryValid != 0 &&
                downstreamBoundaryX > baseUpstreamX + 0.001;
            float protectedDownstreamStartX = lerp(
                baseUpstreamX,
                downstreamBoundaryX,
                0.50);

            // Two fixed correction steps approximate the height-aware contact
            // line. The CPU has already reduced the mesh slices to a base
            // boundary, a shift per metre, and local safe height ceilings.
            [unroll]
            for (int iteration = 0; iteration < 2; iteration++)
            {
                float requestedContactX =
                    baseUpstreamX + contactSlope * height + crestInsetPixels;
                float contactX = hasGeometryBounds
                    ? min(requestedContactX, protectedDownstreamStartX)
                    : requestedContactX;
                float contactDistance = contactX - relativePosition.x;
                float insideGate;

                if (hasGeometryBounds)
                {
                    float requestedPressureEndX =
                        contactX + insideOverlap + 0.45;
                    float pressureEndX = min(
                        requestedPressureEndX,
                        protectedDownstreamStartX);

                    if (pressureEndX <= contactX + 0.001)
                    {
                        insideGate =
                            1.0 - step(
                                pressureEndX + 0.0001,
                                relativePosition.x);
                    }
                    else
                    {
                        float requestedFadeStartX =
                            contactX + insideOverlap - 0.10;
                        float fadeStartX = clamp(
                            requestedFadeStartX,
                            contactX,
                            pressureEndX - 0.001);
                        insideGate = 1.0 - smoothstep(
                            fadeStartX,
                            pressureEndX,
                            relativePosition.x);
                    }
                }
                else
                {
                    insideGate = smoothstep(
                        -insideOverlap - 0.45,
                        -insideOverlap + 0.10,
                        contactDistance);
                }

                float openWaterDistance = max(
                    0.0,
                    contactDistance - crestShoulderPixels);
                float openWater01 = saturate(
                    1.0 - openWaterDistance / pressureDepth);
                float openWaterFalloff = pow(
                    openWater01,
                    max(0.5, _StaticContactSharpness));
                height = min(
                    cachedHeight,
                    cachedHeight * insideGate * openWaterFalloff);
            }

            resultHeight = clamp(
                height,
                0.0,
                min(cachedHeight, modulationCeiling));
        }
    }

    return resultHeight;
}

float EvaluateStaticWakeSource(float2 relativePosition, float2 halfSize)
{
    BoundaryInfo boundary = EvaluateStaticBoundary(relativePosition, halfSize);
    float spread = clamp(_StaticWakeSpread, 0.5, 2.0);
    float minimumHalf = min(halfSize.x, halfSize.y);
    float bandWidth = max(0.70, minimumHalf * 0.10) *
                      lerp(0.80, 1.35, saturate((spread - 0.5) / 1.5));
    float outsideMask = step(0.0, boundary.signedDistance);
    float downstreamFacing = saturate(boundary.outwardNormal.x * 1.60);
    float side01 = abs(relativePosition.y) /
                   max(1.0, halfSize.y * spread);
    float sideOutlet = smoothstep(0.30, 0.78, side01);
    float outletBand = Gaussian1D(
        boundary.signedDistance,
        bandWidth * 0.62,
        bandWidth * 0.46);
    float downstreamGate = smoothstep(
        halfSize.x * 0.45,
        halfSize.x * 1.05,
        relativePosition.x);
    return outletBand * downstreamFacing * sideOutlet *
           outsideMask * downstreamGate;
}

float4 LoadState(int2 pixel)
{
    pixel = clamp(pixel, int2(0, 0), _FieldSize - 1);
    return _StateRead.Load(int3(pixel, 0));
}

float4 SampleStateLinearX(float x, int y)
{
    float floorX = floor(x);
    int x0 = clamp((int)floorX, 0, _FieldSize.x - 1);
    int x1 = clamp(x0 + 1, 0, _FieldSize.x - 1);
    float interpolation = saturate(x - floorX);
    float4 sampleA = LoadState(int2(x0, y));
    float4 sampleB = LoadState(int2(x1, y));
    return lerp(sampleA, sampleB, interpolation);
}

float4 LoadWake(int2 pixel)
{
    pixel = clamp(pixel, int2(0, 0), _WakeFieldSize - 1);
    return _WakeRead.Load(int3(pixel, 0));
}

float4 SampleWakeLinearX(float x, int y)
{
    float floorX = floor(x);
    int x0 = clamp((int)floorX, 0, _WakeFieldSize.x - 1);
    int x1 = clamp(x0 + 1, 0, _WakeFieldSize.x - 1);
    float interpolation = saturate(x - floorX);
    float4 sampleA = LoadWake(int2(x0, y));
    float4 sampleB = LoadWake(int2(x1, y));
    return lerp(sampleA, sampleB, interpolation);
}

[numthreads(8, 8, 1)]
void ClearRange(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_DispatchWidth ||
        dispatchId.y >= (uint)_FieldSize.y)
    {
        return;
    }

    int2 pixel = int2(
        (int)dispatchId.x + _DispatchXOffset,
        (int)dispatchId.y);

    if (pixel.x < 0 || pixel.x >= _FieldSize.x)
    {
        return;
    }

    _StateWrite[pixel] = 0.0;
}

[numthreads(8, 8, 1)]
void BakeStaticPressure(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_StaticRect.z ||
        dispatchId.y >= (uint)_StaticRect.w)
    {
        return;
    }

    int2 pixel = int2(
        _StaticRect.x + (int)dispatchId.x,
        _StaticRect.y + (int)dispatchId.y);

    if (pixel.x < 0 || pixel.y < 0 ||
        pixel.x >= _FieldSize.x || pixel.y >= _FieldSize.y)
    {
        return;
    }

    float2 relativePosition = float2(pixel) + 0.5 - _StaticCentre;
    float2 halfSize = max(_StaticHalfSizePixels, float2(1.0, 1.0));
    float height = EvaluateHeightAwareStaticPressure(
        relativePosition,
        halfSize);

    if (height < 0.0001)
    {
        return;
    }

    float phaseCode = floor(frac(_StaticPhase) * 16.0);
    float waveResponseCode = round(
        saturate(_StaticWaveResponse * 0.5) * 31.0);
    float packedDynamics =
        phaseCode +
        waveResponseCode * 16.0;

    float4 existing = _StaticPressureWrite[pixel];
    float existingInfluence = abs(existing.r);
    float newInfluence = abs(height);
    existing.r = clamp(
        existing.r + height,
        0.0,
        _StaticMaximumHeight);

    if (newInfluence >= existingInfluence)
    {
        existing.a = packedDynamics;
    }

    _StaticPressureWrite[pixel] = existing;
}

[numthreads(8, 8, 1)]
void FinalizeStaticPressure(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FieldSize.x ||
        dispatchId.y >= (uint)_FieldSize.y)
    {
        return;
    }

    int2 pixel = int2(dispatchId.xy);
    int2 leftPixel = int2(max(0, pixel.x - 1), pixel.y);
    int2 rightPixel = int2(min(_FieldSize.x - 1, pixel.x + 1), pixel.y);
    int2 downPixel = int2(pixel.x, max(0, pixel.y - 1));
    int2 upPixel = int2(pixel.x, min(_FieldSize.y - 1, pixel.y + 1));

    float4 centre = _StaticPressureWrite[pixel];
    float leftHeight = _StaticPressureWrite[leftPixel].r;
    float rightHeight = _StaticPressureWrite[rightPixel].r;
    float downHeight = _StaticPressureWrite[downPixel].r;
    float upHeight = _StaticPressureWrite[upPixel].r;

    centre.g = clamp(
        (rightHeight - leftHeight) /
        max(0.0001, _StaticCellSize.x * 2.0),
        -12.0,
        12.0);
    centre.b = clamp(
        (upHeight - downHeight) /
        max(0.0001, _StaticCellSize.y * 2.0),
        -12.0,
        12.0);
    _StaticPressureWrite[pixel] = centre;
}

[numthreads(8, 8, 1)]
void BakeStaticWakeSource(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_StaticRect.z ||
        dispatchId.y >= (uint)_StaticRect.w)
    {
        return;
    }

    int2 pixel = int2(
        _StaticRect.x + (int)dispatchId.x,
        _StaticRect.y + (int)dispatchId.y);

    if (pixel.x < 0 || pixel.y < 0 ||
        pixel.x >= _FieldSize.x || pixel.y >= _FieldSize.y)
    {
        return;
    }

    float2 relativePosition = float2(pixel) + 0.5 - _StaticCentre;
    float2 halfSize = max(_StaticHalfSizePixels, float2(1.0, 1.0));
    float source = EvaluateStaticWakeSource(relativePosition, halfSize) *
                   _StaticWakeSourceStrength;

    if (source < 0.0001)
    {
        return;
    }

    float4 existing = _StaticWakeSourceWrite[pixel];
    if (source >= existing.r)
    {
        existing.g = frac(_StaticPhase);
        existing.b = saturate((_StaticWakeSpread - 0.5) / 1.5);
        existing.a = saturate(_StaticWakePersistence / 3.0);
    }

    existing.r = clamp(existing.r + source, 0.0, 4.0);
    _StaticWakeSourceWrite[pixel] = existing;
}

[numthreads(8, 8, 1)]
void InjectRipple(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_RippleInjectRect.z ||
        dispatchId.y >= (uint)_RippleInjectRect.w)
    {
        return;
    }

    int2 pixel = int2(
        _RippleInjectRect.x + (int)dispatchId.x,
        _RippleInjectRect.y + (int)dispatchId.y);

    if (pixel.x < 0 || pixel.y < 0 ||
        pixel.x >= _FieldSize.x || pixel.y >= _FieldSize.y)
    {
        return;
    }

    float2 samplePosition = float2(pixel) + 0.5;
    float2 sourceRelative =
        (samplePosition - _RippleInjectCentre) /
        max(_RippleInjectRadiusPixels, float2(1.0, 1.0));
    float radialDistance = length(sourceRelative);
    float centreDepression = Gaussian1D(radialDistance, 0.0, 0.28);
    float pressureRing = Gaussian1D(radialDistance, 0.60, 0.17);
    float outerTrough = Gaussian1D(radialDistance, 0.91, 0.11);
    float radialEnvelope =
        1.0 - smoothstep(0.88, 1.12, radialDistance);

    float heightPattern =
        (0.92 * pressureRing -
         0.70 * centreDepression -
         0.16 * outerTrough) *
        radialEnvelope;
    float velocityPattern =
        (1.05 * pressureRing -
         1.35 * centreDepression -
         0.20 * outerTrough) *
        radialEnvelope;
    float2 radialDirection = SafeNormalize(
        sourceRelative,
        float2(1.0, 0.0));
    float2 normalPattern =
        radialDirection *
        (pressureRing * 1.25 - centreDepression * 0.55) *
        radialEnvelope;

    float4 state = _StateWrite[pixel];
    state.r += _RippleInjectHeight * heightPattern;
    state.g += _RippleInjectVelocity * velocityPattern;
    state.ba += _RippleInjectNormalDetail * normalPattern;
    state.r = clamp(state.r, -_MaximumHeight, _MaximumHeight);
    state.g = clamp(
        state.g,
        -_MaximumHeight * 12.0,
        _MaximumHeight * 12.0);
    state.ba = clamp(state.ba, -4.0, 4.0);
    _StateWrite[pixel] = state;
}

[numthreads(8, 8, 1)]
void InjectWake(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_WakeInjectRect.z ||
        dispatchId.y >= (uint)_WakeInjectRect.w)
    {
        return;
    }

    int2 pixel = int2(
        _WakeInjectRect.x + (int)dispatchId.x,
        _WakeInjectRect.y + (int)dispatchId.y);

    if (pixel.x < 0 || pixel.y < 0 ||
        pixel.x >= _WakeFieldSize.x || pixel.y >= _WakeFieldSize.y)
    {
        return;
    }

    float2 samplePosition = float2(pixel) + 0.5;
    float2 segment = _WakeInjectEnd - _WakeInjectStart;
    float segmentLength = length(segment);
    float2 segmentDirection = SafeNormalize(segment, float2(1.0, 0.0));
    float2 segmentSide = float2(-segmentDirection.y, segmentDirection.x);
    float2 footprint = max(
        _WakeInjectFootprintPixels,
        float2(1.0, 1.0));

    float along = dot(samplePosition - _WakeInjectStart, segmentDirection);
    float across = dot(samplePosition - _WakeInjectStart, segmentSide);
    float clampedAlong = clamp(along, 0.0, max(0.0001, segmentLength));
    float2 nearest = _WakeInjectStart + segmentDirection * clampedAlong;
    float pathDistance = length(samplePosition - nearest) /
                         max(1.0, footprint.y);
    float pathEnvelope = 1.0 - smoothstep(0.55, 1.10, pathDistance);
    float pathMask = segmentLength > 0.05
        ? smoothstep(-footprint.x * 0.15, footprint.x * 0.10, along) *
          (1.0 - smoothstep(
              max(0.0, segmentLength - footprint.x * 0.05),
              segmentLength + footprint.x * 0.25,
              along))
        : 0.0;

    float normalizedAcross = across / max(1.0, footprint.y);
    float movingWake =
        (Gaussian1D(abs(normalizedAcross), 0.55, 0.26) * 0.78 +
         Gaussian1D(normalizedAcross, 0.0, 0.48) * 0.22) *
        pathEnvelope * pathMask;

    float2 endRelative = samplePosition - _WakeInjectEnd;
    float stationaryAlong = endRelative.x / max(1.0, footprint.x);
    float stationaryAcross = endRelative.y / max(1.0, footprint.y);
    float leftOutlet = Gaussian2D(
        float2(stationaryAlong, stationaryAcross),
        float2(0.75, -0.62),
        float2(0.52, 0.28));
    float rightOutlet = Gaussian2D(
        float2(stationaryAlong, stationaryAcross),
        float2(0.75, 0.62),
        float2(0.52, 0.28));
    float stationaryWake = leftOutlet + rightOutlet;

    float movementBlend = saturate(_WakeInjectMovementBlend);
    float pattern = lerp(stationaryWake, movingWake, movementBlend);
    if (pattern < 0.0001)
    {
        return;
    }

    float4 state = _WakeWrite[pixel];
    state.r = clamp(
        state.r +
        _WakeInjectStrength * pattern * max(0.0001, _WakeInjectDeltaTime),
        0.0,
        4.0);
    state.g = max(state.g, saturate(_WakeInjectPersistence / 3.0));
    _WakeWrite[pixel] = state;
}

[numthreads(8, 8, 1)]
void SimulateRipple(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_DispatchWidth ||
        dispatchId.y >= (uint)_FieldSize.y)
    {
        return;
    }

    int x = (int)dispatchId.x + _DispatchXOffset;
    int y = (int)dispatchId.y;

    if (x < 0 || x >= _FieldSize.x)
    {
        return;
    }

    float sourceX = (float)x - _AdvectionPixels;
    float4 centre = SampleStateLinearX(sourceX, y);
    float left = SampleStateLinearX(sourceX - 1.0, y).r;
    float right = SampleStateLinearX(sourceX + 1.0, y).r;
    float down = SampleStateLinearX(sourceX, max(0, y - 1)).r;
    float up = SampleStateLinearX(
        sourceX,
        min(_FieldSize.y - 1, y + 1)).r;

    float inverseCellX2 =
        1.0 / max(0.0001, _CellSizeX * _CellSizeX);
    float inverseCellY2 =
        1.0 / max(0.0001, _CellSizeY * _CellSizeY);
    float laplacian =
        (left - 2.0 * centre.r + right) * inverseCellX2 +
        (down - 2.0 * centre.r + up) * inverseCellY2;

    float velocity =
        centre.g +
        laplacian *
        _PropagationSpeed *
        _PropagationSpeed *
        _DeltaTime;
    velocity *= exp(-_DampingPerSecond * _DeltaTime);
    float height = centre.r + velocity * _DeltaTime;

    float lateral01 = y / max(1.0, (float)(_FieldSize.y - 1));
    float edgeDistance = min(lateral01, 1.0 - lateral01);
    float edgeMask = smoothstep(0.0, 0.075, edgeDistance);
    height *= edgeMask;
    velocity *= edgeMask;

    if (height != height || velocity != velocity ||
        abs(height) > _MaximumHeight * 8.0 ||
        abs(velocity) > _MaximumHeight * 64.0)
    {
        height = 0.0;
        velocity = 0.0;
    }

    height = clamp(height, -_MaximumHeight, _MaximumHeight);
    velocity = clamp(
        velocity,
        -_MaximumHeight * 12.0,
        _MaximumHeight * 12.0);

    float gradientX =
        (right - left) /
        max(0.0001, 2.0 * _CellSizeX);
    float gradientY =
        (up - down) /
        max(0.0001, 2.0 * _CellSizeY);
    float2 normalOnlyDetail =
        centre.ba - float2(gradientX, gradientY);
    normalOnlyDetail *= exp(
        -(_DampingPerSecond * 1.35 + 0.90) * _DeltaTime);
    normalOnlyDetail *= edgeMask;

    float2 finalGradient = clamp(
        float2(gradientX, gradientY) * edgeMask + normalOnlyDetail,
        -4.0,
        4.0);

    _StateWrite[int2(x, y)] = float4(
        height,
        velocity,
        finalGradient.x,
        finalGradient.y);
}

[numthreads(8, 8, 1)]
void SimulateWake(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_WakeDispatchWidth ||
        dispatchId.y >= (uint)_WakeFieldSize.y)
    {
        return;
    }

    int x = (int)dispatchId.x + _WakeDispatchXOffset;
    int y = (int)dispatchId.y;

    if (x < 0 || x >= _WakeFieldSize.x)
    {
        return;
    }

    float sourceX = (float)x - _WakeAdvectionPixels;
    float4 centre = SampleWakeLinearX(sourceX, y);
    float4 left = SampleWakeLinearX(sourceX - 1.0, y);
    float4 right = SampleWakeLinearX(sourceX + 1.0, y);
    float4 down = SampleWakeLinearX(sourceX, max(0, y - 1));
    float4 up = SampleWakeLinearX(
        sourceX,
        min(_WakeFieldSize.y - 1, y + 1));

    float lateralBlend = saturate(
        _WakeLateralSpread * _WakeDeltaTime);
    float lateralAverage = (down.r + up.r) * 0.5;
    float energy = lerp(centre.r, lateralAverage, lateralBlend);
    float persistence = max(
        centre.g,
        max(down.g, up.g) * lateralBlend * 0.5);

    float4 source = _StaticWakeSourceRead.Load(int3(
        clamp(int2(x, y), int2(0, 0), _WakeFieldSize - 1),
        0));
    float sourcePhase = source.g * PS3D_TWO_PI;
    float pulse = saturate(
        0.84 +
        0.10 * sin(_WakeTime * 0.88 * PS3D_TWO_PI + sourcePhase) +
        0.04 * sin(
            _WakeTime * 1.47 * PS3D_TWO_PI +
            sourcePhase * 1.73));
    energy +=
        source.r *
        pulse *
        _WakeSourceRate *
        _WakeFlowFactor *
        _WakeDeltaTime;
    persistence = max(persistence, source.a);

    float persistenceScale = lerp(
        0.72,
        1.65,
        saturate(persistence));
    energy *= exp(
        -_WakeDecayPerSecond /
        max(0.25, persistenceScale) *
        _WakeDeltaTime);

    float lateral01 = y / max(1.0, (float)(_WakeFieldSize.y - 1));
    float edgeDistance = min(lateral01, 1.0 - lateral01);
    float edgeMask = smoothstep(0.0, 0.10, edgeDistance);
    energy *= edgeMask;

    if (energy != energy || abs(energy) > 64.0)
    {
        energy = 0.0;
        persistence = 0.0;
    }

    energy = clamp(energy, 0.0, 4.0);
    persistence = saturate(persistence);

    float gradientX =
        (right.r - left.r) /
        max(0.0001, 2.0 * _WakeCellSizeX);
    float gradientY =
        (up.r - down.r) /
        max(0.0001, 2.0 * _WakeCellSizeY);
    float sourceSpread = lerp(0.85, 1.20, saturate(source.b));
    float2 gradients = clamp(
        float2(gradientX, gradientY) *
        _WakeGradientStrength *
        sourceSpread *
        edgeMask,
        -4.0,
        4.0);

    _WakeWrite[int2(x, y)] = float4(
        energy,
        persistence,
        gradients.x,
        gradients.y);
}
