#pragma kernel InjectFoam
#pragma kernel WriteIsolatedLifeProbe
#pragma kernel ClearProgressiveBirthDebugAll
#pragma kernel ClearProgressiveBirthDebugTransient
#pragma kernel PaintProgressiveBirthDebugSegment
