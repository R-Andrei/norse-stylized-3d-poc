float4 ResolveFoamSegmentInjectionSample(
    float2 physicalPosition,
    float2 physicalCellSpacing,
    FoamMetricRow metric)
{
    float startAcrossMetres = _FoamInjectionUsesMetricLateral > 0.5
        ? _FoamInjectionSegmentStartLateralMetres
        : FoamAcross01ToMetres(
            saturate(
                _FoamInjectionSegmentStartAcrossNormalized * 0.5 + 0.5),
            metric.widthsAndSpacing.x,
            metric.widthsAndSpacing.y);
    float endAcrossMetres = _FoamInjectionUsesMetricLateral > 0.5
        ? _FoamInjectionSegmentEndLateralMetres
        : FoamAcross01ToMetres(
            saturate(
                _FoamInjectionSegmentEndAcrossNormalized * 0.5 + 0.5),
            metric.widthsAndSpacing.x,
            metric.widthsAndSpacing.y);
    float2 segmentStart = float2(
        _FoamInjectionSegmentStartGlobalDistance,
        startAcrossMetres);
    float2 segmentEnd = float2(
        _FoamInjectionSegmentEndGlobalDistance,
        endAcrossMetres);
    float2 segmentAxis = segmentEnd - segmentStart;
    float axisLengthSquared = max(dot(segmentAxis, segmentAxis), 0.000001);
    float segmentT = saturate(
        dot(physicalPosition - segmentStart, segmentAxis) /
        axisLengthSquared);
    float2 closestPoint = segmentStart + segmentAxis * segmentT;
    float segmentRadius = max(
        0.025,
        lerp(
            _FoamInjectionSegmentStartRadius,
            _FoamInjectionSegmentEndRadius,
            segmentT));
    float segmentDistanceMetres = distance(
        physicalPosition,
        closestPoint);
    float segmentEdgeWidthMetres = max(
        0.01,
        max(physicalCellSpacing.x, physicalCellSpacing.y) * 0.75);
    float segmentShape = 1.0 - smoothstep(
        segmentRadius - segmentEdgeWidthMetres,
        segmentRadius + segmentEdgeWidthMetres,
        segmentDistanceMetres);
    float sourceAmount = saturate(lerp(
        _FoamInjectionSegmentStartAmount,
        _FoamInjectionSegmentEndAmount,
        segmentT));

    return float4(segmentShape, sourceAmount, segmentRadius, segmentT);
}

float FoamDistanceToSegment(float2 queryPosition, float2 segmentStart, float2 segmentEnd, out float segmentT)
{
    float2 axis = segmentEnd - segmentStart;
    float axisLengthSquared = max(0.000001, dot(axis, axis));
    segmentT = saturate(dot(queryPosition - segmentStart, axis) / axisLengthSquared);
    return distance(queryPosition, segmentStart + axis * segmentT);
}

[numthreads(8, 8, 1)]
void ClearRange(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x ||
        y < 0 || y >= _FoamDimensions.y)
    {
        return;
    }

    _FoamStateWrite[int2(x, y)] = 0.0.xxxx;
}


float FoamEvaluateIntrinsicShapeMask(
    FoamMaterialState material,
    float validFluid)
{
    return saturate(material.presence * validFluid);
}


float FoamLoadFilmSource(int2 coordinate)
{
    int2 clamped = clamp(
        coordinate,
        int2(0, 0),
        max(int2(0, 0), _FoamFilmDimensions - int2(1, 1)));
    return saturate(_FoamFilmSourceRead.Load(int3(clamped, 0)));
}


void FoamResolveFilmBilinearCoordinates(
    float2 uv,
    out int2 baseCoordinate,
    out int2 nextCoordinate,
    out float2 blend)
{
    int2 safeDimensions = max(_FoamFilmDimensions, int2(1, 1));
    float2 coordinate = saturate(uv) * (float2)safeDimensions - 0.5;
    coordinate = clamp(
        coordinate,
        float2(0.0, 0.0),
        max(float2(0.0, 0.0), (float2)safeDimensions - 1.0));

    baseCoordinate = int2(floor(coordinate));
    nextCoordinate = min(
        baseCoordinate + int2(1, 1),
        safeDimensions - int2(1, 1));
    blend = frac(coordinate);
}


float FoamSampleFilmSourceBilinear(float2 uv)
{
    int2 baseCoordinate;
    int2 nextCoordinate;
    float2 blend;
    float2 filmUV = FoamFieldUVToFilmUV(uv);
    FoamResolveFilmBilinearCoordinates(
        filmUV,
        baseCoordinate,
        nextCoordinate,
        blend);

    float a = _FoamFilmSourceRead.Load(int3(baseCoordinate, 0));
    float b = _FoamFilmSourceRead.Load(
        int3(nextCoordinate.x, baseCoordinate.y, 0));
    float c = _FoamFilmSourceRead.Load(
        int3(baseCoordinate.x, nextCoordinate.y, 0));
    float d = _FoamFilmSourceRead.Load(int3(nextCoordinate, 0));
    return saturate(lerp(lerp(a, b, blend.x), lerp(c, d, blend.x), blend.y));
}


float FoamSampleFilmSupportBilinear(float2 uv)
{
    int2 baseCoordinate;
    int2 nextCoordinate;
    float2 blend;
    float2 filmUV = FoamFieldUVToFilmUV(uv);
    FoamResolveFilmBilinearCoordinates(
        filmUV,
        baseCoordinate,
        nextCoordinate,
        blend);

    float a = _FoamFilmSupportRead.Load(int3(baseCoordinate, 0));
    float b = _FoamFilmSupportRead.Load(
        int3(nextCoordinate.x, baseCoordinate.y, 0));
    float c = _FoamFilmSupportRead.Load(
        int3(baseCoordinate.x, nextCoordinate.y, 0));
    float d = _FoamFilmSupportRead.Load(int3(nextCoordinate, 0));
    return saturate(lerp(lerp(a, b, blend.x), lerp(c, d, blend.x), blend.y));
}


FoamMaterialState FoamSampleMaterialStateForDomainUV(
    float2 domainUV,
    float validFluid)
{
    // Persistent material now occupies its actual domain-space cell. Layer D
    // samples it directly; no global phase coordinate exists after 5.16B.
    float2 materialPixel = FoamUVToTexelCoordinate(
        domainUV,
        _FoamDimensions);
    float4 packed = FoamClipPackedToValidFluid(
        SampleStateBilinear(materialPixel),
        validFluid);
    return FoamDecodeMaterialState(packed);
}


struct FoamVisualFilmInfluence
{
    float supportBias;
    float negativeSuppression;
};


FoamVisualFilmInfluence FoamResolveVisualFilmInfluenceAtDomainUV(
    float2 domainUV)
{
    float2 topologyPixel = FoamUVToTexelCoordinate(
        domainUV,
        _FoamTopologyDimensions);
    float4 topologyState = SampleTopologyBilinear(topologyPixel);
    float4 anchoredSources = SampleTopologySourcesBilinear(topologyPixel);

    float anchoredSupport = max(
        max(anchoredSources.r * 0.70, anchoredSources.g * 0.58),
        anchoredSources.b * 0.82);
    float structuralSupport = max(
        topologyState.r * 0.36,
        topologyState.g * 0.42);
    float combinedSupport = saturate(max(anchoredSupport, structuralSupport));

    FoamVisualFilmInfluence influence;
    // 5.13D keeps support as a conservative bias only. The earlier range
    // over-amplified already-material-derived film and made the half-res spread
    // read as generic support dilation instead of source-shaped visual film.
    influence.supportBias = lerp(0.94, 1.08, combinedSupport);
    influence.negativeSuppression = 1.0 -
        smoothstep(0.22, 0.85, saturate(topologyState.b)) * 0.62;
    return influence;
}


float FoamResolveVisualFilmSourceAtDomainUV(float2 domainUV)
{
    bool insideDomain = FoamGridUsesFixedMetricLattice()
        ? IsFoamGridUInsideDomain(domainUV.x)
        : IsFoamUInsideDomain(domainUV.x);
    if (!insideDomain)
    {
        return 0.0;
    }

    float2 domainPixel = FoamUVToTexelCoordinate(domainUV, _FoamDimensions);
    float boundaryCoverage = SampleBoundaryCoverageBilinear(domainPixel);
    float obstacleFootprint = SampleObstacleExclusionBilinear(domainPixel);
    float validFluid = saturate(boundaryCoverage * (1.0 - obstacleFootprint));
    FoamMaterialState material = FoamSampleMaterialStateForDomainUV(
        domainUV,
        validFluid);
    FoamVisualFilmInfluence influence =
        FoamResolveVisualFilmInfluenceAtDomainUV(domainUV);

    float materialBody = smoothstep(0.035, 0.36, material.presence) *
        smoothstep(0.015, 0.070, material.remainingLife);

    // Layer D Film Source is material-derived. Layer B support/contact fields
    // may bias or suppress visible film around existing material, but they must
    // not create source coverage from zero. This keeps support topology visible
    // only in explicit topology debug views unless actual material feeds it.
    float source = materialBody * influence.supportBias;
    return saturate(source * validFluid * influence.negativeSuppression);
}


float FoamResolveFixedFilmSource(int2 filmCoordinate)
{
    int startX;
    int countX;
    int startY;
    int countY;
    FoamResolveFilmStructuralRange1D(
        filmCoordinate.x,
        _FoamDimensions.x,
        startX,
        countX);
    FoamResolveFilmStructuralRange1D(
        filmCoordinate.y,
        _FoamDimensions.y,
        startY,
        countY);

    float weightedSource = 0.0;
    float representedArea = 0.0;
    [unroll]
    for (int localX = 0; localX < 2; localX++)
    {
        if (localX >= countX)
        {
            continue;
        }
        [unroll]
        for (int localY = 0; localY < 2; localY++)
        {
            if (localY >= countY)
            {
                continue;
            }

            int2 structuralCoordinate = int2(
                startX + localX,
                startY + localY);
            float cellArea = FoamTransportCellArea(
                structuralCoordinate.x,
                structuralCoordinate.y);
            float2 fieldUV = FoamTexelCentreUV(
                (uint2)structuralCoordinate,
                _FoamDimensions);
            weightedSource +=
                FoamResolveVisualFilmSourceAtDomainUV(fieldUV) * cellArea;
            representedArea += cellArea;
        }
    }

    return representedArea > 0.000001
        ? saturate(weightedSource / representedArea)
        : 0.0;
}


[numthreads(8, 8, 1)]
void BuildFoamFilmSource(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamFilmDimensions.x ||
        dispatchId.y >= (uint)_FoamFilmDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(dispatchId.xy);
    if (FoamGridUsesFixedMetricLattice())
    {
        _FoamFilmSourceWrite[coordinate] =
            FoamResolveFixedFilmSource(coordinate);
        return;
    }

    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamFilmDimensions);
    _FoamFilmSourceWrite[coordinate] = FoamResolveVisualFilmSourceAtDomainUV(uv);
}


int FoamResolveFixedFilmOffsetCells(
    float distanceMetres,
    float structuralSpacingMetres)
{
    float filmSpacingMetres = max(
        0.0001,
        structuralSpacingMetres * 2.0);
    return max(1, (int)round(distanceMetres / filmSpacingMetres));
}


[numthreads(8, 8, 1)]
void BuildFoamFilmSupport(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamFilmDimensions.x ||
        dispatchId.y >= (uint)_FoamFilmDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(dispatchId.xy);
    int flowStep = _FoamFlowDirection >= 0.0 ? 1 : -1;
    int alongNear = 1;
    int alongMid = 2;
    int alongFar = 3;
    int acrossNear = 1;
    int acrossFar = 2;
    if (FoamGridUsesFixedMetricLattice())
    {
        alongNear = FoamResolveFixedFilmOffsetCells(
            0.30,
            _FoamGridDescriptorSpacing.z);
        alongMid = FoamResolveFixedFilmOffsetCells(
            0.60,
            _FoamGridDescriptorSpacing.z);
        alongFar = FoamResolveFixedFilmOffsetCells(
            0.90,
            _FoamGridDescriptorSpacing.z);
        acrossNear = FoamResolveFixedFilmOffsetCells(
            0.30,
            _FoamGridDescriptorSpacing.w);
        acrossFar = FoamResolveFixedFilmOffsetCells(
            0.60,
            _FoamGridDescriptorSpacing.w);
    }

    float centre = FoamLoadFilmSource(coordinate);

    float along = centre * 0.32;
    along += FoamLoadFilmSource(
        coordinate + int2(-flowStep * alongNear, 0)) * 0.12;
    along += FoamLoadFilmSource(
        coordinate + int2(flowStep * alongNear, 0)) * 0.18;
    along += FoamLoadFilmSource(
        coordinate + int2(-flowStep * alongMid, 0)) * 0.075;
    along += FoamLoadFilmSource(
        coordinate + int2(flowStep * alongMid, 0)) * 0.115;
    along += FoamLoadFilmSource(
        coordinate + int2(-flowStep * alongFar, 0)) * 0.030;
    along += FoamLoadFilmSource(
        coordinate + int2(flowStep * alongFar, 0)) * 0.055;

    float acrossRaw = centre * 0.28;
    acrossRaw += FoamLoadFilmSource(
        coordinate + int2(0, -acrossNear)) * 0.115;
    acrossRaw += FoamLoadFilmSource(
        coordinate + int2(0, acrossNear)) * 0.115;
    acrossRaw += FoamLoadFilmSource(
        coordinate + int2(0, -acrossFar)) * 0.035;
    acrossRaw += FoamLoadFilmSource(
        coordinate + int2(0, acrossFar)) * 0.035;

    // Cross-flow spread should be present, but it must be source-supported and
    // weaker than along-flow continuity. This prevents the low-res helper from
    // turning every material ribbon into a uniform capsule.
    float axialEvidence = max(centre, along);
    float localEvidence = max(axialEvidence, acrossRaw);
    float acrossGate = smoothstep(0.045, 0.24, localEvidence) *
        lerp(0.42, 1.0, smoothstep(0.16, 0.54, axialEvidence));
    float across = acrossRaw * acrossGate;

    float diagonal = 0.0;
    diagonal += FoamLoadFilmSource(
        coordinate + int2(-flowStep * alongNear, -acrossNear));
    diagonal += FoamLoadFilmSource(
        coordinate + int2(-flowStep * alongNear, acrossNear));
    diagonal += FoamLoadFilmSource(
        coordinate + int2(flowStep * alongNear, -acrossNear));
    diagonal += FoamLoadFilmSource(
        coordinate + int2(flowStep * alongNear, acrossNear));
    diagonal *= 0.042 * acrossGate;

    float sheet = max(max(centre, along), max(across * 0.54, diagonal));
    float bridge = smoothstep(0.28, 0.68, along) *
        smoothstep(0.20, 0.56, across);
    float2 domainUV = FoamGridUsesFixedMetricLattice()
        ? FoamFilmTexelCentreFieldUV(coordinate)
        : FoamTexelCentreUV(dispatchId.xy, _FoamFilmDimensions);
    FoamVisualFilmInfluence influence =
        FoamResolveVisualFilmInfluenceAtDomainUV(domainUV);
    float spread = max(sheet, bridge * 0.42);

    // Film Support spreads only material-derived Film Source. Layer B support
    // biases that spread and negative topology suppresses it; neither path
    // seeds visible film without material-derived source coverage.
    _FoamFilmSupportWrite[coordinate] = saturate(
        spread * influence.supportBias * influence.negativeSuppression);
}



float FoamResolveInstantaneousFilmTarget(float source, float support)
{
    float supportShape = smoothstep(0.28, 0.74, saturate(support));
    float sourceShape = smoothstep(0.10, 0.46, saturate(source));
    return saturate(max(sourceShape * 0.68, supportShape * 0.60));
}


float FoamSampleVisualOccupancyBilinear(float2 uv)
{
    int2 baseCoordinate;
    int2 nextCoordinate;
    float2 blend;
    float2 filmUV = FoamFieldUVToFilmUV(uv);
    FoamResolveFilmBilinearCoordinates(
        filmUV,
        baseCoordinate,
        nextCoordinate,
        blend);

    float a = _FoamVisualOccupancyRead.Load(int3(baseCoordinate, 0));
    float b = _FoamVisualOccupancyRead.Load(
        int3(nextCoordinate.x, baseCoordinate.y, 0));
    float c = _FoamVisualOccupancyRead.Load(
        int3(baseCoordinate.x, nextCoordinate.y, 0));
    float d = _FoamVisualOccupancyRead.Load(int3(nextCoordinate, 0));
    return saturate(lerp(lerp(a, b, blend.x), lerp(c, d, blend.x), blend.y));
}


bool FoamVisualOccupancyInsideGrid(int2 coordinate)
{
    return coordinate.x >= 0 && coordinate.x < _FoamFilmDimensions.x &&
        coordinate.y >= 0 && coordinate.y < _FoamFilmDimensions.y;
}


float2 FoamVisualOccupancyDomainUV(int2 coordinate)
{
    if (FoamGridUsesFixedMetricLattice())
    {
        return FoamFilmTexelCentreFieldUV(coordinate);
    }

    return ((float2)coordinate + 0.5) /
        max(float2(1.0, 1.0), (float2)_FoamFilmDimensions);
}


bool FoamVisualOccupancyInsideSimulation(int2 coordinate)
{
    if (!FoamVisualOccupancyInsideGrid(coordinate))
    {
        return false;
    }

    if (!FoamGridUsesFixedMetricLattice())
    {
        float2 domainUV = FoamVisualOccupancyDomainUV(coordinate);
        return domainUV.x * _FoamFieldLength <=
            _FoamSimulationLength + 0.0001;
    }

    int structuralStart;
    int representedCount;
    FoamResolveFilmStructuralRange1D(
        coordinate.x,
        _FoamDimensions.x,
        structuralStart,
        representedCount);
    [unroll]
    for (int localX = 0; localX < 2; localX++)
    {
        if (localX < representedCount &&
            IsFoamGridColumnInsideSimulation(structuralStart + localX))
        {
            return true;
        }
    }
    return false;
}


int FoamVisualOccupancyMetricRow(int filmX)
{
    if (FoamGridUsesFixedMetricLattice())
    {
        int structuralStart = 0;
        int representedCount = 0;
        FoamResolveFilmStructuralRange1D(
            filmX,
            _FoamDimensions.x,
            structuralStart,
            representedCount);
        int centreOffset = representedCount > 1 ? 1 : 0;
        return clamp(
            structuralStart + centreOffset,
            0,
            max(0, _FoamDimensions.x - 1));
    }

    float domainU = ((float)filmX + 0.5) /
        max(1.0, (float)_FoamFilmDimensions.x);
    return clamp(
        (int)floor(domainU * (float)_FoamDimensions.x),
        0,
        max(0, _FoamDimensions.x - 1));
}


float FoamVisualOccupancyLongitudinalSpacing(int filmX)
{
    float resolvedSpacing = 0.0001;
    if (FoamGridUsesFixedMetricLattice())
    {
        int structuralStart = 0;
        int representedCount = 0;
        FoamResolveFilmStructuralRange1D(
            filmX,
            _FoamDimensions.x,
            structuralStart,
            representedCount);
        float fixedSpacing = 0.0;
        [unroll]
        for (int localX = 0; localX < 2; localX++)
        {
            if (localX < representedCount)
            {
                fixedSpacing += FoamTransportLongitudinalSpacing(
                    structuralStart + localX);
            }
        }
        resolvedSpacing = max(0.0001, fixedSpacing);
    }
    else
    {
        resolvedSpacing = max(
            0.0001,
            _FoamFieldLength / max(1.0, (float)_FoamFilmDimensions.x));
    }

    return resolvedSpacing;
}


float FoamVisualOccupancyLateralSpacing(int filmX, int filmY)
{
    int metricX = FoamVisualOccupancyMetricRow(filmX);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    if (FoamGridUsesFixedMetricLattice())
    {
        int structuralStart;
        int representedCount;
        FoamResolveFilmStructuralRange1D(
            filmY,
            _FoamDimensions.y,
            structuralStart,
            representedCount);
        return max(
            0.0001,
            (float)representedCount *
                FoamTransportLateralSpacing(metricX));
    }

    float totalWidth = max(
        0.0001,
        metric.widthsAndSpacing.x + metric.widthsAndSpacing.y);
    return max(
        0.0001,
        totalWidth / max(1.0, (float)_FoamFilmDimensions.y));
}


float FoamVisualOccupancyCellArea(int2 filmCoordinate)
{
    float resolvedArea = 0.0001;
    if (FoamGridUsesFixedMetricLattice())
    {
        int startX = 0;
        int countX = 0;
        int startY = 0;
        int countY = 0;
        FoamResolveFilmStructuralRange1D(
            filmCoordinate.x,
            _FoamDimensions.x,
            startX,
            countX);
        FoamResolveFilmStructuralRange1D(
            filmCoordinate.y,
            _FoamDimensions.y,
            startY,
            countY);
        float fixedArea = 0.0;
        [unroll]
        for (int localX = 0; localX < 2; localX++)
        {
            if (localX < countX)
            {
                [unroll]
                for (int localY = 0; localY < 2; localY++)
                {
                    if (localY < countY)
                    {
                        fixedArea += FoamTransportCellArea(
                            startX + localX,
                            startY + localY);
                    }
                }
            }
        }
        resolvedArea = max(0.0001, fixedArea);
    }
    else
    {
        resolvedArea =
            FoamVisualOccupancyLongitudinalSpacing(filmCoordinate.x) *
            FoamVisualOccupancyLateralSpacing(
                filmCoordinate.x,
                filmCoordinate.y);
    }

    return resolvedArea;
}


float FoamVisualOccupancyValidFluidAt(int2 coordinate)
{
    if (!FoamVisualOccupancyInsideSimulation(coordinate))
    {
        return 0.0;
    }

    if (!FoamGridUsesFixedMetricLattice())
    {
        float2 domainUV = FoamVisualOccupancyDomainUV(coordinate);
        float2 materialPixel = FoamUVToTexelCoordinate(
            domainUV,
            _FoamDimensions);
        float boundaryCoverage = SampleBoundaryCoverageBilinear(materialPixel);
        float obstacleFootprint = SampleObstacleExclusionBilinear(materialPixel);
        return saturate(boundaryCoverage * (1.0 - obstacleFootprint));
    }

    int startX;
    int countX;
    int startY;
    int countY;
    FoamResolveFilmStructuralRange1D(
        coordinate.x,
        _FoamDimensions.x,
        startX,
        countX);
    FoamResolveFilmStructuralRange1D(
        coordinate.y,
        _FoamDimensions.y,
        startY,
        countY);
    float validArea = 0.0;
    float representedArea = 0.0;
    [unroll]
    for (int localX = 0; localX < 2; localX++)
    {
        if (localX >= countX)
        {
            continue;
        }
        [unroll]
        for (int localY = 0; localY < 2; localY++)
        {
            if (localY >= countY)
            {
                continue;
            }
            int2 structuralCoordinate = int2(
                startX + localX,
                startY + localY);
            float cellArea = FoamTransportCellArea(
                structuralCoordinate.x,
                structuralCoordinate.y);
            representedArea += cellArea;
            validArea += FoamValidFluidAt(structuralCoordinate) * cellArea;
        }
    }
    return representedArea > 0.000001
        ? saturate(validArea / representedArea)
        : 0.0;
}


float FoamLoadVisualOccupancy(
    int2 coordinate,
    out float validFluid)
{
    validFluid = FoamVisualOccupancyValidFluidAt(coordinate);
    if (validFluid <= FoamMaterialStateEpsilon)
    {
        return 0.0;
    }

    return min(
        saturate(_FoamVisualOccupancyRead.Load(int3(coordinate, 0))),
        validFluid);
}


float2 FoamResolveVisualOccupancyGridVelocity(
    int2 coordinate,
    float validFluid)
{
    float2 domainUV = FoamVisualOccupancyDomainUV(coordinate);
    float2 materialCoordinate = domainUV * (float2)_FoamDimensions;
    RiverWaterFoamResolvedVelocity resolved = FoamResolveVelocity(
        materialCoordinate,
        validFluid);
    float flowSign = _FoamFlowDirection >= 0.0 ? 1.0 : -1.0;
    return float2(
        resolved.velocityMetresPerSecond.x * flowSign,
        resolved.velocityMetresPerSecond.y);
}


void FoamResolveVisualLongitudinalFaceFlux(
    int leftX,
    int y,
    out float resolvedFlux)
{
    resolvedFlux = 0.0;
    int2 leftCoordinate = int2(leftX, y);
    int2 rightCoordinate = int2(leftX + 1, y);
    bool leftInside = FoamVisualOccupancyInsideSimulation(leftCoordinate);
    bool rightInside = FoamVisualOccupancyInsideSimulation(rightCoordinate);

    if (leftInside && rightInside)
    {
        float leftValid;
        float rightValid;
        float leftOccupancy = FoamLoadVisualOccupancy(
            leftCoordinate,
            leftValid);
        float rightOccupancy = FoamLoadVisualOccupancy(
            rightCoordinate,
            rightValid);
        if (leftValid <= FoamMaterialStateEpsilon ||
            rightValid <= FoamMaterialStateEpsilon)
        {
            return;
        }

        float leftVelocity = FoamResolveVisualOccupancyGridVelocity(
            leftCoordinate,
            leftValid).x;
        float rightVelocity = FoamResolveVisualOccupancyGridVelocity(
            rightCoordinate,
            rightValid).x;
        float faceVelocity = 0.5 * (leftVelocity + rightVelocity);
        float faceLength = 0.5 * (
            FoamVisualOccupancyLateralSpacing(leftX, y) +
            FoamVisualOccupancyLateralSpacing(leftX + 1, y));
        float donor = faceVelocity >= 0.0
            ? leftOccupancy
            : rightOccupancy;
        resolvedFlux = faceVelocity * faceLength * donor;
        return;
    }

    // Match Layer C endpoint ownership: no external inflow, one-way outflow
    // only at the physical downstream endpoint selected by signed grid flow.
    if (leftInside && !rightInside)
    {
        float leftValid;
        float leftOccupancy = FoamLoadVisualOccupancy(
            leftCoordinate,
            leftValid);
        if (leftValid <= FoamMaterialStateEpsilon)
        {
            return;
        }

        float faceVelocity = FoamResolveVisualOccupancyGridVelocity(
            leftCoordinate,
            leftValid).x;
        if (faceVelocity > 0.0)
        {
            resolvedFlux = faceVelocity *
                FoamVisualOccupancyLateralSpacing(leftX, y) *
                leftOccupancy;
        }
        return;
    }

    if (!leftInside && rightInside)
    {
        float rightValid;
        float rightOccupancy = FoamLoadVisualOccupancy(
            rightCoordinate,
            rightValid);
        if (rightValid <= FoamMaterialStateEpsilon)
        {
            return;
        }

        float faceVelocity = FoamResolveVisualOccupancyGridVelocity(
            rightCoordinate,
            rightValid).x;
        if (faceVelocity < 0.0)
        {
            resolvedFlux = faceVelocity *
                FoamVisualOccupancyLateralSpacing(
                    rightCoordinate.x,
                    y) *
                rightOccupancy;
        }
    }
}


void FoamResolveVisualLateralFaceFlux(
    int x,
    int lowerY,
    out float resolvedFlux)
{
    resolvedFlux = 0.0;
    int2 lowerCoordinate = int2(x, lowerY);
    int2 upperCoordinate = int2(x, lowerY + 1);
    if (!FoamVisualOccupancyInsideSimulation(lowerCoordinate) ||
        !FoamVisualOccupancyInsideSimulation(upperCoordinate))
    {
        return;
    }

    float lowerValid;
    float upperValid;
    float lowerOccupancy = FoamLoadVisualOccupancy(
        lowerCoordinate,
        lowerValid);
    float upperOccupancy = FoamLoadVisualOccupancy(
        upperCoordinate,
        upperValid);
    if (lowerValid <= FoamMaterialStateEpsilon ||
        upperValid <= FoamMaterialStateEpsilon)
    {
        return;
    }

    float lowerVelocity = FoamResolveVisualOccupancyGridVelocity(
        lowerCoordinate,
        lowerValid).y;
    float upperVelocity = FoamResolveVisualOccupancyGridVelocity(
        upperCoordinate,
        upperValid).y;
    float faceVelocity = 0.5 * (lowerVelocity + upperVelocity);
    float donor = faceVelocity >= 0.0
        ? lowerOccupancy
        : upperOccupancy;
    float faceLength = FoamVisualOccupancyLongitudinalSpacing(x);
    if (FoamGridUsesFixedMetricLattice())
    {
        int startX;
        int countX;
        int lowerStartY;
        int lowerCountY;
        FoamResolveFilmStructuralRange1D(
            x,
            _FoamDimensions.x,
            startX,
            countX);
        FoamResolveFilmStructuralRange1D(
            lowerY,
            _FoamDimensions.y,
            lowerStartY,
            lowerCountY);
        int structuralLowerY = lowerStartY + lowerCountY - 1;
        faceLength = 0.0;
        [unroll]
        for (int localX = 0; localX < 2; localX++)
        {
            if (localX < countX)
            {
                faceLength += FoamTransportLateralFaceLength(
                    startX + localX,
                    structuralLowerY);
            }
        }
    }
    resolvedFlux = faceVelocity * faceLength * donor;
}


[numthreads(8, 8, 1)]
void AdvanceFoamVisualOccupancy(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamFilmDimensions.x ||
        dispatchId.y >= (uint)_FoamFilmDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(dispatchId.xy);
    float validFluid;
    float currentOccupancy = FoamLoadVisualOccupancy(
        coordinate,
        validFluid);
    if (validFluid <= FoamMaterialStateEpsilon)
    {
        _FoamVisualOccupancyWrite[coordinate] = 0.0;
        return;
    }

    float westFlux = 0.0;
    float eastFlux = 0.0;
    float southFlux = 0.0;
    float northFlux = 0.0;
    FoamResolveVisualLongitudinalFaceFlux(
        coordinate.x - 1,
        coordinate.y,
        westFlux);
    FoamResolveVisualLongitudinalFaceFlux(
        coordinate.x,
        coordinate.y,
        eastFlux);
    FoamResolveVisualLateralFaceFlux(
        coordinate.x,
        coordinate.y - 1,
        southFlux);
    FoamResolveVisualLateralFaceFlux(
        coordinate.x,
        coordinate.y,
        northFlux);

    float area = FoamVisualOccupancyCellArea(coordinate);
    float transportedOccupancy = currentOccupancy -
        _FoamDeltaTime / max(0.000001, area) *
        ((eastFlux - westFlux) + (northFlux - southFlux));
    transportedOccupancy = clamp(transportedOccupancy, 0.0, validFluid);

    float target = FoamResolveInstantaneousFilmTarget(
        _FoamFilmSourceRead.Load(int3(coordinate, 0)),
        _FoamFilmSupportRead.Load(int3(coordinate, 0))) * validFluid;
    float responseTime = target > transportedOccupancy
        ? max(0.0001, _FoamVisualOccupancyBuildTime)
        : max(0.0001, _FoamVisualOccupancyReleaseTime);
    float response = saturate(
        1.0 - exp(-max(0.0, _FoamDeltaTime) / responseTime));
    float updatedOccupancy = lerp(
        transportedOccupancy,
        target,
        response);

    _FoamVisualOccupancyWrite[coordinate] =
        clamp(updatedOccupancy, 0.0, validFluid);
}


[numthreads(8, 8, 1)]
void EvaluateFoamShape(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    float validFluid = FoamValidFluidAt(coordinate);
    if (validFluid <= FoamMaterialStateEpsilon)
    {
        _FoamShapeMaskWrite[coordinate] = 0.0;
        return;
    }

    float2 domainUV = FoamTexelCentreUV(
        uint2((uint)coordinate.x, (uint)coordinate.y),
        _FoamDimensions);
    FoamMaterialState material = FoamSampleMaterialStateForDomainUV(
        domainUV,
        validFluid);
    float baseShape = FoamEvaluateIntrinsicShapeMask(material, validFluid);

    float visualFilm = FoamSampleVisualOccupancyBilinear(domainUV);

    // Layer D now owns an advected temporal visual sheet. The occupancy field
    // relaxes toward instantaneous Film Source / Film Support but never writes
    // back to FoamState or Remaining Life. Fine sub-cell fragmentation remains
    // Layer E shader work.
    _FoamShapeMaskWrite[coordinate] = saturate(max(baseShape, visualFilm) *
        validFluid);
}

[numthreads(8, 8, 1)]
void ApplyBoundary(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    bool insideSimulation = FoamGridUsesFixedMetricLattice()
        ? IsFoamGridColumnInsideSimulation(x)
        : IsFoamColumnInsideSimulation(x);
    if (!insideSimulation)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float validFluid = FoamValidFluidAt(coordinate);
    float4 state = _FoamStateWrite[coordinate];
    _FoamStateWrite[coordinate] = FoamClipPackedToValidFluid(
        state,
        validFluid);
}

[numthreads(8, 8, 1)]
void InjectFoam(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamRangeCountY)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = _FoamRangeStartY + (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x ||
        y < 0 || y >= _FoamDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    if (!IsFoamGridColumnInsideDomain(x))
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float coverage = LoadBoundaryCoverage(coordinate);
    float obstacleFootprint = saturate(
        _FoamObstacleExclusionRead.Load(int3(coordinate, 0)));
    float validFluid = coverage * (1.0 - obstacleFootprint);
    if (validFluid <= 0.001)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    FoamMetricRow metric = _FoamMetricRows[x];
    float lateralMetres = FoamLateralMetresAtTexel(y, metric);
    float centreAcrossMetres = _FoamInjectionUsesMetricLateral > 0.5
        ? _FoamInjectionLateralMetres
        : FoamAcross01ToMetres(
            saturate(_FoamInjectionAcrossNormalized * 0.5 + 0.5),
            metric.widthsAndSpacing.x,
            metric.widthsAndSpacing.y);
    float globalDistance = _FoamGlobalStart +
        FoamGridLocalDistanceAtTexel(x);
    float2 physicalPosition = float2(globalDistance, lateralMetres);
    float2 physicalCellSpacing = float2(
        max(0.01, metric.widthsAndSpacing.z),
        max(0.01, metric.widthsAndSpacing.w));

    float alongRadius = max(
        0.05,
        _FoamInjectionRadius * _FoamInjectionElongation);
    float acrossRadius = max(0.05, _FoamInjectionRadius);
    float alongDistance =
        (globalDistance - _FoamInjectionGlobalDistance) / alongRadius;
    float acrossDistance =
        (lateralMetres - centreAcrossMetres) / acrossRadius;
    float radial = length(float2(alongDistance, acrossDistance));
    float sourceEdgeWidth = max(
        physicalCellSpacing.x / alongRadius,
        physicalCellSpacing.y / acrossRadius) * 0.75;
    sourceEdgeWidth = clamp(sourceEdgeWidth, 0.015, 0.30);
    float ellipseShape = 1.0 - smoothstep(
        1.0 - sourceEdgeWidth,
        1.0 + sourceEdgeWidth,
        radial);
    float compoundRaw = EvaluateCompoundInjectionShape(
        alongDistance,
        acrossDistance);
    float compoundEdgeWidth = clamp(sourceEdgeWidth * 0.75, 0.02, 0.18);
    float compoundShape = smoothstep(
        0.12 - compoundEdgeWidth,
        0.12 + compoundEdgeWidth,
        compoundRaw);
    float shape = lerp(
        ellipseShape,
        compoundShape,
        saturate(_FoamInjectionCompound));
    float sourceAmount = saturate(_FoamInjectionAmount);

    if (_FoamInjectionSegment > 0.5)
    {
        float4 segmentSample = ResolveFoamSegmentInjectionSample(
            physicalPosition,
            physicalCellSpacing,
            metric);
        shape = segmentSample.x;
        sourceAmount = segmentSample.y;
    }

    float sourceFill = EvaluateFoamSourceFillCoverage(
        physicalPosition,
        sourceAmount,
        _FoamInjectionSourceFillSeed,
        _FoamInjectionSourceFillFeatureSize,
        physicalCellSpacing);
    float injectedPresence = saturate(shape * sourceFill * validFluid);
    if (injectedPresence <= FoamMaterialStateEpsilon)
    {
        return;
    }

    FoamMaterialState sourceState;
    sourceState.presence = injectedPresence;
    sourceState.remainingLife = saturate(_FoamInjectionRemainingLife);
    sourceState.materialPattern = EvaluateFoamMaterialPattern(
        physicalPosition,
        _FoamInjectionPatternSeed,
        _FoamInjectionSourceFillFeatureSize,
        physicalCellSpacing);
    float4 sourcePacked = FoamEncodeMaterialState(sourceState);
    _FoamStateWrite[coordinate] = FoamMergeBornPresence(
        _FoamStateWrite[coordinate],
        sourcePacked);

}


static const float FoamSourceEventTypeShoreRibbon = 1.0;
static const float FoamSourceEventTypeInwardWash = 2.0;

float FoamSourceEventBreakup(
    float2 sourceLocal,
    float sourceFillSeed,
    float scaleMetres,
    float strength,
    float2 physicalCellSpacing)
{
    float maximumCellSpacing = max(
        max(0.01, physicalCellSpacing.x),
        max(0.01, physicalCellSpacing.y));
    float featureSize = max(max(0.08, scaleMetres), maximumCellSpacing * 2.0);
    float value = EvaluateFoamSourceFillField(
        sourceLocal,
        sourceFillSeed,
        featureSize);
    float keep = smoothstep(0.18, 0.82, value);
    return lerp(1.0, keep, saturate(strength));
}

float FoamSourceEventSoftRange(
    float value,
    float lower,
    float upper,
    float feather)
{
    return smoothstep(lower, lower + feather, value) *
        (1.0 - smoothstep(upper - feather, upper, value));
}

float FoamEvaluateShoreRibbonSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float shoreMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float flowDirection = sourceEvent.distance.w >= 0.0 ? 1.0 : -1.0;
    float alongLength = max(
        0.001,
        abs(sourceEvent.distance.y - sourceEvent.distance.x));
    float alongFromStart = flowDirection *
        (globalDistance - sourceEvent.distance.x);
    float progress = saturate(sourceEvent.header.z);
    float revealedLength = max(
        max(physicalCellSpacing.x, sourceEvent.shore.w),
        alongLength * progress);
    float revealFeather = max(
        max(physicalCellSpacing.x, sourceEvent.shore.w),
        alongLength * 0.045);
    float revealMask = 1.0 - smoothstep(
        revealedLength,
        revealedLength + revealFeather,
        alongFromStart);
    float endMask = FoamSourceEventSoftRange(
        alongFromStart,
        0.0,
        alongLength,
        max(sourceEvent.shore.w, alongLength * 0.055));

    float inwardMetres = sourceEvent.header.y < 0.0
        ? lateralMetres - shoreMetres
        : shoreMetres - lateralMetres;
    float centre = sourceEvent.shore.x;
    float crossRiverCellSpacing = max(0.005, physicalCellSpacing.y);
    float sourceThickness = FoamGridUsesFixedMetricLattice()
        ? max(0.005, sourceEvent.shore.y)
        : max(0.5, sourceEvent.shore.y) *
            crossRiverCellSpacing;
    float halfWidth = sourceThickness * 0.5;
    float feather = crossRiverCellSpacing * 0.5;
    float bandDistance = abs(inwardMetres - centre);
    float core = 1.0 - smoothstep(
        halfWidth * 0.62,
        halfWidth + feather * 0.18,
        bandDistance);
    float softBand = 1.0 - smoothstep(
        halfWidth,
        halfWidth + feather,
        bandDistance);

    float strandPhase = FoamHash11(sourceEvent.header.w + 17.0) * 6.2831853;
    float strand = 0.72 + 0.28 * sin(
        alongFromStart / max(0.12, sourceEvent.variation.y) * 2.9 +
        strandPhase);
    float breakup = FoamSourceEventBreakup(
        float2(alongFromStart, inwardMetres),
        sourceEvent.variation.x,
        sourceEvent.variation.y,
        sourceEvent.variation.z,
        physicalCellSpacing);
    float irregularEdge = lerp(1.0, saturate(breakup * strand), 0.82);
    float shape = saturate(max(core, softBand * irregularEdge) *
        endMask * revealMask);

    amountMultiplier = 1.0;
    return shape;
}

float FoamEvaluateInwardWashSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float shoreMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float flowDirection = sourceEvent.distance.w >= 0.0 ? 1.0 : -1.0;
    float alongLength = max(
        0.001,
        abs(sourceEvent.distance.y - sourceEvent.distance.x));
    float halfLength = alongLength * 0.5;
    float signedAlong = (globalDistance - sourceEvent.distance.z) *
        flowDirection;
    float inwardMetres = sourceEvent.header.y < 0.0
        ? lateralMetres - shoreMetres
        : shoreMetres - lateralMetres;
    float progress = saturate(sourceEvent.header.z);
    float cellSize = max(physicalCellSpacing.x, physicalCellSpacing.y);
    float feather = max(
        max(0.006, sourceEvent.shore.w * 0.70),
        cellSize * 0.55);
    float baseInset = max(0.0, sourceEvent.shore.x);
    float inwardReach = max(feather, sourceEvent.shore.z);
    float strokeWidth = max(
        sourceEvent.shore.y * 0.38,
        cellSize * 0.28);
    float localInward = inwardMetres - baseInset;

    float pathLength = max(
        0.001,
        max(sourceEvent.kinematics.z, sqrt(alongLength * alongLength +
            inwardReach * inwardReach)));
    float trailFraction = clamp(
        sourceEvent.kinematics.y / pathLength,
        0.012,
        0.11);
    float headS = progress;
    float tailS = max(0.0, headS - trailFraction);
    float sampleSpan = max(0.001, headS - tailS);
    float minDistance = 100000.0;
    float nearestS = 0.0;

    [unroll]
    for (int sampleIndex = 0; sampleIndex < 6; sampleIndex++)
    {
        float sampleT = (float)sampleIndex / 5.0;
        float s = tailS + sampleSpan * sampleT;
        float turnStart = 0.22 +
            0.12 * FoamHash11(sourceEvent.header.w + 41.0);
        float peelT = saturate((s - turnStart) /
            max(0.001, 1.0 - turnStart));
        float peel = peelT * peelT * (3.0 - 2.0 * peelT);
        float pathAlong = lerp(-halfLength, halfLength, s) +
            sourceEvent.variation.w * max(0.08, inwardReach) *
            peel * (1.0 - peel) * 0.65;
        float pathInward = baseInset + inwardReach * peel;
        float distanceToCurve = distance(
            float2(signedAlong, inwardMetres),
            float2(pathAlong, pathInward));
        if (distanceToCurve < minDistance)
        {
            minDistance = distanceToCurve;
            nearestS = s;
        }
    }

    float stroke = 1.0 - smoothstep(
        strokeWidth,
        strokeWidth + feather,
        minDistance);
    float validInwardMask = smoothstep(
        -feather * 0.50,
        feather * 0.50,
        localInward) *
        (1.0 - smoothstep(
            inwardReach + feather * 0.50,
            inwardReach + feather * 1.35,
            localInward));
    float startCap = smoothstep(0.0, 0.030, headS + trailFraction);
    float endTaper = 1.0 - smoothstep(0.84, 1.04, nearestS);
    float breakup = FoamSourceEventBreakup(
        float2(signedAlong, localInward),
        sourceEvent.variation.x,
        sourceEvent.variation.y,
        sourceEvent.variation.z,
        physicalCellSpacing);
    float shape = saturate(stroke * validInwardMask * startCap *
        lerp(1.0, breakup, 0.32) * lerp(1.0, 0.78, nearestS) *
        max(0.72, endTaper));

    amountMultiplier = lerp(1.0, 0.92, nearestS);
    return shape;
}


float4 FoamLoadObjectContactField(int2 coordinate)
{
    int2 clamped = clamp(
        coordinate,
        int2(0, 0),
        max(int2(0, 0), _FoamDimensions - int2(1, 1)));
    return _FoamObjectContactFieldRead.Load(int3(clamped, 0));
}

float FoamDistanceSquaredToSegment(
    float2 queryPosition,
    float2 segmentStart,
    float2 segmentEnd,
    out float segmentT)
{
    float2 segment = segmentEnd - segmentStart;
    float segmentLengthSquared = max(0.000001, dot(segment, segment));
    segmentT = saturate(
        dot(queryPosition - segmentStart, segment) /
        segmentLengthSquared);
    float2 nearestPoint = segmentStart + segment * segmentT;
    float2 offset = queryPosition - nearestPoint;
    return dot(offset, offset);
}

void FoamUnpackObjectContactProfile(
    FoamSourceEventData sourceEvent,
    out float2 point0,
    out float2 point1,
    out float2 point2,
    out float2 point3,
    out float2 point4,
    out float frontSplit,
    out float negativeFirstSegmentSplit,
    out float positiveFirstSegmentSplit)
{
    point0 = sourceEvent.distance.xy;
    point1 = float2(sourceEvent.distance.w, sourceEvent.shore.x);
    point2 = float2(sourceEvent.shore.w, sourceEvent.variation.y);
    point3 = float2(sourceEvent.variation.z, sourceEvent.kinematics.x);
    point4 = float2(sourceEvent.kinematics.y, sourceEvent.objectData.y);
    frontSplit = clamp(sourceEvent.objectData.z, 0.001, 0.999);
    negativeFirstSegmentSplit = clamp(
        sourceEvent.variation.x,
        0.001,
        0.999);
    positiveFirstSegmentSplit = clamp(
        sourceEvent.kinematics.w,
        0.001,
        0.999);
}

float FoamResolveObjectProfileRibbonShape(
    float2 localPosition,
    float2 segmentStart,
    float2 segmentEnd,
    float distanceSquared,
    float2 physicalCellSpacing)
{
    float2 segment = segmentEnd - segmentStart;
    float segmentLength = max(0.001, sqrt(dot(segment, segment)));
    float tangentX = segment.x / segmentLength;
    float tangentY = segment.y / segmentLength;
    float normalX = 0.0 - tangentY;
    float normalY = tangentX;
    float normalCellSpacing = sqrt(
        normalX * normalX *
            physicalCellSpacing.x * physicalCellSpacing.x +
        normalY * normalY *
            physicalCellSpacing.y * physicalCellSpacing.y);
    float rasterWidth = max(
        0.0015,
        normalCellSpacing * 0.34);
    // Preserve a thin strong row while allowing enough feather radius for
    // diagonally oriented mesh-profile segments to remain 8-connected on the
    // cell-centre raster. The outer radius is approximately 0.72 cell.
    float rasterFeather = max(
        0.002,
        normalCellSpacing * 0.38);
    float distanceToSegment = sqrt(max(0.0, distanceSquared));
    return 1.0 - smoothstep(
        rasterWidth,
        rasterWidth + rasterFeather,
        distanceToSegment);
}

float FoamResolveObjectFrontProfileShape(
    float2 localPosition,
    float2 point0,
    float2 point1,
    float2 point2,
    float2 point3,
    float2 point4,
    float frontSplit,
    float negativeFirstSegmentSplit,
    float positiveFirstSegmentSplit,
    float2 physicalCellSpacing,
    out float frontT)
{
    float2 selectedStart;
    float2 selectedEnd;
    float pathStart;
    float pathSpan;
    if (localPosition.y <= point1.y)
    {
        selectedStart = point0;
        selectedEnd = point1;
        pathStart = 0.0;
        pathSpan = frontSplit * negativeFirstSegmentSplit;
    }
    else if (localPosition.y <= point2.y)
    {
        selectedStart = point1;
        selectedEnd = point2;
        pathStart = frontSplit * negativeFirstSegmentSplit;
        pathSpan = frontSplit * (1.0 - negativeFirstSegmentSplit);
    }
    else if (localPosition.y <= point3.y)
    {
        selectedStart = point2;
        selectedEnd = point3;
        pathStart = frontSplit;
        pathSpan =
            (1.0 - frontSplit) * positiveFirstSegmentSplit;
    }
    else
    {
        selectedStart = point3;
        selectedEnd = point4;
        pathStart = frontSplit +
            (1.0 - frontSplit) * positiveFirstSegmentSplit;
        pathSpan =
            (1.0 - frontSplit) * (1.0 - positiveFirstSegmentSplit);
    }

    float selectedSegmentT;
    float selectedDistanceSquared = FoamDistanceSquaredToSegment(
        localPosition,
        selectedStart,
        selectedEnd,
        selectedSegmentT);
    frontT = pathStart + selectedSegmentT * pathSpan;
    return FoamResolveObjectProfileRibbonShape(
        localPosition,
        selectedStart,
        selectedEnd,
        selectedDistanceSquared,
        physicalCellSpacing);
}

float FoamResolveObjectNegativeHalfProfileShape(
    float2 localPosition,
    float2 point0,
    float2 point1,
    float2 point2,
    float firstSegmentSplit,
    float2 physicalCellSpacing,
    out float halfT)
{
    float2 selectedStart;
    float2 selectedEnd;
    float pathStart;
    if (localPosition.y <= point1.y)
    {
        selectedStart = point0;
        selectedEnd = point1;
        pathStart = 0.0;
    }
    else
    {
        selectedStart = point1;
        selectedEnd = point2;
        pathStart = firstSegmentSplit;
    }

    float selectedSegmentT;
    float selectedDistanceSquared = FoamDistanceSquaredToSegment(
        localPosition,
        selectedStart,
        selectedEnd,
        selectedSegmentT);
    float pathSpan = pathStart <= 0.0
        ? firstSegmentSplit
        : 1.0 - firstSegmentSplit;
    halfT = pathStart + selectedSegmentT * pathSpan;
    return FoamResolveObjectProfileRibbonShape(
        localPosition,
        selectedStart,
        selectedEnd,
        selectedDistanceSquared,
        physicalCellSpacing);
}

float FoamResolveObjectPositiveHalfProfileShape(
    float2 localPosition,
    float2 point2,
    float2 point3,
    float2 point4,
    float firstSegmentSplit,
    float2 physicalCellSpacing,
    out float frontToShoulderT)
{
    float2 selectedStart;
    float2 selectedEnd;
    float pathStart;
    if (localPosition.y <= point3.y)
    {
        selectedStart = point2;
        selectedEnd = point3;
        pathStart = 0.0;
    }
    else
    {
        selectedStart = point3;
        selectedEnd = point4;
        pathStart = firstSegmentSplit;
    }

    float selectedSegmentT;
    float selectedDistanceSquared = FoamDistanceSquaredToSegment(
        localPosition,
        selectedStart,
        selectedEnd,
        selectedSegmentT);
    float pathSpan = pathStart <= 0.0
        ? firstSegmentSplit
        : 1.0 - firstSegmentSplit;
    frontToShoulderT = pathStart + selectedSegmentT * pathSpan;
    return FoamResolveObjectProfileRibbonShape(
        localPosition,
        selectedStart,
        selectedEnd,
        selectedDistanceSquared,
        physicalCellSpacing);
}

float FoamResolveObjectWakeArmShape(
    float2 localPosition,
    float2 shoulder,
    float armLength,
    float2 physicalCellSpacing,
    out float shoulderToTipT)
{
    float resolvedLength = max(0.0, armLength);
    if (resolvedLength <= 0.001)
    {
        shoulderToTipT = 0.0;
        return 0.0;
    }

    float2 armTip = shoulder + float2(resolvedLength, 0.0);
    float distanceToArm = FoamDistanceToSegment(
        localPosition,
        shoulder,
        armTip,
        shoulderToTipT);
    // One strong cross-river row with at most one feathered continuity row.
    // This is a real distance-to-segment ribbon, not Presence attenuation used
    // to imitate fractional-cell geometry.
    float requestedWidth = max(
        0.0015,
        physicalCellSpacing.y * 0.34);
    float requestedFeather = max(
        0.002,
        physicalCellSpacing.y * 0.20);
    // Keep opposite arms separated at the downstream centre even when a very
    // small object is represented on a coarse lateral Foam grid. Normal-sized
    // objects retain the accepted one-strong-row plus one-feather-row width.
    float maximumOuterWidth = max(
        0.003,
        abs(shoulder.y) * 0.90);
    float rasterWidth = min(
        requestedWidth,
        maximumOuterWidth * 0.63);
    float rasterFeather = min(
        requestedFeather,
        max(0.001, maximumOuterWidth - rasterWidth));
    return 1.0 - smoothstep(
        rasterWidth,
        rasterWidth + rasterFeather,
        distanceToArm);
}

float FoamResolveAccumulatedSweepBuild(
    float sweepCoordinate,
    float progress,
    float materialStepProgress,
    float feather01)
{
    float effectiveProgress = max(
        saturate(progress),
        saturate(materialStepProgress));
    float threshold = effectiveProgress * (1.0 + feather01 * 2.0);
    return 1.0 - smoothstep(
        threshold - feather01,
        threshold + feather01,
        sweepCoordinate);
}

float FoamResolveSameOrderSweepRelease(
    float sweepCoordinate,
    float progress,
    float feather01)
{
    float threshold =
        saturate(progress) * (1.0 + feather01 * 2.0) - feather01;
    return smoothstep(
        threshold - feather01,
        threshold + feather01,
        sweepCoordinate);
}

float FoamResolveReverseOrderSweepRelease(
    float sweepCoordinate,
    float progress,
    float feather01)
{
    float threshold =
        (1.0 - saturate(progress)) * (1.0 + feather01 * 2.0) -
        feather01;
    return 1.0 - smoothstep(
        threshold - feather01,
        threshold + feather01,
        sweepCoordinate);
}

float FoamResolveObjectRibbonPhaseMask(
    float pathT,
    float progress,
    float materialStepProgress,
    float pathLength,
    float2 physicalCellSpacing,
    float phase,
    bool reverseRelease)
{
    float phaseFeather01 = clamp(
        max(physicalCellSpacing.x, physicalCellSpacing.y) /
        max(0.001, pathLength),
        0.025,
        0.18);
    float buildMask = FoamResolveAccumulatedSweepBuild(
        pathT,
        progress,
        materialStepProgress,
        phaseFeather01);
    float releaseMask = reverseRelease
        ? FoamResolveReverseOrderSweepRelease(
            pathT,
            progress,
            phaseFeather01)
        : FoamResolveSameOrderSweepRelease(
            pathT,
            progress,
            phaseFeather01);
    float buildPhase = 1.0 - step(0.5, phase);
    float holdPhase = step(0.5, phase) * (1.0 - step(1.5, phase));
    float releasePhase = step(1.5, phase);
    return saturate(
        buildMask * buildPhase +
        holdPhase +
        releaseMask * releasePhase);
}

float FoamEvaluateObjectContactArcSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float2 localPosition = float2(
        globalDistance - sourceEvent.distance.z,
        lateralMetres - sourceEvent.objectData.x);
    float2 point0;
    float2 point1;
    float2 point2;
    float2 point3;
    float2 point4;
    float frontSplit;
    float negativeFirstSegmentSplit;
    float positiveFirstSegmentSplit;
    FoamUnpackObjectContactProfile(
        sourceEvent,
        point0,
        point1,
        point2,
        point3,
        point4,
        frontSplit,
        negativeFirstSegmentSplit,
        positiveFirstSegmentSplit);

    float wakeArmLength = max(0.05, sourceEvent.shore.y);
    float totalPathLength = max(0.001, sourceEvent.kinematics.z);
    float frontProfileLength = max(
        0.001,
        totalPathLength - wakeArmLength - wakeArmLength);
    float frontT;
    float frontShape = FoamResolveObjectFrontProfileShape(
        localPosition,
        point0,
        point1,
        point2,
        point3,
        point4,
        frontSplit,
        negativeFirstSegmentSplit,
        positiveFirstSegmentSplit,
        physicalCellSpacing,
        frontT);

    float negativeArmT;
    float positiveArmT;
    float negativeArmShape = FoamResolveObjectWakeArmShape(
        localPosition,
        point0,
        wakeArmLength,
        physicalCellSpacing,
        negativeArmT);
    float positiveArmShape = FoamResolveObjectWakeArmShape(
        localPosition,
        point4,
        wakeArmLength,
        physicalCellSpacing,
        positiveArmT);

    float negativePathT = saturate(
        wakeArmLength * (1.0 - negativeArmT) /
        totalPathLength);
    float frontPathT = saturate(
        (wakeArmLength + frontT * frontProfileLength) /
        totalPathLength);
    float positivePathT = saturate(
        (wakeArmLength + frontProfileLength +
         positiveArmT * wakeArmLength) /
        totalPathLength);

    bool reverseSweep = FoamHash11(sourceEvent.header.w + 73.17) < 0.5;
    if (reverseSweep)
    {
        negativePathT = 1.0 - negativePathT;
        frontPathT = 1.0 - frontPathT;
        positivePathT = 1.0 - positivePathT;
    }

    float progress = saturate(sourceEvent.header.z);
    float materialStepProgress = clamp(sourceEvent.shore.z, 0.0001, 1.0);
    float phase = sourceEvent.header.y;
    float negativePhase = FoamResolveObjectRibbonPhaseMask(
        negativePathT,
        progress,
        materialStepProgress,
        totalPathLength,
        physicalCellSpacing,
        phase,
        false);
    float frontPhase = FoamResolveObjectRibbonPhaseMask(
        frontPathT,
        progress,
        materialStepProgress,
        totalPathLength,
        physicalCellSpacing,
        phase,
        false);
    float positivePhase = FoamResolveObjectRibbonPhaseMask(
        positivePathT,
        progress,
        materialStepProgress,
        totalPathLength,
        physicalCellSpacing,
        phase,
        false);

    float shape = max(
        frontShape * frontPhase,
        max(
            negativeArmShape * negativePhase,
            positiveArmShape * positivePhase));
    amountMultiplier = 1.0;
    return saturate(shape);
}

float FoamEvaluateObjectContactSemiArcSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float2 localPosition = float2(
        globalDistance - sourceEvent.distance.z,
        lateralMetres - sourceEvent.objectData.x);
    float2 point0;
    float2 point1;
    float2 point2;
    float2 point3;
    float2 point4;
    float frontSplit;
    float negativeFirstSegmentSplit;
    float positiveFirstSegmentSplit;
    FoamUnpackObjectContactProfile(
        sourceEvent,
        point0,
        point1,
        point2,
        point3,
        point4,
        frontSplit,
        negativeFirstSegmentSplit,
        positiveFirstSegmentSplit);

    float armLength = max(0.05, sourceEvent.shore.y);
    float totalPathLength = max(0.001, sourceEvent.kinematics.z);
    float selectedFrontLength = max(
        0.001,
        totalPathLength - armLength);
    bool selectedPositive = sourceEvent.variation.w >= 0.0;
    float armT;
    float armShape;
    float frontShape;
    float frontHalfT;
    if (selectedPositive)
    {
        armShape = FoamResolveObjectWakeArmShape(
            localPosition,
            point4,
            armLength,
            physicalCellSpacing,
            armT);
        float frontToShoulderT;
        frontShape = FoamResolveObjectPositiveHalfProfileShape(
            localPosition,
            point2,
            point3,
            point4,
            positiveFirstSegmentSplit,
            physicalCellSpacing,
            frontToShoulderT);
        frontHalfT = 1.0 - frontToShoulderT;
    }
    else
    {
        armShape = FoamResolveObjectWakeArmShape(
            localPosition,
            point0,
            armLength,
            physicalCellSpacing,
            armT);
        frontShape = FoamResolveObjectNegativeHalfProfileShape(
            localPosition,
            point0,
            point1,
            point2,
            negativeFirstSegmentSplit,
            physicalCellSpacing,
            frontHalfT);
    }

    // Semi-Arcs must retain physical-front coverage throughout their active
    // lifecycle. Build begins at the front point and advances through the
    // selected face half toward the shoulder and downstream arm tip. Reverse
    // release removes that arm tip first and preserves the front until last.
    float frontPathT = saturate(
        (1.0 - frontHalfT) * selectedFrontLength /
        totalPathLength);
    float armPathT = saturate(
        (selectedFrontLength + armT * armLength) /
        totalPathLength);
    float progress = saturate(sourceEvent.header.z);
    float materialStepProgress = clamp(sourceEvent.shore.z, 0.0001, 1.0);
    float phase = sourceEvent.header.y;
    float armPhase = FoamResolveObjectRibbonPhaseMask(
        armPathT,
        progress,
        materialStepProgress,
        totalPathLength,
        physicalCellSpacing,
        phase,
        true);
    float frontPhase = FoamResolveObjectRibbonPhaseMask(
        frontPathT,
        progress,
        materialStepProgress,
        totalPathLength,
        physicalCellSpacing,
        phase,
        true);

    float shape = max(
        armShape * armPhase,
        frontShape * frontPhase);
    amountMultiplier = 1.0;
    return saturate(shape);
}

float FoamEvaluateObjectContactFleckSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float2 physicalCellSpacing,
    int2 coordinate,
    out float amountMultiplier)
{
    float flowDirection = sourceEvent.distance.w >= 0.0 ? 1.0 : -1.0;
    float localAlong = (globalDistance - sourceEvent.distance.z) * flowDirection;
    float localAcross = lateralMetres - sourceEvent.objectData.x;
    float alongHalf = max(0.04, sourceEvent.objectData.y);
    float acrossHalf = max(0.04, sourceEvent.objectData.z);
    float contactOffset = max(0.0, sourceEvent.objectData.w);
    float width = max(0.006, sourceEvent.shore.y);
    float feather = max(
        max(0.005, sourceEvent.shore.w * 0.55),
        max(physicalCellSpacing.x, physicalCellSpacing.y) * 0.30);

    float4 contact = FoamLoadObjectContactField(coordinate);
    float contactConfidence = saturate(contact.r);
    if (contactConfidence <= 0.001)
    {
        amountMultiplier = 0.0;
        return 0.0;
    }

    float2 normal = contact.gb;
    float normalLength = length(normal);
    if (normalLength <= 0.001)
    {
        normal = float2(-flowDirection, 0.0);
    }
    else
    {
        normal /= normalLength;
    }

    float2 tangent = float2(-normal.y, normal.x);
    float2 local = float2(localAlong, localAcross);
    float tangentDistance = dot(local, tangent);
    float normalDistance = dot(local, normal);
    float seed = sourceEvent.header.w;
    float totalLength = max(
        0.001,
        abs(sourceEvent.distance.y - sourceEvent.distance.x));
    float tangentOffset = (FoamHash11(seed + 37.0) - 0.5) *
        max(width * 2.0, totalLength * 0.65);
    float halfLength = max(width * 1.35, totalLength * 0.25);
    float tangentCapsule = max(abs(tangentDistance - tangentOffset) - halfLength, 0.0);
    float normalBandDistance = abs(normalDistance - contactOffset * 0.25);
    float distanceToFleck = length(float2(tangentCapsule, normalBandDistance));
    float stroke = 1.0 - smoothstep(
        width,
        width + feather,
        distanceToFleck);
    float progress = saturate(sourceEvent.header.z);
    float revealMask = smoothstep(0.0, 0.18, progress);
    float coarseAlongGate = 1.0 - smoothstep(
        alongHalf + contactOffset + totalLength,
        alongHalf + contactOffset + totalLength + feather * 2.0,
        abs(localAlong));
    float coarseAcrossGate = 1.0 - smoothstep(
        acrossHalf + contactOffset + width * 4.0 + feather,
        acrossHalf + contactOffset + width * 4.0 + feather * 3.0,
        abs(localAcross));
    float breakup = FoamSourceEventBreakup(
        float2(tangentDistance, normalDistance),
        sourceEvent.variation.x,
        sourceEvent.variation.y,
        sourceEvent.variation.z,
        physicalCellSpacing);
    float shape = saturate(stroke * revealMask * contactConfidence *
        contact.a * coarseAlongGate * coarseAcrossGate *
        lerp(1.0, breakup, 0.46));

    amountMultiplier = lerp(0.82, 1.0, saturate(contact.a));
    return shape;
}


float FoamEvaluateFreeWaterLaceConnectorSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float flowDirection = sourceEvent.distance.w >= 0.0 ? 1.0 : -1.0;
    float progress = saturate(sourceEvent.header.z);
    float halfLength = max(0.05, sourceEvent.objectData.y);
    float baseWidth = max(0.008, sourceEvent.shore.y);
    float feather = max(
        max(0.006, sourceEvent.shore.w * 0.58),
        max(physicalCellSpacing.x, physicalCellSpacing.y) * 0.36);
    float pathLength = max(0.001, halfLength * 2.0);
    float2 p = float2(
        (globalDistance - sourceEvent.distance.z) * flowDirection,
        lateralMetres - sourceEvent.objectData.x);

    float trailFraction = saturate(sourceEvent.kinematics.y / pathLength);
    float headT = progress;
    float tailT = max(0.0, headT - trailFraction);
    float sampleSpan = max(0.001, headT - tailT);
    float minDistance = 100000.0;
    float nearestT = 0.0;

    [unroll]
    for (int sampleIndex = 0; sampleIndex < 5; sampleIndex++)
    {
        float sampleU = (float)sampleIndex / 4.0;
        float t = tailT + sampleSpan * sampleU;
        float along = lerp(-halfLength, halfLength, t);
        float bend =
            sourceEvent.variation.w * baseWidth * 4.0 * sin(t * 3.14159265) +
            baseWidth * 1.4 * sin(t * 6.2831853 + sourceEvent.header.w);
        float d = distance(p, float2(along, bend));
        if (d < minDistance)
        {
            minDistance = d;
            nearestT = t;
        }
    }

    float widthNoise = EvaluateFoamSourceFillField(
        float2(nearestT * pathLength, 0.0),
        sourceEvent.variation.x + 91.0,
        max(0.20, sourceEvent.material.w));
    float localWidth = baseWidth * lerp(0.55, 1.45, widthNoise);
    float stroke = 1.0 - smoothstep(
        localWidth,
        localWidth + feather,
        minDistance);

    float endTaper = smoothstep(0.00, 0.12, nearestT) *
        (1.0 - smoothstep(0.88, 1.00, nearestT));
    float breakup = FoamSourceEventBreakup(
        p,
        sourceEvent.variation.x,
        sourceEvent.variation.y,
        sourceEvent.variation.z,
        physicalCellSpacing);
    float gapNoise = EvaluateFoamSourceFillField(
        float2(nearestT * 6.0, p.y),
        sourceEvent.variation.x + 173.0,
        max(0.25, sourceEvent.variation.y * 1.4));
    float gapMask = smoothstep(0.18, 0.68, gapNoise);

    float shape = saturate(
        stroke * max(0.25, endTaper) *
        lerp(1.0, breakup * gapMask, 0.55));
    amountMultiplier = 0.92;
    return shape;
}

float FoamEvaluateFreeWaterCrossLaceConnectorSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float progress = saturate(sourceEvent.header.z);
    float flowDirection = sourceEvent.distance.w >= 0.0 ? 1.0 : -1.0;
    float2 p = float2(
        (globalDistance - sourceEvent.distance.z) * flowDirection,
        lateralMetres - sourceEvent.objectData.x);

    float halfLength = max(0.05, sourceEvent.objectData.y);
    float requestedWidth = max(0.0015, sourceEvent.objectData.z);
    float cellSize = max(physicalCellSpacing.x, physicalCellSpacing.y);
    float rasterWidth = max(requestedWidth, cellSize * 0.18);
    float subCellCoverage = saturate(requestedWidth / max(0.0001, rasterWidth));
    float feather = max(
        max(0.002, sourceEvent.shore.w * 0.20),
        cellSize * 0.16);
    float lateralDirectionSign = sourceEvent.objectData.w >= 0.0 ? 1.0 : -1.0;
    float pathLength = max(0.001, halfLength * 2.0);
    float trailFraction = saturate(sourceEvent.kinematics.y / pathLength);
    float headT = progress;
    float tailT = max(0.0, headT - trailFraction);
    float sampleSpan = max(0.001, headT - tailT);

    float minDistance = 100000.0;
    float nearestT = 0.0;
    float2 previousPoint = float2(0.0, 0.0);
    float previousT = tailT;

    [unroll]
    for (int sampleIndex = 0; sampleIndex < 5; sampleIndex++)
    {
        float sampleU = (float)sampleIndex / 4.0;
        float t = tailT + sampleSpan * sampleU;

        float lateralPath = lerp(-halfLength, halfLength, t) * lateralDirectionSign;
        float flowBend =
            sourceEvent.variation.w * rasterWidth * 3.2 * sin(t * 3.14159265) +
            rasterWidth * 1.2 * sin(t * 6.2831853 + sourceEvent.header.w);
        float2 currentPoint = float2(flowBend, lateralPath);

        if (sampleIndex > 0)
        {
            float segmentT;
            float d = FoamDistanceToSegment(p, previousPoint, currentPoint, segmentT);
            if (d < minDistance)
            {
                minDistance = d;
                nearestT = lerp(previousT, t, segmentT);
            }
        }

        previousPoint = currentPoint;
        previousT = t;
    }

    float widthNoise = EvaluateFoamSourceFillField(
        float2(nearestT * pathLength, p.x),
        sourceEvent.variation.x + 301.0,
        max(0.20, sourceEvent.material.w));
    float localWidth = rasterWidth * lerp(0.75, 1.18, widthNoise);
    float stroke = 1.0 - smoothstep(
        localWidth,
        localWidth + feather,
        minDistance);

    float endTaper = smoothstep(0.00, 0.12, nearestT) *
        (1.0 - smoothstep(0.88, 1.00, nearestT));
    float breakup = FoamSourceEventBreakup(
        p,
        sourceEvent.variation.x,
        sourceEvent.variation.y,
        sourceEvent.variation.z,
        physicalCellSpacing);
    float gapNoise = EvaluateFoamSourceFillField(
        float2(nearestT * 6.0, p.x),
        sourceEvent.variation.x + 389.0,
        max(0.25, sourceEvent.variation.y * 1.4));
    float gapMask = smoothstep(0.16, 0.66, gapNoise);

    float shape = saturate(
        stroke * subCellCoverage * max(0.25, endTaper) *
        lerp(1.0, breakup * gapMask, 0.48));
    amountMultiplier = 0.94;
    return shape;
}

float FoamEvaluateFreeWaterTornFragmentSource(
    FoamSourceEventData sourceEvent,
    float globalDistance,
    float lateralMetres,
    float2 physicalCellSpacing,
    out float amountMultiplier)
{
    float flowDirection = sourceEvent.distance.w >= 0.0 ? 1.0 : -1.0;
    float progress = saturate(sourceEvent.header.z);
    float halfLength = max(0.04, sourceEvent.objectData.y);
    float halfWidth = max(0.015, sourceEvent.objectData.z);
    float feather = max(
        max(0.006, sourceEvent.shore.w * 0.62),
        max(physicalCellSpacing.x, physicalCellSpacing.y) * 0.34);
    float2 p = float2(
        (globalDistance - sourceEvent.distance.z) * flowDirection,
        lateralMetres - sourceEvent.objectData.x);

    float angle = sourceEvent.variation.w * 0.75;
    float ca = cos(angle);
    float sa = sin(angle);
    float2 q = float2(
        p.x * ca + p.y * sa,
       -p.x * sa + p.y * ca);

    float skew = FoamHash11(sourceEvent.header.w + 51.0) * 1.2 - 0.6;
    q.y += skew * (q.x / max(0.001, halfLength)) * halfWidth * 0.45;

    float normalizer = max(0.001, max(halfLength, halfWidth));
    float coreD = length(float2(
        q.x / max(0.001, halfLength),
        q.y / max(0.001, halfWidth)));
    float core = 1.0 - smoothstep(
        1.0,
        1.0 + feather / normalizer,
        coreD);

    float lobeShift = halfLength * lerp(
        -0.35,
        0.35,
        FoamHash11(sourceEvent.header.w + 73.0));
    float lobeScale = lerp(
        0.35,
        0.65,
        FoamHash11(sourceEvent.header.w + 79.0));
    float lobeD = length(float2(
        (q.x - lobeShift) / max(0.001, halfLength * lobeScale),
        (q.y + halfWidth * 0.25) / max(0.001, halfWidth * lobeScale)));
    float lobe = 0.70 * (1.0 - smoothstep(
        1.0,
        1.0 + feather / normalizer,
        lobeD));
    float fragmentBase = max(core, lobe);

    float sweepCoord = q.x / max(0.001, halfLength);
    float head = lerp(-1.20, 1.20, progress);
    float trail = 0.22;
    float reveal = 1.0 - smoothstep(
        head,
        head + trail,
        sweepCoord);

    float breakup = FoamSourceEventBreakup(
        q,
        sourceEvent.variation.x,
        sourceEvent.variation.y,
        sourceEvent.variation.z,
        physicalCellSpacing);
    float bite = EvaluateFoamSourceFillField(
        q,
        sourceEvent.variation.x + 219.0,
        max(0.12, sourceEvent.variation.y * 0.8));
    float biteMask = lerp(
        1.0,
        smoothstep(0.18, 0.72, bite),
        0.65);

    float shape = saturate(fragmentBase * reveal * breakup * biteMask);
    amountMultiplier = 0.88;
    return shape;
}

struct FoamAutomaticSourceRasterSample
{
    float4 packedState;
    float injectedPresence;
    float sourceType;
    float clearState;
};

FoamAutomaticSourceRasterSample EvaluateFoamAutomaticSourceRasterSample(
    int2 coordinate)
{
    FoamAutomaticSourceRasterSample result;
    result.packedState = 0.0.xxxx;
    result.injectedPresence = 0.0;
    result.sourceType = 0.0;
    result.clearState = 0.0;

    int x = coordinate.x;
    int y = coordinate.y;
    if (!IsFoamGridColumnInsideDomain(x))
    {
        result.clearState = 1.0;
        return result;
    }

    float coverage = LoadBoundaryCoverage(coordinate);
    float obstacleFootprint = saturate(
        _FoamObstacleExclusionRead.Load(int3(coordinate, 0)));
    float validFluid = coverage * (1.0 - obstacleFootprint);
    if (validFluid <= 0.001)
    {
        result.clearState = 1.0;
        return result;
    }

    FoamSourceEventData sourceEvent =
        _FoamSourceEvents[max(0, _FoamSourceEventIndex)];
    float sourceType = sourceEvent.header.x;
    result.sourceType = sourceType;
    if (sourceType < 0.5 || sourceType >= 8.5)
    {
        return result;
    }

    FoamMetricRow metric = _FoamMetricRows[x];
    float lateralMetres = FoamLateralMetresAtTexel(y, metric);
    float globalDistance = _FoamGlobalStart +
        FoamGridLocalDistanceAtTexel(x);
    float2 physicalPosition = float2(globalDistance, lateralMetres);
    float2 physicalCellSpacing = float2(
        max(0.01, metric.widthsAndSpacing.z),
        max(0.01, metric.widthsAndSpacing.w));
    float2 shoreEdges = _FoamCurrentShoreEdgesRead.Load(int3(x, 0, 0));
    float shoreMetres = sourceEvent.header.y < 0.0
        ? shoreEdges.x
        : shoreEdges.y;
    float inwardMetres = sourceEvent.header.y < 0.0
        ? lateralMetres - shoreMetres
        : shoreMetres - lateralMetres;
    bool shoreSource = sourceType < 2.5;
    if (shoreSource &&
        inwardMetres < -max(sourceEvent.shore.w, physicalCellSpacing.y))
    {
        return result;
    }

    float currentAmountMultiplier = 1.0;
    float currentShape = 0.0;
    if (sourceType < 1.5)
    {
        currentShape = FoamEvaluateShoreRibbonSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            shoreMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }
    else if (sourceType < 2.5)
    {
        currentShape = FoamEvaluateInwardWashSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            shoreMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }
    else if (sourceType < 3.5)
    {
        currentShape = FoamEvaluateObjectContactArcSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }
    else if (sourceType < 4.5)
    {
        currentShape = FoamEvaluateObjectContactFleckSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            physicalCellSpacing,
            coordinate,
            currentAmountMultiplier);
    }
    else if (sourceType < 5.5)
    {
        currentShape = FoamEvaluateObjectContactSemiArcSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }
    else if (sourceType < 6.5)
    {
        currentShape = FoamEvaluateFreeWaterLaceConnectorSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }
    else if (sourceType < 7.5)
    {
        currentShape = FoamEvaluateFreeWaterTornFragmentSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }
    else
    {
        currentShape = FoamEvaluateFreeWaterCrossLaceConnectorSource(
            sourceEvent,
            globalDistance,
            lateralMetres,
            physicalCellSpacing,
            currentAmountMultiplier);
    }

    float currentContribution = saturate(currentShape) *
        max(0.0, currentAmountMultiplier);
    bool persistentObjectEmitter =
        (sourceType > 2.5 && sourceType < 3.5) ||
        (sourceType > 4.5 && sourceType < 5.5);
    if (!persistentObjectEmitter)
    {
        FoamSourceEventData previousSourceEvent = sourceEvent;
        previousSourceEvent.header.y = sourceEvent.deposit.x;
        previousSourceEvent.header.z = sourceEvent.deposit.y;
        float previousContribution = 0.0;
        if (sourceEvent.deposit.z > 0.5)
        {
            float previousAmountMultiplier = 1.0;
            float previousShape = 0.0;
            if (sourceType < 1.5)
            {
                previousShape = FoamEvaluateShoreRibbonSource(
                    previousSourceEvent,
                    globalDistance,
                    lateralMetres,
                    shoreMetres,
                    physicalCellSpacing,
                    previousAmountMultiplier);
            }
            else if (sourceType < 2.5)
            {
                previousShape = FoamEvaluateInwardWashSource(
                    previousSourceEvent,
                    globalDistance,
                    lateralMetres,
                    shoreMetres,
                    physicalCellSpacing,
                    previousAmountMultiplier);
            }
            else if (sourceType < 4.5)
            {
                previousShape = FoamEvaluateObjectContactFleckSource(
                    previousSourceEvent,
                    globalDistance,
                    lateralMetres,
                    physicalCellSpacing,
                    coordinate,
                    previousAmountMultiplier);
            }
            else if (sourceType < 6.5)
            {
                previousShape = FoamEvaluateFreeWaterLaceConnectorSource(
                    previousSourceEvent,
                    globalDistance,
                    lateralMetres,
                    physicalCellSpacing,
                    previousAmountMultiplier);
            }
            else if (sourceType < 7.5)
            {
                previousShape = FoamEvaluateFreeWaterTornFragmentSource(
                    previousSourceEvent,
                    globalDistance,
                    lateralMetres,
                    physicalCellSpacing,
                    previousAmountMultiplier);
            }
            else
            {
                previousShape = FoamEvaluateFreeWaterCrossLaceConnectorSource(
                    previousSourceEvent,
                    globalDistance,
                    lateralMetres,
                    physicalCellSpacing,
                    previousAmountMultiplier);
            }

            previousContribution = saturate(previousShape) *
                max(0.0, previousAmountMultiplier);
        }

        float newlyRevealedContribution = sourceEvent.deposit.z > 0.5
            ? max(0.0, currentContribution - previousContribution)
            : currentContribution;
        if (newlyRevealedContribution <= FoamMaterialStateEpsilon)
        {
            return result;
        }
    }
    else if (currentContribution <= FoamMaterialStateEpsilon)
    {
        return result;
    }

    // Nonpersistent sources use current-minus-previous only as deposition
    // permission. Persistent Object Arc/Semi-Arc sources rasterize their current
    // phase-shaped emitter every material tick. Both paths preserve the current
    // authored contribution as the absolute birth target expected by the merge.
    float birthContribution = currentContribution;

    bool objectRibbonSource =
        (sourceType > 2.5 && sourceType < 3.5) ||
        (sourceType > 4.5 && sourceType < 5.5);
    float sourceFill = 1.0;
    if (!objectRibbonSource)
    {
        float sourceFillBlend = saturate(sourceEvent.kinematics.w);
        sourceFill = lerp(
            1.0,
            EvaluateFoamSourceFillCoverage(
                physicalPosition,
                sourceEvent.material.x,
                sourceEvent.variation.x,
                sourceEvent.material.w,
                physicalCellSpacing),
            sourceFillBlend);
    }
    float injectedPresence = saturate(
        birthContribution * sourceFill * sourceEvent.material.x * validFluid);
    if (injectedPresence <= FoamMaterialStateEpsilon)
    {
        return result;
    }

    FoamMaterialState sourceState;
    sourceState.presence = injectedPresence;
    sourceState.remainingLife = saturate(sourceEvent.material.y);
    sourceState.materialPattern = EvaluateFoamMaterialPattern(
        physicalPosition,
        sourceEvent.material.z,
        sourceEvent.material.w,
        physicalCellSpacing);
    result.packedState = FoamEncodeMaterialState(sourceState);
    result.injectedPresence = injectedPresence;
    return result;
}

void ApplyFoamAutomaticSourceRasterSample(
    int2 coordinate,
    FoamAutomaticSourceRasterSample sample)
{
    if (sample.clearState > 0.5)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    if (sample.injectedPresence <= FoamMaterialStateEpsilon)
    {
        return;
    }

    _FoamStateWrite[coordinate] = FoamMergeBornPresence(
        _FoamStateWrite[coordinate],
        sample.packedState);
}

void WriteFoamAutomaticSourceDebug(
    int2 coordinate,
    FoamAutomaticSourceRasterSample sample)
{
    if (sample.injectedPresence <= FoamMaterialStateEpsilon)
    {
        return;
    }

    float3 categoryMask = sample.sourceType < 2.5
        ? float3(1.0, 0.0, 0.0)
        : (sample.sourceType < 5.5
            ? float3(0.0, 1.0, 0.0)
            : float3(0.0, 0.0, 1.0));
    float4 debugState = _FoamBirthDebugWrite[coordinate];
    uint ignored;
    bool alreadyOccupied =
        max(debugState.r, max(debugState.g, debugState.b)) >
        FoamMaterialStateEpsilon;
    if (!alreadyOccupied)
    {
        InterlockedAdd(_FoamBirthDebugCounters[0], 1, ignored);
    }

    debugState.rgb = max(
        debugState.rgb,
        categoryMask * sample.injectedPresence);
    debugState.a = max(
        debugState.a,
        alreadyOccupied ? 1.0 : 0.0);
    _FoamBirthDebugWrite[coordinate] = saturate(debugState);
}

[numthreads(8, 8, 1)]
void RasterizeFoamSourceEvent(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamRangeCountY)
    {
        return;
    }

    int2 coordinate = int2(
        _FoamRangeStart + (int)dispatchId.x,
        _FoamRangeStartY + (int)dispatchId.y);
    if (coordinate.x < 0 || coordinate.x >= _FoamDimensions.x ||
        coordinate.y < 0 || coordinate.y >= _FoamDimensions.y)
    {
        return;
    }

    FoamAutomaticSourceRasterSample sample =
        EvaluateFoamAutomaticSourceRasterSample(coordinate);
    ApplyFoamAutomaticSourceRasterSample(coordinate, sample);
}

[numthreads(8, 8, 1)]
void RasterizeFoamSourceEventDebug(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamRangeCountY)
    {
        return;
    }

    int2 coordinate = int2(
        _FoamRangeStart + (int)dispatchId.x,
        _FoamRangeStartY + (int)dispatchId.y);
    if (coordinate.x < 0 || coordinate.x >= _FoamDimensions.x ||
        coordinate.y < 0 || coordinate.y >= _FoamDimensions.y)
    {
        return;
    }

    FoamAutomaticSourceRasterSample sample =
        EvaluateFoamAutomaticSourceRasterSample(coordinate);
    ApplyFoamAutomaticSourceRasterSample(coordinate, sample);
    WriteFoamAutomaticSourceDebug(coordinate, sample);
}

bool IsInsideLifeProbeRect(int2 coordinate, int4 rect)
{
    return coordinate.x >= rect.x && coordinate.x < rect.z &&
        coordinate.y >= rect.y && coordinate.y < rect.w;
}

[numthreads(8, 8, 1)]
void WriteIsolatedLifeProbe(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    _FoamStateWrite[coordinate] = 0.0.xxxx;

    if (!IsFoamColumnInsideDomain(x))
    {
        return;
    }

    float remainingLife = 0.0;
    if (IsInsideLifeProbeRect(coordinate, _FoamLifeProbeRectA))
    {
        remainingLife = 1.00;
    }
    else if (IsInsideLifeProbeRect(coordinate, _FoamLifeProbeRectB))
    {
        remainingLife = 0.66;
    }
    else if (IsInsideLifeProbeRect(coordinate, _FoamLifeProbeRectC))
    {
        remainingLife = 0.33;
    }

    if (remainingLife <= FoamMaterialStateEpsilon)
    {
        return;
    }

    float validFluid = LoadBoundaryCoverage(coordinate);
    if (validFluid <= FoamMaterialStateEpsilon)
    {
        return;
    }

    FoamMaterialState sourceState;
    sourceState.presence = saturate(validFluid);
    sourceState.remainingLife = remainingLife;
    sourceState.materialPattern = 1.0;
    _FoamStateWrite[coordinate] = FoamEncodeMaterialState(sourceState);
}

[numthreads(8, 8, 1)]
void ClearAutomaticBirthDebugAll(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    _FoamBirthDebugWrite[int2(x, y)] = 0.0.xxxx;
    if (dispatchId.x == 0 && dispatchId.y == 0)
    {
        _FoamBirthDebugCounters[0] = 0;
    }
}


[numthreads(64, 1, 1)]
void BuildCurrentShoreEdges(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x)
    {
        return;
    }

    int outputX = (int)dispatchId.x;
    float u = FoamTexelCentreUV1D(
        outputX,
        _FoamTopologyDimensions.x);
    if (!IsFoamGridUInsideDomain(u))
    {
        _FoamCurrentShoreEdgesWrite[int2(outputX, 0)] = float2(0.0, 0.0);
        return;
    }

    int metricX = FoamUVToContainingTexel(u, _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    if (metric.topologyData.w <= 0.0)
    {
        _FoamCurrentShoreEdgesWrite[int2(outputX, 0)] = float2(0.0, 0.0);
        return;
    }

    float globalDistance = _FoamGlobalStart +
        FoamGridLocalDistanceAtUV(u);
    float liquidFactor = 1.0 - saturate(_FoamFreezeAmount);
    float leftVisible = RiverWaterResolveCurrentVisibleShoreHalfWidth(
        globalDistance,
        -1.0,
        metric.shoreData.x,
        metric.widthsAndSpacing.x,
        _FoamTime,
        _FoamMotionFlowSpeed,
        _FoamMotionWaveHeight,
        _FoamMotionWaveLength,
        _FoamMotionWaveSteepness,
        _FoamMotionTurbulence,
        _FoamShoreMotion,
        _FoamShoreMotionWidth,
        _FoamShoreWaveHeightScale,
        _FoamShoreWaveLengthScale,
        _FoamShoreWaveReach,
        _FoamShoreWaveTransitionLength,
        _FoamShoreWaveSizeVariation,
        _FoamShoreWaveSideAsymmetry,
        _FoamShoreWaveProfileVariation,
        _FoamShoreBankCover,
        liquidFactor,
        _FoamSeed);
    float rightVisible = RiverWaterResolveCurrentVisibleShoreHalfWidth(
        globalDistance,
        1.0,
        metric.shoreData.y,
        metric.widthsAndSpacing.y,
        _FoamTime,
        _FoamMotionFlowSpeed,
        _FoamMotionWaveHeight,
        _FoamMotionWaveLength,
        _FoamMotionWaveSteepness,
        _FoamMotionTurbulence,
        _FoamShoreMotion,
        _FoamShoreMotionWidth,
        _FoamShoreWaveHeightScale,
        _FoamShoreWaveLengthScale,
        _FoamShoreWaveReach,
        _FoamShoreWaveTransitionLength,
        _FoamShoreWaveSizeVariation,
        _FoamShoreWaveSideAsymmetry,
        _FoamShoreWaveProfileVariation,
        _FoamShoreBankCover,
        liquidFactor,
        _FoamSeed);

    _FoamCurrentShoreEdgesWrite[int2(outputX, 0)] = float2(
        -leftVisible,
        rightVisible);
}

[numthreads(8, 8, 1)]
void ClearObstacleExclusion(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamDimensions.x ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    _FoamObstacleExclusionWrite[int2(dispatchId.xy)] = 0.0;
}

[numthreads(64, 1, 1)]
void UpdateObstacleExclusion(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamObstacleCellCount)
    {
        return;
    }

    FoamObstacleIntervalCell cell =
        _FoamObstacleCells[dispatchId.x];
    int2 coordinate = int2(
        (int)round(cell.coordinateAndOffset.x),
        (int)round(cell.coordinateAndOffset.y));
    int intervalOffset = (int)round(cell.coordinateAndOffset.z);
    if (coordinate.x < 0 || coordinate.x >= _FoamDimensions.x ||
        coordinate.y < 0 || coordinate.y >= _FoamDimensions.y ||
        intervalOffset < 0)
    {
        return;
    }

    [unroll]
    for (int sampleY = 0; sampleY < 3; sampleY++)
    {
        [unroll]
        for (int sampleX = 0; sampleX < 3; sampleX++)
        {
            int sampleIndex = sampleY * 3 + sampleX;
            if (!IsObstacleIntervalSampleInside(
                    intervalOffset,
                    sampleIndex))
            {
                return;
            }
        }
    }

    _FoamObstacleExclusionWrite[coordinate] = 1.0;
}

float FoamLoadObstacleClamped(int2 coordinate)
{
    int2 clamped = clamp(
        coordinate,
        int2(0, 0),
        max(int2(0, 0), _FoamDimensions - int2(1, 1)));
    return saturate(_FoamObstacleExclusionRead.Load(int3(clamped, 0)));
}

[numthreads(8, 8, 1)]
void BuildFoamObjectContactField(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamDimensions.x ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(dispatchId.xy);
    float coverage = LoadBoundaryCoverage(coordinate);
    float obstacle = FoamLoadObstacleClamped(coordinate);
    if (coverage <= 0.001 || obstacle > 0.5)
    {
        _FoamObjectContactFieldWrite[coordinate] = 0.0.xxxx;
        return;
    }

    FoamMetricRow metric = _FoamMetricRows[coordinate.x];
    float2 physicalCellSpacing = float2(
        max(0.01, metric.widthsAndSpacing.z),
        max(0.01, metric.widthsAndSpacing.w));

    float2 gradientToObstacle = float2(0.0, 0.0);
    float contactAccumulation = 0.0;
    [unroll]
    for (int oy = -1; oy <= 1; oy++)
    {
        [unroll]
        for (int ox = -1; ox <= 1; ox++)
        {
            if (ox == 0 && oy == 0)
            {
                continue;
            }

            float solid = FoamLoadObstacleClamped(coordinate + int2(ox, oy));
            if (solid <= 0.001)
            {
                continue;
            }

            float2 offset = float2(
                (float)ox * physicalCellSpacing.x,
                (float)oy * physicalCellSpacing.y);
            float offsetLength = max(0.001, length(offset));
            float weightedSolid = solid;
            gradientToObstacle +=
                (offset / offsetLength) * weightedSolid;
            contactAccumulation += weightedSolid;
        }
    }

    if (contactAccumulation <= 0.0001)
    {
        _FoamObjectContactFieldWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float gradientLength = length(gradientToObstacle);
    float2 waterNormal = gradientLength > 0.001
        ? -gradientToObstacle / gradientLength
        : float2(-_FoamFlowDirection, 0.0);

    float2 domainUV = FoamTexelCentreUV(dispatchId.xy, _FoamDimensions);
    float4 pressure = SampleStaticPressureBilinear(domainUV);
    float pressurePresence = smoothstep(0.00035, 0.0045, max(0.0, pressure.r));
    float pressureGradientLength = length(pressure.gb);
    if (pressureGradientLength > 0.0001)
    {
        float2 pressureNormal = normalize(pressure.gb);
        if (dot(pressureNormal, waterNormal) < 0.0)
        {
            pressureNormal = -pressureNormal;
        }

        waterNormal = normalize(lerp(
            waterNormal,
            pressureNormal,
            saturate(pressurePresence * 0.35)));
    }

    float proximity = saturate(contactAccumulation);
    float confidence = saturate(proximity * lerp(0.62, 1.0, pressurePresence));
    float upstreamFacing = dot(waterNormal, float2(-_FoamFlowDirection, 0.0));
    float frontSideRelevance = saturate(0.22 + 0.78 * (upstreamFacing * 0.5 + 0.5));

    _FoamObjectContactFieldWrite[coordinate] = float4(
        confidence,
        waterNormal.x,
        waterNormal.y,
        frontSideRelevance);
}

[numthreads(8, 8, 1)]
void BuildEvolvingMajorSupport(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    int2 outputCoordinate = int2(dispatchId.xy);
    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamGridUInsideDomain(uv.x))
    {
        _FoamEvolvingMajorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingHostedNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingFreeWaterNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingConnectorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingWeakSpanNegativeWrite[outputCoordinate] = 0.0;
        return;
    }

    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float fluidCoverage = saturate(
        SampleBoundaryCoverageBilinear(fullPixel));
    int2 obstacleCoordinate = int2(
        FoamUVToContainingTexel(uv.x, _FoamDimensions.x),
        FoamUVToContainingTexel(uv.y, _FoamDimensions.y));
    float obstacle = saturate(_FoamObstacleExclusionRead.Load(
        int3(obstacleCoordinate, 0)));
    if (fluidCoverage <= 0.0001 || obstacle >= 0.9999)
    {
        _FoamEvolvingMajorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingHostedNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingFreeWaterNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingConnectorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingWeakSpanNegativeWrite[outputCoordinate] = 0.0;
        return;
    }

    int metricX = FoamUVToContainingTexel(
        uv.x,
        _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    float localDistance = FoamGridLocalDistanceAtUV(uv.x);
    float lateralMetres = FoamLateralMetresAtUV(uv.y, metric);
    float support = 0.0;
    float hostedNegative = 0.0;
    float freeWaterNegative = 0.0;
    float connectorSupport = 0.0;
    float weakSpanNegative = 0.0;
    float2 metricPosition = float2(localDistance, lateralMetres);
    bool identityCellValid =
        fluidCoverage > 0.001 && obstacle < 0.5;

    [loop]
    for (int regionIndex = 0;
         regionIndex < _FoamMajorEvolutionCount;
         regionIndex++)
    {
        FoamMajorEvolutionData region =
            _FoamMajorEvolutionRecords[regionIndex];
        float2 candidatePosition;
        if (!ResolveMajorCandidatePosition(
                region,
                metric,
                localDistance,
                lateralMetres,
                true,
                candidatePosition))
        {
            continue;
        }

        int sliceIndex = clamp(
            (int)round(region.candidateShape.w),
            0,
            max(0, _FoamMajorEvolutionCount - 1));
        float candidateSupport = SampleMajorMaskBilinear(
            sliceIndex,
            candidatePosition);
        support = max(
            support,
            candidateSupport * region.candidateExtents.w);
    }

    [loop]
    for (int hostedNegativeIndex = 0;
         hostedNegativeIndex < _FoamHostedNegativeEvolutionCount;
         hostedNegativeIndex++)
    {
        FoamHostedNegativeEvolutionData hostedRecord =
            _FoamHostedNegativeEvolutionRecords[hostedNegativeIndex];
        int hostIndex = clamp(
            (int)round(hostedRecord.hostAndMask.x),
            0,
            max(0, _FoamMajorEvolutionCount - 1));
        FoamMajorEvolutionData host =
            _FoamMajorEvolutionRecords[hostIndex];
        float2 candidatePosition;
        if (!ResolveMajorCandidatePosition(
                host,
                metric,
                localDistance,
                lateralMetres,
                false,
                candidatePosition))
        {
            continue;
        }

        float2 centre = hostedRecord.centreAndOffset.xy;
        float2 relative = candidatePosition -
            centre - hostedRecord.centreAndOffset.zw;
        float rotation = hostedRecord.morph.z;
        float rotationCosine = cos(rotation);
        float rotationSine = sin(rotation);
        float2 local = float2(
            rotationCosine * relative.x +
                rotationSine * relative.y,
            -rotationSine * relative.x +
                rotationCosine * relative.y);
        local.x /= max(0.05, hostedRecord.morph.x);
        local.y /= max(0.05, hostedRecord.morph.y);
        float2 samplePosition = centre + local;
        int sliceIndex = clamp(
            (int)round(hostedRecord.hostAndMask.y),
            0,
            max(0, _FoamHostedNegativeEvolutionCount - 1));
        float pressure = SampleHostedNegativeMaskBilinear(
            sliceIndex,
            samplePosition);
        hostedNegative = max(
            hostedNegative,
            pressure * hostedRecord.hostAndMask.z);
    }

    [loop]
    for (int freeWaterIndex = 0;
         freeWaterIndex < _FoamFreeWaterEvolutionCount;
         freeWaterIndex++)
    {
        FoamFreeWaterEvolutionData freeWaterRecord =
            _FoamFreeWaterEvolutionRecords[freeWaterIndex];
        float centreAcrossNormalized = clamp(
            freeWaterRecord.centreAndPlacement.y,
            -1.0,
            1.0);
        float centreLateralMetres = centreAcrossNormalized < 0.0
            ? centreAcrossNormalized * max(0.01, metric.widthsAndSpacing.x)
            : centreAcrossNormalized * max(0.01, metric.widthsAndSpacing.y);
        float2 delta = float2(
            localDistance -
                (freeWaterRecord.centreAndPlacement.x +
                    freeWaterRecord.morph.x),
            lateralMetres -
                (centreLateralMetres + freeWaterRecord.morph.y));
        float rotation = freeWaterRecord.centreAndPlacement.z;
        float rotationCosine = cos(rotation);
        float rotationSine = sin(rotation);
        float2 local = float2(
            rotationCosine * delta.x + rotationSine * delta.y,
            -rotationSine * delta.x + rotationCosine * delta.y);
        local.x /= max(0.05, freeWaterRecord.morph.z);
        local.y /= max(0.05, freeWaterRecord.morph.w);
        float metresPerCell = max(
            0.0001,
            freeWaterRecord.centreAndPlacement.w);
        float2 samplePosition = freeWaterRecord.maskAndStrength.xy +
            local / metresPerCell;
        int sliceIndex = clamp(
            (int)round(freeWaterRecord.maskAndStrength.z),
            0,
            max(0, _FoamFreeWaterEvolutionCount - 1));
        float pressure = SampleFreeWaterNegativeMaskBilinear(
            sliceIndex,
            samplePosition);
        freeWaterNegative = max(
            freeWaterNegative,
            pressure * freeWaterRecord.maskAndStrength.w);
    }

    if (identityCellValid && _FoamConnectorIdentityCount > 0)
    {
        connectorSupport = EvaluateConnectorIdentitySupport(
            metricPosition,
            support);
    }
    if (identityCellValid && _FoamWeakSpanIdentityCount > 0)
    {
        weakSpanNegative = EvaluateWeakSpanIdentityPressure(
            metricPosition,
            support,
            connectorSupport);
    }

    float validMask = fluidCoverage * (1.0 - obstacle);
    _FoamEvolvingMajorWrite[outputCoordinate] = saturate(
        support * validMask);
    _FoamEvolvingHostedNegativeWrite[outputCoordinate] = saturate(
        hostedNegative * validMask);
    _FoamEvolvingFreeWaterNegativeWrite[outputCoordinate] = saturate(
        freeWaterNegative * validMask);
    _FoamEvolvingConnectorWrite[outputCoordinate] = saturate(
        connectorSupport);
    _FoamEvolvingWeakSpanNegativeWrite[outputCoordinate] = saturate(
        weakSpanNegative);
}

[numthreads(8, 8, 1)]
void CaptureGeneratedTopology(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    int2 outputCoordinate = int2(dispatchId.xy);
    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamGridUInsideDomain(uv.x))
    {
        _FoamTopologyTransitionCaptureWrite[outputCoordinate] = 0.0.xxxx;
        return;
    }

    int metricX = FoamUVToContainingTexel(
        uv.x,
        _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    float3 generated = ResolveCurrentGeneratedTopology(outputCoordinate);
    generated = ApplyGeneratedTopologyTransition(
        generated,
        outputCoordinate,
        uv,
        metric);
    _FoamTopologyTransitionCaptureWrite[outputCoordinate] =
        float4(generated, 0.0);
}

[numthreads(8, 8, 1)]
void ComposeTopology(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    int2 outputCoordinate = int2(dispatchId.xy);
    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamGridUInsideDomain(uv.x))
    {
        _FoamTopologyWrite[outputCoordinate] = 0.0.xxxx;
        _FoamTopologySourcesWrite[outputCoordinate] = 0.0.xxxx;
        return;
    }

    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float fluidCoverage = saturate(
        SampleBoundaryCoverageBilinear(fullPixel));

    int metricX = FoamUVToContainingTexel(
        uv.x,
        _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    // The exact obstacle mask uses the full structural grid. Resolve its texel
    // once here so Pressure Support and negative topology consume the same
    // geometry-aligned coordinate without a half-texel disagreement.
    int2 obstacleCoordinate = int2(
        FoamUVToContainingTexel(uv.x, _FoamDimensions.x),
        FoamUVToContainingTexel(uv.y, _FoamDimensions.y));
    float3 generatedTopology = ResolveCurrentGeneratedTopology(
        outputCoordinate);
    generatedTopology = ApplyGeneratedTopologyTransition(
        generatedTopology,
        outputCoordinate,
        uv,
        metric);
    float majorSupport = generatedTopology.r;
    float connectorSupport = generatedTopology.g;
    float negativeAgingPressure = generatedTopology.b;

    float4 staticPressure = 0.0.xxxx;
    float4 staticWake = 0.0.xxxx;
    if (_FoamDisturbanceEnabled > 0.5)
    {
        staticPressure = SampleStaticPressureBilinear(uv);
        staticWake = SampleStaticWakeBilinear(uv);
    }

    // Canonical Anchored Support classes remain independent: no support class
    // gates, boosts, attenuates, or reshapes another support class. Pressure
    // may additionally consume the shared exact solid geometry mask solely to
    // cap implausible open-water reach; that mask is not lifespan support and
    // does not generate Pressure support.
    // Pressure Support keeps the accepted Stage 5 pressure footprint, but it
    // must be a measurable support area rather than a visualization of
    // raw pressure amplitude. The pressure gradient already stores world-space
    // height change per metre. Height / gradient therefore gives a local
    // distance-to-edge estimate without rebuilding or resampling object
    // geometry. Only the exposed upstream/side edges are tightened; the rear
    // contact edge remains attached to the source.
    float pressureHeight = max(0.0, staticPressure.r);
    float2 pressureGradient = staticPressure.gb;
    float pressureGradientLength = length(pressureGradient);
    float pressureEdgeDistance = pressureHeight /
        max(0.00001, pressureGradientLength);
    float upstreamEdgeWeight = saturate(
        max(0.0, pressureGradient.x) /
        max(0.00001, pressureGradientLength));
    float sideEdgeWeight = saturate(
        abs(pressureGradient.y) /
        max(0.00001, pressureGradientLength));
    float exposedEdgeWeight = saturate(
        upstreamEdgeWeight + sideEdgeWeight);
    float upstreamShare = upstreamEdgeWeight /
        max(0.00001, upstreamEdgeWeight + sideEdgeWeight);

    // Contract the upstream reach only slightly. The metric-scaled values keep
    // the adjustment consistent across the 64/96/128 structural tiers while
    // preserving a narrow, at-most-one-cell transition instead of the former
    // broad fuzzy shoulder.
    float pressureUpstreamInset = max(
        0.08,
        metric.widthsAndSpacing.z * 0.35);
    float pressureUpstreamFeather = max(
        0.05,
        metric.widthsAndSpacing.z * 0.22);
    float pressureSideFeather = max(
        0.025,
        metric.widthsAndSpacing.w * 0.75);
    float pressureEdgeInset = pressureUpstreamInset * upstreamShare;
    float pressureEdgeFeather = lerp(
        pressureSideFeather,
        pressureUpstreamFeather,
        upstreamShare);
    float pressureEdgeGate = smoothstep(
        pressureEdgeInset,
        pressureEdgeInset + pressureEdgeFeather,
        pressureEdgeDistance);
    float pressurePresence = smoothstep(
        0.0005,
        0.003,
        pressureHeight);
    float pressureSupport = saturate(
        pressurePresence *
        lerp(1.0, pressureEdgeGate, exposedEdgeWeight));

    // Keep the accepted Stage 5 field as the candidate shape, but intersect it
    // with a fail-closed envelope emitted by the exact current-water upstream
    // solid boundary. This removes unsupported forward shelves without
    // rebuilding Pressure, expanding it, or changing Stage 5 behaviour.
    if (pressureSupport > 0.0001)
    {
        pressureSupport *= ResolvePressureSupportEnvelope(
            obstacleCoordinate,
            max(0.001, metric.widthsAndSpacing.z),
            max(0.001, metric.widthsAndSpacing.w));
    }

    float leeSupport = saturate(max(0.0, staticWake.g));

    float2 currentShoreEdges = _FoamCurrentShoreEdgesRead.Load(
        int3(outputCoordinate.x, 0, 0));
    float lateralMetres = FoamLateralMetresAtUV(uv.y, metric);
    float leftInsideDistance = lateralMetres - currentShoreEdges.x;
    float rightInsideDistance = currentShoreEdges.y - lateralMetres;
    float nearestCurrentShore = min(
        leftInsideDistance,
        rightInsideDistance);
    float shoreTotalWidth = max(
        0.001,
        _FoamShoreCaptureCoreWidth + _FoamShoreCaptureFadeWidth);
    float shoreSupport = nearestCurrentShore >= 0.0
        ? 1.0 - smoothstep(
            max(0.0, _FoamShoreCaptureCoreWidth),
            shoreTotalWidth,
            nearestCurrentShore)
        : 0.0;

    float validDomainMask = saturate(metric.topologyData.w);
    // Obstacle Footprint is point-sampled and each texel owns its complete
    // UV rectangle. Pressure Support above uses this exact same coordinate and
    // source mask for its local upstream boundary clamp.
    float obstacleFootprint = saturate(
        _FoamObstacleExclusionRead.Load(
            int3(obstacleCoordinate, 0))) * validDomainMask;
    float staticFluidMask = fluidCoverage * validDomainMask;
    float dynamicShoreMask = shoreSupport * validDomainMask *
        (1.0 - obstacleFootprint);

    // Aggregate Negative Aging Pressure remains an independent negative field,
    // so weak and transitional positive influence may still overlap it and
    // later compete through the material-lifecycle response. Only authoritative
    // strong anchored cores are protected here, together with the exact
    // obstacle footprint.
    float anchoredCore = max(
        max(pressureSupport, leeSupport),
        shoreSupport);
    float anchoredCoreProtection = smoothstep(
        0.72,
        0.92,
        anchoredCore);
    negativeAgingPressure *=
        (1.0 - anchoredCoreProtection) *
        (1.0 - obstacleFootprint);

    // Topology RGBA = Major, Connector, aggregate Negative Aging Pressure,
    // and reserved zero. Canonical obstacle geometry lives only in the
    // dedicated obstacle-exclusion texture.
    // Anchored source RGBA = Pressure Support, Lee Support, Shore Support, zero.
    float4 topology = saturate(float4(
        majorSupport * staticFluidMask,
        connectorSupport * staticFluidMask,
        negativeAgingPressure * staticFluidMask,
        0.0));
    float4 sources = saturate(float4(
        pressureSupport * staticFluidMask,
        leeSupport * staticFluidMask,
        dynamicShoreMask,
        0.0));

    _FoamTopologyWrite[outputCoordinate] = topology;
    _FoamTopologySourcesWrite[outputCoordinate] = sources;
}

[numthreads(64, 1, 1)]
void ResetTopologyMetrics(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= FoamMetricCount)
    {
        return;
    }

    uint resetValue = dispatchId.x == FoamMetricVisibleLifeMinFixedIndex
        ? 10000u
        : 0u;
    _FoamTopologyMetrics.Store(dispatchId.x * 4u, resetValue);
}

[numthreads(8, 8, 1)]
void MeasureTopologyMetrics(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamGridUInsideDomain(uv.x))
    {
        return;
    }

    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float boundaryCoverage = SampleBoundaryCoverageBilinear(fullPixel);
    int2 obstacleCoordinate = int2(
        FoamUVToContainingTexel(uv.x, _FoamDimensions.x),
        FoamUVToContainingTexel(uv.y, _FoamDimensions.y));
    float canonicalObstacleFootprint = LoadObstacleExclusionCell(
        obstacleCoordinate);

    float4 topology = _FoamTopologyRead.Load(int3(dispatchId.xy, 0));
    float4 sources = _FoamTopologySourcesRead.Load(int3(dispatchId.xy, 0));
    FoamMaterialTopologySample materialTopology =
        FoamResolveMaterialTopology(
            topology,
            sources,
            boundaryCoverage,
            canonicalObstacleFootprint);
    if (materialTopology.validFluid <= 0.001)
    {
        return;
    }

    FoamMaterialState visibleMaterial = FoamDecodeMaterialState(
        SampleStateAtUV(uv));
    float presence = visibleMaterial.presence;
    bool visible = presence >= _FoamPresenceMetricThreshold;
    bool major = materialTopology.majorSupport >= 0.15;
    bool connector = materialTopology.connectorSupport >= 0.12;
    bool negativeAging =
        materialTopology.negativeAgingPressure >= 0.35;
    bool shoreSupported = materialTopology.shoreSupport >= 0.15;
    bool pressureLeeSupported = max(
        materialTopology.pressureSupport,
        materialTopology.leeSupport) >= 0.15;
    float positiveSupport = FoamCombinedMaterialSupport(materialTopology);
    float localAgeRate = FoamResolveLocalAgeRate(materialTopology);

    float2 texel = 1.0 /
        max(float2(2.0, 2.0), (float2)_FoamTopologyDimensions);
    bool perimeter = visible && (
        SampleStateAtUV(saturate(uv + float2(texel.x, 0.0))).x < _FoamPresenceMetricThreshold ||
        SampleStateAtUV(saturate(uv - float2(texel.x, 0.0))).x < _FoamPresenceMetricThreshold ||
        SampleStateAtUV(saturate(uv + float2(0.0, texel.y))).x < _FoamPresenceMetricThreshold ||
        SampleStateAtUV(saturate(uv - float2(0.0, texel.y))).x < _FoamPresenceMetricThreshold);

    uint originalValue;
    _FoamTopologyMetrics.InterlockedAdd(FoamMetricValidFluidOffset, 1u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(FoamMetricMajorSupportOffset, major ? 1u : 0u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(FoamMetricConnectorSupportOffset, connector ? 1u : 0u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricNegativeAgingPressureOffset,
        negativeAging ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricFoamInNegativeOffset,
        negativeAging && visible ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(FoamMetricVisibleMaterialOffset, visible ? 1u : 0u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricShoreSupportOffset,
        shoreSupported ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricFoamInShoreOffset,
        shoreSupported && visible ? 1u : 0u,
        originalValue);
    FoamMetricRow metric = _FoamMetricRows[obstacleCoordinate.x];
    float fullCellArea = max(
        0.000001,
        metric.widthsAndSpacing.z * metric.widthsAndSpacing.w);
    float representedCellCount =
        ((float)_FoamDimensions.x /
         max(1.0, (float)_FoamTopologyDimensions.x)) *
        ((float)_FoamDimensions.y /
         max(1.0, (float)_FoamTopologyDimensions.y));
    float representedArea = fullCellArea * representedCellCount;
    uint integratedAreaFixed = (uint)round(
        saturate(presence) * representedArea *
        max(1.0, _FoamIntegratedAreaFixedPointScale));
    uint visibleCoreAreaFixed = (uint)round(
        (presence >= 0.5 ? representedArea : 0.0) *
        max(1.0, _FoamIntegratedAreaFixedPointScale));
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricIntegratedPresenceAreaOffset,
        integratedAreaFixed,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricPresenceCoreAreaOffset,
        visibleCoreAreaFixed,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricPressureLeeSupportOffset,
        pressureLeeSupported ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricFoamInPressureLeeOffset,
        pressureLeeSupported && visible ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricPerimeterVisibleOffset,
        perimeter ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        FoamMetricConnectorMajorOverlapOffset,
        connector && materialTopology.majorSupport >= 0.24 ? 1u : 0u,
        originalValue);

    if (visible)
    {
        uint visiblePresenceAreaFixed = (uint)round(
            saturate(presence) * representedArea *
            max(1.0, _FoamIntegratedAreaFixedPointScale));
        uint visibleLifeAreaFixed = (uint)round(
            saturate(presence) * saturate(visibleMaterial.remainingLife) *
            representedArea * max(1.0, _FoamIntegratedAreaFixedPointScale));
        uint positiveAreaFixed = (uint)round(
            saturate(presence) * saturate(positiveSupport) *
            representedArea * max(1.0, _FoamIntegratedAreaFixedPointScale));
        uint negativeAreaFixed = (uint)round(
            saturate(presence) * saturate(materialTopology.negativeAgingPressure) *
            representedArea * max(1.0, _FoamIntegratedAreaFixedPointScale));
        uint agingRateAreaFixed = (uint)round(
            saturate(presence) * min(localAgeRate, 16.0) *
            representedArea * max(1.0, _FoamIntegratedAreaFixedPointScale));
        uint maxPositiveFixed = (uint)round(
            saturate(positiveSupport) * 10000.0);
        uint maxNegativeFixed = (uint)round(
            saturate(materialTopology.negativeAgingPressure) * 10000.0);
        uint visibleLifeFixed = (uint)round(
            saturate(visibleMaterial.remainingLife) * 10000.0);

        _FoamTopologyMetrics.InterlockedAdd(
            FoamMetricVisiblePresenceAreaOffset,
            visiblePresenceAreaFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedAdd(
            FoamMetricVisibleLifeAreaOffset,
            visibleLifeAreaFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedAdd(
            FoamMetricVisiblePositiveSupportAreaOffset,
            positiveAreaFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedAdd(
            FoamMetricVisibleNegativeAgingAreaOffset,
            negativeAreaFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedAdd(
            FoamMetricVisibleLocalAgingRateAreaOffset,
            agingRateAreaFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedAdd(
            FoamMetricFoamSupportNegativeOverlapOffset,
            positiveSupport >= 0.15 && negativeAging ? 1u : 0u,
            originalValue);
        _FoamTopologyMetrics.InterlockedMax(
            FoamMetricMaxPositiveSupportUnderFoamOffset,
            maxPositiveFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedMax(
            FoamMetricMaxNegativeAgingUnderFoamOffset,
            maxNegativeFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedMin(
            FoamMetricVisibleLifeMinFixedOffset,
            visibleLifeFixed,
            originalValue);
        _FoamTopologyMetrics.InterlockedMax(
            FoamMetricVisibleLifeMaxFixedOffset,
            visibleLifeFixed,
            originalValue);
    }
}

[numthreads(64, 1, 1)]
void ResetTransportMetrics(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= FoamTransportMetricCount)
    {
        return;
    }

    _FoamTransportMetrics.Store(dispatchId.x * 4u, 0u);
}

[numthreads(8, 8, 1)]
void RemapPersistentFoamState(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamDimensions.x ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(dispatchId.xy);
    float4 remapped = 0.0.xxxx;
    int2 previousCoordinate;
    if (TryResolvePersistentStateRemapCoordinate(
            coordinate,
            previousCoordinate))
    {
        remapped = FoamClampPackedMaterialState(
            _FoamPersistentStateRemapRead.Load(
                int3(previousCoordinate, 0)));
    }

    float validFluid = FoamValidFluidAt(coordinate);
    _FoamStateWrite[coordinate] = FoamClipPackedToValidFluid(
        remapped,
        validFluid);
}

[numthreads(8, 8, 1)]
void SimulateFoam(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    float validFluid = FoamValidFluidAt(coordinate);
    if (validFluid <= FoamMaterialStateEpsilon)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float4 currentPacked = FoamClipPackedToValidFluid(
        FoamClampPackedMaterialState(
            _FoamStateRead.Load(int3(coordinate, 0))),
        validFluid);
    float cellArea = FoamTransportCellArea(x, y);
    FoamAccumulateTransportTriplet(
        FoamTransportPresenceBeforeOffset,
        FoamTransportLifeBeforeOffset,
        FoamTransportPatternBeforeOffset,
        currentPacked * cellArea);

    float4 eastFlux = 0.0.xxxx;
    float4 westFlux = 0.0.xxxx;
    float4 eastOutflow = 0.0.xxxx;
    float4 westOutflow = 0.0.xxxx;
    FoamResolveLongitudinalFaceFlux(
        x,
        y,
        eastFlux,
        eastOutflow);
    FoamResolveLongitudinalFaceFlux(
        x - 1,
        y,
        westFlux,
        westOutflow);
    float northFaceVelocity;
    float northDonorPresence;
    float northFaceLength;
    float4 northFlux = FoamResolveLateralFaceFlux(
        x,
        y,
        northFaceVelocity,
        northDonorPresence,
        northFaceLength);
    float4 southFlux = FoamResolveLateralFaceFlux(x, y - 1);
    // Every interior lateral face is the north face of exactly one cell.
    // Count it once here; south-face values remain transport-only.
    FoamAccumulateLateralTransportEvidence(
        northFaceVelocity,
        northDonorPresence,
        northFaceLength,
        northFlux.x);

    float4 currentMass = currentPacked * cellArea;
    float4 transportedMass = currentMass - _FoamDeltaTime * (
        eastFlux - westFlux + northFlux - southFlux);
    float4 rawTransported = transportedMass / max(0.0001, cellArea);
    float4 transportedPacked = FoamClipPackedToValidFluid(
        FoamClampPackedMaterialState(rawTransported),
        validFluid);
    float4 clampedMass = transportedPacked * cellArea;
    float4 clampLoss = max(0.0.xxxx, transportedMass - clampedMass);
    float4 boundaryOutflow = _FoamDeltaTime * (
        eastOutflow + westOutflow);

    FoamAccumulateTransportTriplet(
        FoamTransportPresenceAfterOffset,
        FoamTransportLifeAfterOffset,
        FoamTransportPatternAfterOffset,
        clampedMass);
    FoamAccumulateTransportTriplet(
        FoamTransportPresenceOutflowOffset,
        FoamTransportLifeOutflowOffset,
        FoamTransportPatternOutflowOffset,
        boundaryOutflow);
    FoamAccumulateTransportTriplet(
        FoamTransportPresenceClampOffset,
        FoamTransportLifeClampOffset,
        FoamTransportPatternClampOffset,
        clampLoss);
    FoamAccumulateTransportPresenceAttribution(
        coordinate,
        rawTransported.x,
        transportedPacked.x,
        validFluid,
        cellArea,
        clampLoss.x);

    // Stored material occupies this exact cell after conservative transport.
    // Topology/lifecycle sampling therefore uses the current cell centre with
    // no phase compensation.
    float2 worldSampleCoordinate = (float2)coordinate + 0.5;
    float2 topologySampleCoordinate = float2(
        worldSampleCoordinate.x /
            max(1.0, (float)_FoamDimensions.x) *
            (float)_FoamTopologyDimensions.x,
        worldSampleCoordinate.y /
            max(1.0, (float)_FoamDimensions.y) *
            (float)_FoamTopologyDimensions.y);
    float4 topologyState = SampleTopologyBilinear(topologySampleCoordinate);
    float4 anchoredSources = SampleTopologySourcesBilinear(
        topologySampleCoordinate);
    float obstacleFootprint = SampleObstacleExclusionBilinear(
        worldSampleCoordinate);
    FoamMaterialTopologySample materialTopology =
        FoamResolveMaterialTopology(
            topologyState,
            anchoredSources,
            SampleBoundaryCoverageBilinear(worldSampleCoordinate),
            obstacleFootprint);

    FoamMaterialState material = FoamDecodeMaterialState(transportedPacked);
    if (material.presence <= FoamMaterialStateEpsilon)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float localAgeRate = FoamResolveLocalAgeRate(materialTopology);
    float configuredAgeDelta = _FoamLifecycleDeltaTime * localAgeRate /
        max(0.05, _FoamNeutralLifetime);
    float absoluteProbeAgeDelta = _FoamLifecycleDeltaTime;
    float ageDelta = _FoamDebugAbsoluteLifeProbeActive > 0.5
        ? absoluteProbeAgeDelta
        : configuredAgeDelta;
    material.remainingLife = max(
        0.0,
        material.remainingLife - ageDelta);

    // Only lifecycle aging changes normalized Remaining Life. Transport has
    // already moved the complete packed vector with shared face fluxes.
    _FoamStateWrite[coordinate] = FoamClipPackedToValidFluid(
        FoamEncodeMaterialState(material),
        validFluid);
}
