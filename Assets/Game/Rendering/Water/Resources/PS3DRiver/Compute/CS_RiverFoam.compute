#include "CS_RiverFoam.Support.hlsl"
#include "CS_RiverFoam.Network.hlsl"
#include "CS_RiverFoam.Motion.hlsl"
#include "CS_RiverFoam.Simulation.hlsl"
#include "CS_RiverFoam.Evolution.hlsl"
#include "CS_RiverFoam.TopologyTransition.hlsl"

[numthreads(8, 8, 1)]
void ClearRange(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    _FoamStateWrite[int2(x, dispatchId.y)] = 0.0.xxxx;
}

[numthreads(8, 8, 1)]
void ApplyBoundary(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    if (!IsFoamColumnInsideSimulation(x))
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float coverage = LoadBoundary(coordinate).x;
    float4 state = _FoamStateWrite[coordinate];
    state.xyz *= coverage;

    if (coverage <= 0.001 || state.x < 0.001)
    {
        state = 0.0.xxxx;
    }

    _FoamStateWrite[coordinate] = saturate(state);
}

[numthreads(8, 8, 1)]
void InjectFoam(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    if (!IsFoamColumnInsideDomain(x))
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float coverage = LoadBoundary(coordinate).x;
    if (coverage <= 0.001)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    FoamMetricRow metric = _FoamMetricRows[x];
    float across01 = FoamAcross01AtTexel(y);
    float lateralMetres = FoamAcross01ToMetres(
        across01,
        metric.widthsAndSpacing.x,
        metric.widthsAndSpacing.y);
    float centreAcrossMetres = FoamAcross01ToMetres(
        saturate(_FoamInjectionAcrossNormalized * 0.5 + 0.5),
        metric.widthsAndSpacing.x,
        metric.widthsAndSpacing.y);
    float globalDistance = _FoamGlobalStart +
        FoamLocalDistanceAtTexel(x);

    float alongDistance =
        (globalDistance - _FoamInjectionGlobalDistance) /
        max(0.05, _FoamInjectionRadius * _FoamInjectionElongation);
    float acrossDistance =
        (lateralMetres - centreAcrossMetres) /
        max(0.05, _FoamInjectionRadius);
    float radial = length(float2(alongDistance, acrossDistance));
    float ellipseShape = saturate(1.0 - radial);
    ellipseShape = ellipseShape * ellipseShape * (3.0 - 2.0 * ellipseShape);
    float compoundShape = EvaluateCompoundInjectionShape(
        alongDistance,
        acrossDistance);
    float shape = lerp(
        ellipseShape,
        compoundShape,
        saturate(_FoamInjectionCompound));

    float4 previous = _FoamStateWrite[coordinate];
    float previousAmount = saturate(previous.x);
    float previousRemainingLife = previousAmount > 0.0001
        ? saturate(previous.y / previousAmount)
        : 0.0;
    float previousIntegrity = previousAmount > 0.0001
        ? saturate(previous.z / previousAmount)
        : 0.0;
    float injectedAmount = saturate(
        shape * _FoamInjectionAmount * coverage);
    float combinedAmount = 1.0 -
        (1.0 - previousAmount) * (1.0 - injectedAmount);
    float addedAmount = max(0.0, combinedAmount - previousAmount);
    float injectedRemainingLife = saturate(
        _FoamInjectionRemainingLife);
    float injectedIntegrity = saturate(
        _FoamInjectionIntegrity);

    float remainingLife = combinedAmount > 0.0001
        ? saturate(
            (previousRemainingLife * previousAmount +
             injectedRemainingLife * addedAmount) /
            combinedAmount)
        : 0.0;
    float integrity = combinedAmount > 0.0001
        ? saturate(
            (previousIntegrity * previousAmount +
             injectedIntegrity * addedAmount) /
            combinedAmount)
        : 0.0;

    float phase = saturate(_FoamInjectionPhase);
    if (previousAmount > 0.001 && combinedAmount > 0.001)
    {
        phase = MixPhaseShortest(
            saturate(previous.w),
            phase,
            saturate(addedAmount / combinedAmount));
    }

    previous.x = combinedAmount;
    previous.y = combinedAmount * remainingLife;
    previous.z = combinedAmount * integrity;
    previous.w = combinedAmount > 0.001 ? phase : 0.0;
    _FoamStateWrite[coordinate] = saturate(previous);
}

// Compatibility helper for provisional metrics/guidance only. The accepted
// soft-lifecycle material response must keep support and negative influence
// separate rather than using this destructive composition.

[numthreads(64, 1, 1)]
void BuildCurrentShoreEdges(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x)
    {
        return;
    }

    int outputX = (int)dispatchId.x;
    float u = FoamTexelCentreUV1D(
        outputX,
        _FoamTopologyDimensions.x);
    if (!IsFoamUInsideDomain(u))
    {
        _FoamCurrentShoreEdgesWrite[int2(outputX, 0)] = float2(0.0, 0.0);
        return;
    }

    int metricX = FoamUVToContainingTexel(u, _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    if (metric.topologyData.w <= 0.0)
    {
        _FoamCurrentShoreEdgesWrite[int2(outputX, 0)] = float2(0.0, 0.0);
        return;
    }

    float globalDistance = _FoamGlobalStart + u * _FoamFieldLength;
    float liquidFactor = 1.0 - saturate(_FoamFreezeAmount);
    float leftVisible = RiverWaterResolveCurrentVisibleShoreHalfWidth(
        globalDistance,
        -1.0,
        metric.shoreData.x,
        metric.widthsAndSpacing.x,
        _FoamTime,
        _FoamMotionFlowSpeed,
        _FoamMotionWaveHeight,
        _FoamMotionWaveLength,
        _FoamMotionWaveSteepness,
        _FoamMotionTurbulence,
        _FoamShoreMotion,
        _FoamShoreMotionWidth,
        _FoamShoreWaveHeightScale,
        _FoamShoreWaveLengthScale,
        _FoamShoreWaveReach,
        _FoamShoreWaveTransitionLength,
        _FoamShoreWaveSizeVariation,
        _FoamShoreWaveSideAsymmetry,
        _FoamShoreWaveProfileVariation,
        _FoamShoreBankCover,
        liquidFactor,
        _FoamSeed);
    float rightVisible = RiverWaterResolveCurrentVisibleShoreHalfWidth(
        globalDistance,
        1.0,
        metric.shoreData.y,
        metric.widthsAndSpacing.y,
        _FoamTime,
        _FoamMotionFlowSpeed,
        _FoamMotionWaveHeight,
        _FoamMotionWaveLength,
        _FoamMotionWaveSteepness,
        _FoamMotionTurbulence,
        _FoamShoreMotion,
        _FoamShoreMotionWidth,
        _FoamShoreWaveHeightScale,
        _FoamShoreWaveLengthScale,
        _FoamShoreWaveReach,
        _FoamShoreWaveTransitionLength,
        _FoamShoreWaveSizeVariation,
        _FoamShoreWaveSideAsymmetry,
        _FoamShoreWaveProfileVariation,
        _FoamShoreBankCover,
        liquidFactor,
        _FoamSeed);

    _FoamCurrentShoreEdgesWrite[int2(outputX, 0)] = float2(
        -leftVisible,
        rightVisible);
}

[numthreads(8, 8, 1)]
void ClearObstacleExclusion(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamDimensions.x ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    _FoamObstacleExclusionWrite[int2(dispatchId.xy)] = 0.0;
}

[numthreads(64, 1, 1)]
void UpdateObstacleExclusion(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamObstacleCellCount)
    {
        return;
    }

    FoamObstacleIntervalCell cell =
        _FoamObstacleCells[dispatchId.x];
    int2 coordinate = int2(
        (int)round(cell.coordinateAndOffset.x),
        (int)round(cell.coordinateAndOffset.y));
    int intervalOffset = (int)round(cell.coordinateAndOffset.z);
    if (coordinate.x < 0 || coordinate.x >= _FoamDimensions.x ||
        coordinate.y < 0 || coordinate.y >= _FoamDimensions.y ||
        intervalOffset < 0)
    {
        return;
    }

    [unroll]
    for (int sampleY = 0; sampleY < 3; sampleY++)
    {
        [unroll]
        for (int sampleX = 0; sampleX < 3; sampleX++)
        {
            int sampleIndex = sampleY * 3 + sampleX;
            if (!IsObstacleIntervalSampleInside(
                    intervalOffset,
                    sampleIndex))
            {
                return;
            }
        }
    }

    _FoamObstacleExclusionWrite[coordinate] = 1.0;
}

[numthreads(8, 8, 1)]
void BuildEvolvingMajorSupport(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    int2 outputCoordinate = int2(dispatchId.xy);
    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamUInsideDomain(uv.x))
    {
        _FoamEvolvingMajorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingHostedNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingFreeWaterNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingConnectorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingWeakSpanNegativeWrite[outputCoordinate] = 0.0;
        return;
    }

    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float fluidCoverage = saturate(
        SampleBoundaryClassesBilinear(fullPixel).r);
    int2 obstacleCoordinate = int2(
        FoamUVToContainingTexel(uv.x, _FoamDimensions.x),
        FoamUVToContainingTexel(uv.y, _FoamDimensions.y));
    float obstacle = saturate(_FoamObstacleExclusionRead.Load(
        int3(obstacleCoordinate, 0)));
    if (fluidCoverage <= 0.0001 || obstacle >= 0.9999)
    {
        _FoamEvolvingMajorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingHostedNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingFreeWaterNegativeWrite[outputCoordinate] = 0.0;
        _FoamEvolvingConnectorWrite[outputCoordinate] = 0.0;
        _FoamEvolvingWeakSpanNegativeWrite[outputCoordinate] = 0.0;
        return;
    }

    int metricX = FoamUVToContainingTexel(
        uv.x,
        _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    float localDistance = saturate(uv.x) * _FoamFieldLength;
    float lateralMetres = FoamAcross01ToMetres(
        saturate(uv.y),
        metric.widthsAndSpacing.x,
        metric.widthsAndSpacing.y);
    float support = 0.0;
    float hostedNegative = 0.0;
    float freeWaterNegative = 0.0;
    float connectorSupport = 0.0;
    float weakSpanNegative = 0.0;
    float2 metricPosition = float2(localDistance, lateralMetres);
    bool identityCellValid =
        fluidCoverage > 0.001 && obstacle < 0.5;

    [loop]
    for (int regionIndex = 0;
         regionIndex < _FoamMajorEvolutionCount;
         regionIndex++)
    {
        FoamMajorEvolutionData region =
            _FoamMajorEvolutionRecords[regionIndex];
        float2 candidatePosition;
        if (!ResolveMajorCandidatePosition(
                region,
                metric,
                localDistance,
                lateralMetres,
                true,
                candidatePosition))
        {
            continue;
        }

        int sliceIndex = clamp(
            (int)round(region.candidateShape.w),
            0,
            max(0, _FoamMajorEvolutionCount - 1));
        float candidateSupport = SampleMajorMaskBilinear(
            sliceIndex,
            candidatePosition);
        support = max(
            support,
            candidateSupport * region.candidateExtents.w);
    }

    [loop]
    for (int hostedNegativeIndex = 0;
         hostedNegativeIndex < _FoamHostedNegativeEvolutionCount;
         hostedNegativeIndex++)
    {
        FoamHostedNegativeEvolutionData hostedRecord =
            _FoamHostedNegativeEvolutionRecords[hostedNegativeIndex];
        int hostIndex = clamp(
            (int)round(hostedRecord.hostAndMask.x),
            0,
            max(0, _FoamMajorEvolutionCount - 1));
        FoamMajorEvolutionData host =
            _FoamMajorEvolutionRecords[hostIndex];
        float2 candidatePosition;
        if (!ResolveMajorCandidatePosition(
                host,
                metric,
                localDistance,
                lateralMetres,
                false,
                candidatePosition))
        {
            continue;
        }

        float2 centre = hostedRecord.centreAndOffset.xy;
        float2 relative = candidatePosition -
            centre - hostedRecord.centreAndOffset.zw;
        float rotation = hostedRecord.morph.z;
        float rotationCosine = cos(rotation);
        float rotationSine = sin(rotation);
        float2 local = float2(
            rotationCosine * relative.x +
                rotationSine * relative.y,
            -rotationSine * relative.x +
                rotationCosine * relative.y);
        local.x /= max(0.05, hostedRecord.morph.x);
        local.y /= max(0.05, hostedRecord.morph.y);
        float2 samplePosition = centre + local;
        int sliceIndex = clamp(
            (int)round(hostedRecord.hostAndMask.y),
            0,
            max(0, _FoamHostedNegativeEvolutionCount - 1));
        float pressure = SampleHostedNegativeMaskBilinear(
            sliceIndex,
            samplePosition);
        hostedNegative = max(
            hostedNegative,
            pressure * hostedRecord.hostAndMask.z);
    }

    [loop]
    for (int freeWaterIndex = 0;
         freeWaterIndex < _FoamFreeWaterEvolutionCount;
         freeWaterIndex++)
    {
        FoamFreeWaterEvolutionData freeWaterRecord =
            _FoamFreeWaterEvolutionRecords[freeWaterIndex];
        float centreAcrossNormalized = clamp(
            freeWaterRecord.centreAndPlacement.y,
            -1.0,
            1.0);
        float centreLateralMetres = centreAcrossNormalized < 0.0
            ? centreAcrossNormalized * max(0.01, metric.widthsAndSpacing.x)
            : centreAcrossNormalized * max(0.01, metric.widthsAndSpacing.y);
        float2 delta = float2(
            localDistance -
                (freeWaterRecord.centreAndPlacement.x +
                    freeWaterRecord.morph.x),
            lateralMetres -
                (centreLateralMetres + freeWaterRecord.morph.y));
        float rotation = freeWaterRecord.centreAndPlacement.z;
        float rotationCosine = cos(rotation);
        float rotationSine = sin(rotation);
        float2 local = float2(
            rotationCosine * delta.x + rotationSine * delta.y,
            -rotationSine * delta.x + rotationCosine * delta.y);
        local.x /= max(0.05, freeWaterRecord.morph.z);
        local.y /= max(0.05, freeWaterRecord.morph.w);
        float metresPerCell = max(
            0.0001,
            freeWaterRecord.centreAndPlacement.w);
        float2 samplePosition = freeWaterRecord.maskAndStrength.xy +
            local / metresPerCell;
        int sliceIndex = clamp(
            (int)round(freeWaterRecord.maskAndStrength.z),
            0,
            max(0, _FoamFreeWaterEvolutionCount - 1));
        float pressure = SampleFreeWaterNegativeMaskBilinear(
            sliceIndex,
            samplePosition);
        freeWaterNegative = max(
            freeWaterNegative,
            pressure * freeWaterRecord.maskAndStrength.w);
    }

    if (identityCellValid && _FoamConnectorIdentityCount > 0)
    {
        connectorSupport = EvaluateConnectorIdentitySupport(
            metricPosition,
            support);
    }
    if (identityCellValid && _FoamWeakSpanIdentityCount > 0)
    {
        weakSpanNegative = EvaluateWeakSpanIdentityPressure(
            metricPosition,
            support,
            connectorSupport);
    }

    float validMask = fluidCoverage * (1.0 - obstacle);
    _FoamEvolvingMajorWrite[outputCoordinate] = saturate(
        support * validMask);
    _FoamEvolvingHostedNegativeWrite[outputCoordinate] = saturate(
        hostedNegative * validMask);
    _FoamEvolvingFreeWaterNegativeWrite[outputCoordinate] = saturate(
        freeWaterNegative * validMask);
    _FoamEvolvingConnectorWrite[outputCoordinate] = saturate(
        connectorSupport);
    _FoamEvolvingWeakSpanNegativeWrite[outputCoordinate] = saturate(
        weakSpanNegative);
}

[numthreads(8, 8, 1)]
void CaptureGeneratedTopology(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    int2 outputCoordinate = int2(dispatchId.xy);
    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamUInsideDomain(uv.x))
    {
        _FoamTopologyTransitionCaptureWrite[outputCoordinate] = 0.0.xxxx;
        return;
    }

    int metricX = FoamUVToContainingTexel(
        uv.x,
        _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    float3 generated = ResolveCurrentGeneratedTopology(outputCoordinate);
    generated = ApplyGeneratedTopologyTransition(
        generated,
        outputCoordinate,
        uv,
        metric);
    _FoamTopologyTransitionCaptureWrite[outputCoordinate] =
        float4(generated, 0.0);
}

[numthreads(8, 8, 1)]
void ComposeTopology(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    int2 outputCoordinate = int2(dispatchId.xy);
    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamUInsideDomain(uv.x))
    {
        _FoamTopologyWrite[outputCoordinate] = 0.0.xxxx;
        _FoamTopologySourcesWrite[outputCoordinate] = 0.0.xxxx;
        return;
    }

    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float4 boundaryClasses = SampleBoundaryClassesBilinear(fullPixel);
    float fluidCoverage = saturate(boundaryClasses.r);

    int metricX = FoamUVToContainingTexel(
        uv.x,
        _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    // The exact obstacle mask uses the full structural grid. Resolve its texel
    // once here so Pressure Support and negative topology consume the same
    // geometry-aligned coordinate without a half-texel disagreement.
    int2 obstacleCoordinate = int2(
        FoamUVToContainingTexel(uv.x, _FoamDimensions.x),
        FoamUVToContainingTexel(uv.y, _FoamDimensions.y));
    float3 generatedTopology = ResolveCurrentGeneratedTopology(
        outputCoordinate);
    generatedTopology = ApplyGeneratedTopologyTransition(
        generatedTopology,
        outputCoordinate,
        uv,
        metric);
    float majorSupport = generatedTopology.r;
    float connectorSupport = generatedTopology.g;
    float negativeAgingPressure = generatedTopology.b;

    float4 staticPressure = 0.0.xxxx;
    float4 staticWake = 0.0.xxxx;
    if (_FoamDisturbanceEnabled > 0.5)
    {
        staticPressure = SampleStaticPressureBilinear(uv);
        staticWake = SampleStaticWakeBilinear(uv);
    }

    // Canonical Anchored Support classes remain independent: no support class
    // gates, boosts, attenuates, or reshapes another support class. Pressure
    // may additionally consume the shared exact solid geometry mask solely to
    // cap implausible open-water reach; that mask is not lifespan support and
    // does not generate Pressure support.
    // Pressure Support keeps the accepted Stage 5 pressure footprint, but it
    // must be a measurable support area rather than a visualization of
    // raw pressure amplitude. The pressure gradient already stores world-space
    // height change per metre. Height / gradient therefore gives a local
    // distance-to-edge estimate without rebuilding or resampling object
    // geometry. Only the exposed upstream/side edges are tightened; the rear
    // contact edge remains attached to the source.
    float pressureHeight = max(0.0, staticPressure.r);
    float2 pressureGradient = staticPressure.gb;
    float pressureGradientLength = length(pressureGradient);
    float pressureEdgeDistance = pressureHeight /
        max(0.00001, pressureGradientLength);
    float upstreamEdgeWeight = saturate(
        max(0.0, pressureGradient.x) /
        max(0.00001, pressureGradientLength));
    float sideEdgeWeight = saturate(
        abs(pressureGradient.y) /
        max(0.00001, pressureGradientLength));
    float exposedEdgeWeight = saturate(
        upstreamEdgeWeight + sideEdgeWeight);
    float upstreamShare = upstreamEdgeWeight /
        max(0.00001, upstreamEdgeWeight + sideEdgeWeight);

    // Contract the upstream reach only slightly. The metric-scaled values keep
    // the adjustment consistent across the 64/96/128 structural tiers while
    // preserving a narrow, at-most-one-cell transition instead of the former
    // broad fuzzy shoulder.
    float pressureUpstreamInset = max(
        0.08,
        metric.widthsAndSpacing.z * 0.35);
    float pressureUpstreamFeather = max(
        0.05,
        metric.widthsAndSpacing.z * 0.22);
    float pressureSideFeather = max(
        0.025,
        metric.widthsAndSpacing.w * 0.75);
    float pressureEdgeInset = pressureUpstreamInset * upstreamShare;
    float pressureEdgeFeather = lerp(
        pressureSideFeather,
        pressureUpstreamFeather,
        upstreamShare);
    float pressureEdgeGate = smoothstep(
        pressureEdgeInset,
        pressureEdgeInset + pressureEdgeFeather,
        pressureEdgeDistance);
    float pressurePresence = smoothstep(
        0.0005,
        0.003,
        pressureHeight);
    float pressureSupport = saturate(
        pressurePresence *
        lerp(1.0, pressureEdgeGate, exposedEdgeWeight));

    // Keep the accepted Stage 5 field as the candidate shape, but intersect it
    // with a fail-closed envelope emitted by the exact current-water upstream
    // solid boundary. This removes unsupported forward shelves without
    // rebuilding Pressure, expanding it, or changing Stage 5 behaviour.
    if (pressureSupport > 0.0001)
    {
        pressureSupport *= ResolvePressureSupportEnvelope(
            obstacleCoordinate,
            max(0.001, metric.widthsAndSpacing.z),
            max(0.001, metric.widthsAndSpacing.w));
    }

    float leeSupport = saturate(max(0.0, staticWake.g));

    float2 currentShoreEdges = _FoamCurrentShoreEdgesRead.Load(
        int3(outputCoordinate.x, 0, 0));
    float lateralMetres = FoamAcross01ToMetres(
        uv.y,
        metric.widthsAndSpacing.x,
        metric.widthsAndSpacing.y);
    float leftInsideDistance = lateralMetres - currentShoreEdges.x;
    float rightInsideDistance = currentShoreEdges.y - lateralMetres;
    float nearestCurrentShore = min(
        leftInsideDistance,
        rightInsideDistance);
    float shoreTotalWidth = max(
        0.001,
        _FoamShoreCaptureCoreWidth + _FoamShoreCaptureFadeWidth);
    float shoreSupport = nearestCurrentShore >= 0.0
        ? 1.0 - smoothstep(
            max(0.0, _FoamShoreCaptureCoreWidth),
            shoreTotalWidth,
            nearestCurrentShore)
        : 0.0;

    float validDomainMask = saturate(metric.topologyData.w);
    // Obstacle Footprint is point-sampled and each texel owns its complete
    // UV rectangle. Pressure Support above uses this exact same coordinate and
    // source mask for its local upstream boundary clamp.
    float obstacleFootprint = saturate(
        _FoamObstacleExclusionRead.Load(
            int3(obstacleCoordinate, 0))) * validDomainMask;
    float staticFluidMask = fluidCoverage * validDomainMask;
    float dynamicShoreMask = shoreSupport * validDomainMask *
        (1.0 - obstacleFootprint);

    // Aggregate Negative Aging Pressure remains an independent negative field,
    // so weak and transitional positive influence may still overlap it and
    // later compete through the material-lifecycle response. Only authoritative
    // strong anchored cores are protected here, together with the exact
    // obstacle footprint.
    float anchoredCore = max(
        max(pressureSupport, leeSupport),
        shoreSupport);
    float anchoredCoreProtection = smoothstep(
        0.72,
        0.92,
        anchoredCore);
    negativeAgingPressure *=
        (1.0 - anchoredCoreProtection) *
        (1.0 - obstacleFootprint);

    // Topology RGBA = Major, Connector, aggregate Negative Aging Pressure,
    // and the derived
    // guidance-resolution copy of the conservative current-water solid mask.
    // Anchored source RGBA = Pressure Support, Lee Support, Shore Support, zero.
    float4 topology = saturate(float4(
        majorSupport * staticFluidMask,
        connectorSupport * staticFluidMask,
        negativeAgingPressure * staticFluidMask,
        obstacleFootprint));
    float4 sources = saturate(float4(
        pressureSupport * staticFluidMask,
        leeSupport * staticFluidMask,
        dynamicShoreMask,
        0.0));

    _FoamTopologyWrite[outputCoordinate] = topology;
    _FoamTopologySourcesWrite[outputCoordinate] = sources;
}

[numthreads(64, 1, 1)]
void ResetTopologyMetrics(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= 16u)
    {
        return;
    }

    _FoamTopologyMetrics.Store(dispatchId.x * 4u, 0u);
}

[numthreads(8, 8, 1)]
void MeasureTopologyMetrics(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamTopologyDimensions.x ||
        dispatchId.y >= (uint)_FoamTopologyDimensions.y)
    {
        return;
    }

    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamTopologyDimensions);
    if (!IsFoamUInsideDomain(uv.x))
    {
        return;
    }

    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float boundaryCoverage = SampleBoundaryBilinear(fullPixel).x;
    int2 obstacleCoordinate = int2(
        FoamUVToContainingTexel(uv.x, _FoamDimensions.x),
        FoamUVToContainingTexel(uv.y, _FoamDimensions.y));
    float canonicalObstacleFootprint = LoadObstacleExclusionCell(
        obstacleCoordinate);

    float4 topology = _FoamTopologyRead.Load(int3(dispatchId.xy, 0));
    float4 sources = _FoamTopologySourcesRead.Load(int3(dispatchId.xy, 0));
    FoamMaterialTopologySample materialTopology =
        FoamResolveMaterialTopology(
            topology,
            sources,
            boundaryCoverage,
            canonicalObstacleFootprint);
    if (materialTopology.validFluid <= 0.001)
    {
        return;
    }

    float amount = SampleStateAtUV(uv).x;
    bool visible = amount >= _FoamVisibleThreshold;
    bool major = materialTopology.majorSupport >= 0.15;
    bool connector = materialTopology.connectorSupport >= 0.12;
    bool negativeAging =
        materialTopology.negativeAgingPressure >= 0.35;
    bool shoreSupported = materialTopology.shoreSupport >= 0.15;
    bool pressureLeeSupported = max(
        materialTopology.pressureSupport,
        materialTopology.leeSupport) >= 0.15;

    float2 texel = 1.0 /
        max(float2(2.0, 2.0), (float2)_FoamTopologyDimensions);
    bool perimeter = visible && (
        SampleStateAtUV(saturate(uv + float2(texel.x, 0.0))).x < _FoamVisibleThreshold ||
        SampleStateAtUV(saturate(uv - float2(texel.x, 0.0))).x < _FoamVisibleThreshold ||
        SampleStateAtUV(saturate(uv + float2(0.0, texel.y))).x < _FoamVisibleThreshold ||
        SampleStateAtUV(saturate(uv - float2(0.0, texel.y))).x < _FoamVisibleThreshold);

    uint originalValue;
    _FoamTopologyMetrics.InterlockedAdd(0u, 1u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(4u, major ? 1u : 0u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(8u, connector ? 1u : 0u, originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        12u,
        negativeAging ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        16u,
        negativeAging && visible ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(20u, visible ? 1u : 0u, originalValue);
    // Metric slots 6 and 7 remain reserved after removal of the obsolete
    // destructive net-support proof diagnostics.
    _FoamTopologyMetrics.InterlockedAdd(
        32u,
        shoreSupported ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        36u,
        shoreSupported && visible ? 1u : 0u,
        originalValue);
    // Metric slots 10 and 11 remain reserved after removal of the
    // former positive obstacle-source metric.
    _FoamTopologyMetrics.InterlockedAdd(
        48u,
        pressureLeeSupported ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        52u,
        pressureLeeSupported && visible ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        56u,
        perimeter ? 1u : 0u,
        originalValue);
    _FoamTopologyMetrics.InterlockedAdd(
        60u,
        connector && materialTopology.majorSupport >= 0.24 ? 1u : 0u,
        originalValue);
}

[numthreads(8, 8, 1)]
void BuildGuidance(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamGuidanceDimensions.x ||
        dispatchId.y >= (uint)_FoamGuidanceDimensions.y)
    {
        return;
    }

    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamGuidanceDimensions);
    float2 epsilon = 1.0 /
        max(float2(2.0, 2.0), (float2)_FoamGuidanceDimensions);

    if (!IsFoamUInsideDomain(uv.x))
    {
        _FoamGuidanceWrite[int2(dispatchId.xy)] = 0.0.xxxx;
        return;
    }

    float4 centreSample = EvaluateNetworkSample(uv);
    float left = EvaluateNetworkDistance(saturate(uv - float2(epsilon.x, 0.0)));
    float right = EvaluateNetworkDistance(saturate(uv + float2(epsilon.x, 0.0)));
    float down = EvaluateNetworkDistance(saturate(uv - float2(0.0, epsilon.y)));
    float up = EvaluateNetworkDistance(saturate(uv + float2(0.0, epsilon.y)));

    int metricX = FoamUVToContainingTexel(uv.x, _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    float dxMetres = max(0.01, _FoamFieldLength * epsilon.x * 2.0);
    float totalWidth = max(
        0.05,
        metric.widthsAndSpacing.x + metric.widthsAndSpacing.y);
    float dyMetres = max(0.01, totalWidth * epsilon.y * 2.0);
    float2 distanceGradient = float2(
        (right - left) / dxMetres,
        (up - down) / dyMetres);
    float gradientLength = length(distanceGradient);
    float2 directionToLane = gradientLength > 0.00001
        ? -distanceGradient / gradientLength
        : float2(0.0, 0.0);

    _FoamGuidanceWrite[int2(dispatchId.xy)] = float4(
        directionToLane,
        saturate(centreSample.y),
        saturate(centreSample.z));
}

[numthreads(64, 1, 1)]
void ResetPopulation(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamChunkCount)
    {
        return;
    }

    uint byteOffset = dispatchId.x * 32u;
    _FoamPopulationMetrics.Store4(
        byteOffset,
        uint4(0, 0, 0, 0));
    _FoamPopulationMetrics.Store4(
        byteOffset + 16u,
        uint4(0, 0, 0, 0));
}

[numthreads(8, 8, 1)]
void MeasurePopulation(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamDimensions.x ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int2 coordinate = int2(dispatchId.xy);
    if (!IsFoamColumnInsideDomain(coordinate.x))
    {
        return;
    }

    float coverage = LoadBoundary(coordinate).x;
    if (coverage <= 0.05)
    {
        return;
    }

    float4 state = _FoamStateRead.Load(int3(coordinate, 0));
    uint safeResolution = max(1u, (uint)_FoamResolutionPerChunk);
    uint maximumChunk = (uint)max(0, _FoamChunkCount - 1);
    uint chunk = min(dispatchId.x / safeResolution, maximumChunk);
    uint byteOffset = chunk * 32u;

    float threshold = max(0.001, _FoamVisibleThreshold);
    bool visible = state.x >= threshold;
    bool interior = false;
    bool perimeter = false;

    if (visible)
    {
        float neighbourThreshold = threshold * 0.82;
        float n0 = LoadState(coordinate + int2(-1, 0)).x;
        float n1 = LoadState(coordinate + int2(1, 0)).x;
        float n2 = LoadState(coordinate + int2(0, -1)).x;
        float n3 = LoadState(coordinate + int2(0, 1)).x;
        float n4 = LoadState(coordinate + int2(-1, -1)).x;
        float n5 = LoadState(coordinate + int2(1, -1)).x;
        float n6 = LoadState(coordinate + int2(-1, 1)).x;
        float n7 = LoadState(coordinate + int2(1, 1)).x;
        interior =
            n0 >= neighbourThreshold && n1 >= neighbourThreshold &&
            n2 >= neighbourThreshold && n3 >= neighbourThreshold &&
            n4 >= neighbourThreshold && n5 >= neighbourThreshold &&
            n6 >= neighbourThreshold && n7 >= neighbourThreshold;
        perimeter = !interior;
    }

    float2 fieldUV = FoamTexelCentreUV(dispatchId.xy, _FoamDimensions);
    float4 guidance = SampleGuidanceBilinear(fieldUV);
    bool laneCell = guidance.z >= 0.32;
    bool laneVisible = laneCell && visible;

    uint amountValue = (uint)round(saturate(state.x) * 4096.0);
    uint originalValue;
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 0u, amountValue, originalValue);
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 4u, visible ? 1u : 0u, originalValue);
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 8u, 1u, originalValue);
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 12u, laneCell ? 1u : 0u, originalValue);
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 16u, perimeter ? 1u : 0u, originalValue);
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 20u, interior ? 1u : 0u, originalValue);
    _FoamPopulationMetrics.InterlockedAdd(
        byteOffset + 24u,
        LoadBoundary(coordinate).y > 0.10 && visible ? 1u : 0u,
        originalValue);
    _FoamPopulationMetrics.InterlockedAdd(byteOffset + 28u, laneVisible ? 1u : 0u, originalValue);
}

[numthreads(8, 8, 1)]
void ClearFractureRange(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamFractureRangeCount ||
        dispatchId.y >= (uint)_FoamFractureDimensions.y)
    {
        return;
    }

    int x = _FoamFractureRangeStart + (int)dispatchId.x;
    if (x < 0 || x >= _FoamFractureDimensions.x)
    {
        return;
    }

    _FoamFractureWrite[int2(x, (int)dispatchId.y)] = float2(0.0, 0.0);
}

[numthreads(8, 8, 1)]
void UpdateFracture(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamFractureDimensions.x ||
        dispatchId.y >= (uint)_FoamFractureDimensions.y)
    {
        return;
    }

    float2 uv = FoamTexelCentreUV(dispatchId.xy, _FoamFractureDimensions);
    float2 fullPixel = FoamUVToTexelCoordinate(uv, _FoamDimensions);
    float2 boundary = SampleBoundaryBilinear(fullPixel);
    if (boundary.x <= 0.001)
    {
        _FoamFractureWrite[int2(dispatchId.xy)] = float2(0.0, 0.0);
        return;
    }

    int metricX = FoamUVToContainingTexel(uv.x, _FoamDimensions.x);
    FoamMetricRow metric = _FoamMetricRows[metricX];
    float totalWidth = max(0.05, metric.widthsAndSpacing.x + metric.widthsAndSpacing.y);
    FoamMotionSample motion = ResolveMotion(fullPixel, uv);
    float2 backUv = uv - float2(
        motion.velocity.x * _FoamFractureDeltaTime / max(0.05, _FoamFieldLength),
        motion.velocity.y * _FoamFractureDeltaTime / totalWidth);
    float2 previous = SampleFractureBilinear(backUv);

    float4 centre = SampleStateAtUV(uv);
    float phase = centre.w;
    float angle = phase * 6.2831853 +
        (FoamFbm(float2(
            (_FoamGlobalStart + uv.x * _FoamFieldLength) * 0.13,
            uv.y * 7.1) + _FoamSeed * 0.0019) - 0.5) * 2.4;
    float2 d0 = float2(cos(angle), sin(angle));
    float2 d1 = float2(-d0.y, d0.x);
    float2 fractureTexel = 1.0 /
        max(float2(2.0, 2.0), (float2)_FoamFractureDimensions);

    float4 a = SampleStateAtUV(saturate(uv + d0 * fractureTexel * 1.5));
    float4 b = SampleStateAtUV(saturate(uv - d0 * fractureTexel * 1.5));
    float4 c = SampleStateAtUV(saturate(uv + d1 * fractureTexel * 1.5));
    float4 d = SampleStateAtUV(saturate(uv - d1 * fractureTexel * 1.5));
    float support0 = min(a.x, b.x);
    float support1 = min(c.x, d.x);
    float averageSupport = (a.x + b.x + c.x + d.x) * 0.25;
    float edgeExposure = saturate(
        1.0 - averageSupport / max(0.035, centre.x));
    float neckStress = smoothstep(0.08, 0.38, max(support0, support1)) *
        (1.0 - smoothstep(0.06, 0.28, min(support0, support1)));
    float phaseStress = (
        PhaseDistance(a.w, phase) * a.x +
        PhaseDistance(b.w, phase) * b.x +
        PhaseDistance(c.w, phase) * c.x +
        PhaseDistance(d.w, phase) * d.x) /
        max(0.001, a.x + b.x + c.x + d.x);

    float4 guideLeft = SampleGuidanceBilinear(saturate(uv - float2(fractureTexel.x, 0.0)));
    float4 guideRight = SampleGuidanceBilinear(saturate(uv + float2(fractureTexel.x, 0.0)));
    float4 guideDown = SampleGuidanceBilinear(saturate(uv - float2(0.0, fractureTexel.y)));
    float4 guideUp = SampleGuidanceBilinear(saturate(uv + float2(0.0, fractureTexel.y)));
    float guidanceShear = saturate(
        length(guideRight.xy - guideLeft.xy) +
        length(guideUp.xy - guideDown.xy));

    float worldDistance = _FoamGlobalStart + uv.x * _FoamFieldLength;
    float lateralMetres = FoamAcross01ToMetres(
        uv.y,
        metric.widthsAndSpacing.x,
        metric.widthsAndSpacing.y);
    float regionalClock = _FoamTime * lerp(0.045, 0.16, saturate(_FoamEvolution / 1.8));
    float regionalDefect = FoamFbm(
        float2(worldDistance * 0.21 + regionalClock, lateralMetres * 0.43 - regionalClock * 0.57) +
        phase * 11.7 + _FoamSeed * 0.0043);
    float defectGate = smoothstep(0.58, 0.82, regionalDefect);

    float age = 1.0 - centre.y;
    float structuralWeakness = saturate(1.0 - centre.z);
    float turbulence = saturate(
        motion.wakeEnergy * 0.18 +
        motion.rippleIntensity * 0.46 +
        guidanceShear * 0.23);
    float stress = saturate(
        edgeExposure * 0.42 +
        neckStress * 0.78 +
        phaseStress * 0.62 +
        age * 0.20 +
        turbulence * 0.45 +
        defectGate * age * 0.38);
    stress *= smoothstep(0.025, 0.22, centre.x);
    stress *= lerp(0.18, 1.0, saturate(_FoamBreakup));
    stress *= lerp(0.42, 1.0, structuralWeakness);

    float2 pa = SampleFractureBilinear(saturate(uv + d0 * fractureTexel * 1.2));
    float2 pb = SampleFractureBilinear(saturate(uv - d0 * fractureTexel * 1.2));
    float2 pc = SampleFractureBilinear(saturate(uv + d1 * fractureTexel * 1.2));
    float2 pd = SampleFractureBilinear(saturate(uv - d1 * fractureTexel * 1.2));
    float propagated = max(max(pa.x, pb.x), max(pc.x, pd.x));
    propagated *= lerp(0.91, 0.985, saturate(_FoamBreakup));

    float damage = previous.x * exp(-_FoamFractureDeltaTime * 0.17);
    damage = max(damage, propagated * smoothstep(0.20, 0.86, stress + previous.y * 0.28));
    damage = saturate(damage + stress * _FoamFractureDeltaTime * lerp(0.28, 1.10, saturate(_FoamBreakup)));
    float coherence = previous.y * exp(-_FoamFractureDeltaTime * 0.10);
    coherence = max(coherence, smoothstep(0.20, 0.62, damage));
    coherence = saturate(coherence + stress * _FoamFractureDeltaTime * 0.38);

    if (centre.x < 0.006)
    {
        damage *= exp(-_FoamFractureDeltaTime * 1.8);
        coherence *= exp(-_FoamFractureDeltaTime * 1.2);
    }

    _FoamFractureWrite[int2(dispatchId.xy)] = saturate(float2(damage, coherence));
}

[numthreads(8, 8, 1)]
void AdvectForward(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    if (!IsFoamColumnInsideSimulation(x))
    {
        _FoamAdvectionWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float coverage = LoadBoundary(coordinate).x;
    if (coverage <= 0.001)
    {
        _FoamAdvectionWrite[coordinate] = 0.0.xxxx;
        return;
    }

    FoamMetricRow metric = _FoamMetricRows[x];
    float longitudinalSpacing = max(0.01, metric.widthsAndSpacing.z);
    float lateralSpacing = max(0.01, metric.widthsAndSpacing.w);
    float2 fieldUV = FoamTexelCentreUV(
        uint2(x, y),
        _FoamDimensions);
    FoamMotionSample motion = ResolveMotion(float2(x, y), fieldUV);
    float2 backPixel = float2(
        x - motion.velocity.x * _FoamDeltaTime / longitudinalSpacing,
        y - motion.velocity.y * _FoamDeltaTime / lateralSpacing);
    float4 state = SampleStateBilinear(backPixel);
    state.xyz *= coverage;
    _FoamAdvectionWrite[coordinate] = saturate(state);
}

[numthreads(8, 8, 1)]
void AdvectReverse(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    if (!IsFoamColumnInsideSimulation(x))
    {
        _FoamAdvectionWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float coverage = LoadBoundary(coordinate).x;
    if (coverage <= 0.001)
    {
        _FoamAdvectionWrite[coordinate] = 0.0.xxxx;
        return;
    }

    FoamMetricRow metric = _FoamMetricRows[x];
    float longitudinalSpacing = max(0.01, metric.widthsAndSpacing.z);
    float lateralSpacing = max(0.01, metric.widthsAndSpacing.w);
    float2 fieldUV = FoamTexelCentreUV(
        uint2(x, y),
        _FoamDimensions);
    FoamMotionSample motion = ResolveMotion(float2(x, y), fieldUV);
    float2 forwardPixel = float2(
        x + motion.velocity.x * _FoamDeltaTime / longitudinalSpacing,
        y + motion.velocity.y * _FoamDeltaTime / lateralSpacing);
    float4 state = SampleAdvectedBilinear(forwardPixel);
    state.xyz *= coverage;
    _FoamAdvectionWrite[coordinate] = saturate(state);
}

[numthreads(8, 8, 1)]
void SimulateFoam(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamRangeCount ||
        dispatchId.y >= (uint)_FoamDimensions.y)
    {
        return;
    }

    int x = _FoamRangeStart + (int)dispatchId.x;
    int y = (int)dispatchId.y;
    if (x < 0 || x >= _FoamDimensions.x)
    {
        return;
    }

    int2 coordinate = int2(x, y);
    bool insidePhysicalDomain = IsFoamColumnInsideDomain(x);
    if (!IsFoamColumnInsideSimulation(x))
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float2 boundary = LoadBoundary(coordinate);
    float coverage = boundary.x;
    if (coverage <= 0.001)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    FoamMetricRow metric = _FoamMetricRows[x];
    float longitudinalSpacing = max(0.01, metric.widthsAndSpacing.z);
    float lateralSpacing = max(0.01, metric.widthsAndSpacing.w);
    float2 fieldUV = FoamTexelCentreUV(
        uint2(x, y),
        _FoamDimensions);
    float globalDistance = _FoamGlobalStart + fieldUV.x * _FoamFieldLength;
    float lateralMetres = FoamAcross01ToMetres(
        fieldUV.y,
        metric.widthsAndSpacing.x,
        metric.widthsAndSpacing.y);

    FoamMotionSample motion = ResolveMotion(float2(x, y), fieldUV);
    float2 backPixel = float2(
        x - motion.velocity.x * _FoamDeltaTime / longitudinalSpacing,
        y - motion.velocity.y * _FoamDeltaTime / lateralSpacing);

    float4 original = _FoamStateRead.Load(int3(coordinate, 0));
    float4 forward = _FoamAdvectedRead.Load(int3(coordinate, 0));
    float4 reverse = _FoamReverseRead.Load(int3(coordinate, 0));
    float3 minimumOriginal;
    float3 maximumOriginal;
    ResolveOriginalBounds(backPixel, minimumOriginal, maximumOriginal);
    float3 corrected = forward.xyz + 0.5 * (original.xyz - reverse.xyz);
    corrected = clamp(corrected, minimumOriginal, maximumOriginal);

    // One-sided causal limiter: anti-diffusion may sharpen material already
    // carried from an upstream/lateral donor, but it may not advance a front
    // beyond the physically sampled donor region.
    float downstreamSign = _FoamFlowSpeed < -0.0001 ? -1.0 : 1.0;
    // ResolveOriginalBounds already inspected the four bilinear donor texels.
    // Reuse that bound rather than resampling the same neighbourhood four more
    // times; it is both causal and materially cheaper in the heaviest kernel.
    float donorMaximum = max(forward.x, maximumOriginal.x);
    corrected.x = min(corrected.x, donorMaximum + 0.0005);

    float amount = saturate(corrected.x);
    float remainingLife = amount > 0.0001
        ? saturate(corrected.y / amount)
        : 0.0;
    float integrity = amount > 0.0001
        ? saturate(corrected.z / amount)
        : 0.0;
    float phase = saturate(forward.w);

    float agitation = saturate(_FoamEvolution / 1.8);
    float fragmentation = saturate(_FoamBreakup);
    float directionalAverage;
    float edgeExposure;
    float neckness;
    float tipness;
    float phaseStress;
    float broadAmount;
    float enclosedSupport;
    float neighbourPhase;
    ResolveFoamDirectionalNeighbourhood(
        x,
        y,
        globalDistance,
        lateralMetres,
        phase,
        amount,
        agitation,
        directionalAverage,
        edgeExposure,
        neckness,
        tipness,
        phaseStress,
        broadAmount,
        enclosedSupport,
        neighbourPhase);

    float targetCoverage = saturate(_FoamTargetCoverage);
    float sourceNeed = ResolveFoamSourceNeed(x, targetCoverage);
    ApplyFoamDistributedSupply(
        x,
        y,
        fieldUV,
        globalDistance,
        lateralMetres,
        sourceNeed,
        broadAmount,
        enclosedSupport,
        coverage,
        insidePhysicalDomain,
        agitation,
        downstreamSign,
        motion,
        amount,
        remainingLife,
        integrity,
        phase);

    float4 topologyState = _FoamTopologyRead.Load(
        int3(coordinate, 0));
    float4 anchoredSources = _FoamTopologySourcesRead.Load(
        int3(coordinate, 0));
    float obstacleFootprint = _FoamObstacleExclusionRead.Load(
        int3(coordinate, 0));
    FoamMaterialTopologySample materialTopology =
        FoamResolveMaterialTopology(
            topologyState,
            anchoredSources,
            coverage,
            obstacleFootprint);
    float positiveInfluence = FoamCombinedMaterialSupport(
        materialTopology);
    float positiveAgeFactor = lerp(
        1.0,
        max(0.01, _FoamPositiveAgeMultiplier),
        positiveInfluence);
    float negativeAgeFactor = lerp(
        1.0,
        max(1.0, _FoamNegativeAgeMultiplier),
        materialTopology.negativeAgingPressure);
    float localAgeRate = positiveAgeFactor * negativeAgeFactor;
    remainingLife = max(
        0.0,
        remainingLife -
        _FoamDeltaTime * localAgeRate /
        max(0.05, _FoamNeutralLifetime));

    float2 fracture = SampleFractureBilinear(fieldUV);
    float age = 1.0 - remainingLife;
    float turbulenceDamage = saturate(
        motion.wakeEnergy * 0.12 + motion.rippleIntensity * 0.38);
    float strainDamage = saturate(
        neckness * 0.72 + tipness * 0.30 + phaseStress * 0.58 + edgeExposure * 0.34);
    float integrityLoss = max(0.0, _FoamIntegrityDamage) * (
        0.008 + age * 0.032 + strainDamage * lerp(0.08, 0.34, fragmentation) +
        fracture.x * fracture.y * lerp(0.22, 0.82, fragmentation) +
        turbulenceDamage * lerp(0.05, 0.24, fragmentation));
    integrity = max(0.0, integrity - integrityLoss * _FoamDeltaTime);

    float captureSupport = saturate(motion.capture * (0.10 + motion.leeStrength * 0.25));
    integrity += (1.0 - integrity) * captureSupport * _FoamDeltaTime;
    integrity = max(integrity, remainingLife * 0.34);

    float structuralWeakness = pow(saturate(1.0 - integrity), lerp(2.2, 1.18, fragmentation));
    float coherentTear =
        fracture.x * fracture.y * structuralWeakness *
        lerp(0.18, 2.25, fragmentation) *
        lerp(0.72, 1.28, agitation);
    float edgeBite =
        coherentTear * edgeExposure * lerp(0.42, 1.45, fracture.y);
    float tipPeel =
        coherentTear * tipness * lerp(0.30, 1.05, fragmentation);
    float neckCollapse =
        coherentTear * smoothstep(0.18, 0.72, neckness) *
        smoothstep(0.42, 0.90, structuralWeakness) *
        lerp(0.55, 3.6, fragmentation);
    float interiorCrack =
        coherentTear * smoothstep(0.30, 0.65, amount) *
        smoothstep(0.20, 0.62, directionalAverage) *
        (1.0 - edgeExposure) * 0.42;

    float tinyFragment =
        smoothstep(0.010, 0.13, amount) *
        (1.0 - smoothstep(0.10, 0.30, directionalAverage));
    float fragmentGrace = lerp(1.0, 0.42, tinyFragment);
    amount *= exp(-(
        edgeBite + tipPeel + neckCollapse + interiorCrack) *
        fragmentGrace * _FoamDeltaTime);

    // Merging only mixes already overlapping material. No amount is inserted
    // across a gap, so a connection requires real donor flux.
    float phaseAgreement = 1.0 - smoothstep(0.16, 0.58, PhaseDistance(phase, neighbourPhase));
    float physicalOverlap =
        smoothstep(0.08, 0.34, amount) *
        smoothstep(0.08, 0.30, directionalAverage);
    float phaseMix =
        saturate(_FoamCohesion + _FoamConnectivity * 0.25) *
        phaseAgreement * physicalOverlap * _FoamDeltaTime;
    phase = MixPhaseShortest(phase, neighbourPhase, phaseMix);

    float wakeReinforcement = smoothstep(0.15, 0.72, motion.wakeEnergy) * max(0.0, _FoamWakeReinforcement);
    float leeReinforcement = smoothstep(0.06, 0.70, motion.leeStrength) * max(0.0, _FoamWakeReinforcement);
    float pressureReinforcement = smoothstep(0.08, 0.72, motion.pressureStrength) * max(0.0, _FoamWakeReinforcement);
    float impactReinforcement = smoothstep(0.26, 0.86, motion.rippleIntensity) * max(0.0, _FoamImpactReinforcement);
    float existingSupport = smoothstep(0.020, 0.20, max(amount, broadAmount));
    float reinforcement =
        (wakeReinforcement * 0.030 + leeReinforcement * 0.095 +
         pressureReinforcement * 0.034 + impactReinforcement * 0.060) *
        existingSupport * coverage;
    if (reinforcement > 0.0)
    {
        float previousAmount = amount;
        amount = saturate(amount + reinforcement * (1.0 - amount) * _FoamDeltaTime);
        float added = max(0.0, amount - previousAmount);
        if (amount > 0.0001)
        {
            remainingLife = saturate(
                (remainingLife * previousAmount +
                 saturate(0.54 + impactReinforcement * 0.28) * added) /
                amount);
            integrity = saturate(
                (integrity * previousAmount +
                 saturate(0.52 + leeReinforcement * 0.32) * added) /
                amount);
        }
    }

    float captureRetention = saturate(
        motion.capture + boundary.y * max(0.0, _FoamShoreRetention));
    float endOfLife = 1.0 - smoothstep(
        0.0,
        max(0.001, _FoamEndOfLifeDissipationStart),
        remainingLife);
    float amountDecay = max(
        0.0,
        _FoamEndOfLifeDissipationRate) *
        endOfLife * endOfLife;
    amountDecay *= lerp(1.0, 0.075, pow(captureRetention, 1.30));
    amountDecay *= lerp(1.0, 0.46, tinyFragment);
    amount *= exp(-amountDecay * _FoamDeltaTime);

    float capturePeel =
        captureRetention * age * edgeExposure * fragmentation *
        fracture.x * fracture.y * lerp(0.04, 0.34, agitation);
    amount *= exp(-capturePeel * _FoamDeltaTime);

    amount *= lerp(0.52, 1.0, coverage);
    // Boundary coverage scales transported material moments together with
    // Amount. Do not independently shorten normalized Remaining Life near the
    // shore; Shore Support already owns the material-facing aging response.
    integrity *= lerp(0.72, 1.0, coverage);

    amount = saturate(amount);
    remainingLife = saturate(remainingLife);
    integrity = saturate(integrity);
    if (amount < 0.001)
    {
        _FoamStateWrite[coordinate] = 0.0.xxxx;
        return;
    }

    float materialPresence = smoothstep(0.001, 0.035, amount);
    remainingLife *= materialPresence;
    integrity *= materialPresence;
    _FoamStateWrite[coordinate] = saturate(float4(
        amount,
        amount * remainingLife,
        amount * integrity,
        phase));
}
